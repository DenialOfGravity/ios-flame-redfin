#!/bin/sh
# Root shell in iOS on the Pixel 4a (dropbear on 192.168.7.2:22 over USB Ethernet).
#   tools/sunfish-ssh ['command']
cd "$(dirname "$0")/.." || exit 1
o="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=20"
k=work/userland/ssh/id_ed25519
[ $# -eq 0 ] && exec ssh -t $o -i $k root@192.168.7.2
exec ssh $o -i $k root@192.168.7.2 "export PATH=/var/local/bin:/usr/bin:/bin:/usr/sbin:/sbin; $*"
