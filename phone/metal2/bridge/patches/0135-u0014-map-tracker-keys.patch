 //! follows the hash, which none of these maps' users depends on.
 
 use std::collections::HashMap;
-use std::hash::{BuildHasherDefault, Hasher};
+use std::collections::hash_map::{DefaultHasher, RandomState};
+use std::hash::{BuildHasher, BuildHasherDefault, Hasher};
 
 /// A map keyed by the runtime's own identities ([`KeyHasher`]).
 pub(crate) type KeyMap<K, V> = HashMap<K, V, BuildHasherDefault<KeyHasher>>;
@@ -63,3 +64,99 @@ impl Hasher for KeyHasher {
         self.mix(value as u64);
     }
 }
+
+/// ios-on-pixel (bridge 0135, UniXNU 0014): a map of an encoder's tracked uses (`tracker.rs`
+/// `EncoderUses`, `Part`, `UnorderedWrites`, `merged`), hashed by [`KeyHasher`] where env
+/// `SWEET_U0014` is on, else by the standard maps' SipHash as before.
+pub(crate) type TrackMap<K, V> = HashMap<K, V, TrackBuild>;
+
+/// [`TrackMap`]'s hasher choice, read once per process.
+#[derive(Clone, Debug)]
+pub(crate) enum TrackBuild {
+    Key,
+    Sip(RandomState),
+}
+
+fn sweet_u0014() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("SWEET_U0014").is_ok_and(|v| !v.trim().is_empty() && v.trim() != "0")
+    })
+}
+
+impl Default for TrackBuild {
+    fn default() -> TrackBuild {
+        match sweet_u0014() {
+            true => TrackBuild::Key,
+            false => TrackBuild::Sip(RandomState::new()),
+        }
+    }
+}
+
+/// [`TrackBuild`]'s hasher.
+pub(crate) enum TrackHasher {
+    Key(KeyHasher),
+    Sip(DefaultHasher),
+}
+
+impl BuildHasher for TrackBuild {
+    type Hasher = TrackHasher;
+
+    fn build_hasher(&self) -> TrackHasher {
+        match self {
+            TrackBuild::Key => TrackHasher::Key(KeyHasher::default()),
+            TrackBuild::Sip(state) => TrackHasher::Sip(state.build_hasher()),
+        }
+    }
+}
+
+impl Hasher for TrackHasher {
+    fn finish(&self) -> u64 {
+        match self {
+            TrackHasher::Key(h) => h.finish(),
+            TrackHasher::Sip(h) => h.finish(),
+        }
+    }
+
+    fn write(&mut self, bytes: &[u8]) {
+        match self {
+            TrackHasher::Key(h) => h.write(bytes),
+            TrackHasher::Sip(h) => h.write(bytes),
+        }
+    }
+
+    fn write_u8(&mut self, value: u8) {
+        match self {
+            TrackHasher::Key(h) => h.write_u8(value),
+            TrackHasher::Sip(h) => h.write_u8(value),
+        }
+    }
+
+    fn write_u16(&mut self, value: u16) {
+        match self {
+            TrackHasher::Key(h) => h.write_u16(value),
+            TrackHasher::Sip(h) => h.write_u16(value),
+        }
+    }
+
+    fn write_u32(&mut self, value: u32) {
+        match self {
+            TrackHasher::Key(h) => h.write_u32(value),
+            TrackHasher::Sip(h) => h.write_u32(value),
+        }
+    }
+
+    fn write_u64(&mut self, value: u64) {
+        match self {
+            TrackHasher::Key(h) => h.write_u64(value),
+            TrackHasher::Sip(h) => h.write_u64(value),
+        }
+    }
+
+    fn write_usize(&mut self, value: usize) {
+        match self {
+            TrackHasher::Key(h) => h.write_usize(value),
+            TrackHasher::Sip(h) => h.write_usize(value),
+        }
+    }
+}
