+
+/// ios-on-pixel (bridge 0137, UniXNU 0016): whether a padded texture that renders or writes aliases
+/// its rows only where its tile stores stay within them (env `SWEET_U0016`, off unless set and not
+/// `0`).
+fn sweet_u0016() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("SWEET_U0016").is_ok_and(|v| !v.trim().is_empty() && v.trim() != "0")
+    })
+}
