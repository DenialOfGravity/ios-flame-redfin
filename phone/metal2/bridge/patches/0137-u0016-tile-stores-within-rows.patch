-        let policy = self.compile_device().policy().padded_reads;
+        let mut policy = self.compile_device().policy().padded_reads;
+        // ios-on-pixel (bridge 0137, UniXNU 0016; env `SWEET_U0016`): a written texture's tile
+        // stores may reach past its rows (`linear_plan::tile_store_fits`): whole 16x4-texel blocks
+        // at its right and bottom edges. Where they would leave the row gaps or the buffer, a texture
+        // that renders or writes is a shadow (bridge 0101 aliases it under `Alias` otherwise); one
+        // that only reads aliases as before.
+        if sweet_u0016()
+            && policy == PaddedReadsPolicy::Alias
+            && !only_reads(usage)
+            && !tile_store_fits(&texels.layout, u64::from(layout.extent[0]), texels.buffer.length())
+        {
+            policy = PaddedReadsPolicy::Shadow;
+        }
         let holds = holding(&texels.layout, usage, policy);
         // Over bytes detached from their pages (`detach.rs`) no image aliases them: the texture
         // is their shadow, which presents a stand-in until they lie in pages again.
@@ -5846,3 +5858,13 @@ struct HostCopy {
