+/// sweet 0162: `SWEET_M2V_COLOR_WRITES=plain`: what `fetch` does (a fetching function leaves every
+/// float colour output to the device), and in every other function an 8-bit unorm channel
+/// (`ChannelWrite::Unorm { bits: 8 }`, unblended or blended by one and zero) is stored as written:
+/// the render backend's float-to-unorm8 conversion, which differs from Metal's exact rounding only
+/// within a code of a tie (`pipeline::color_writes::sweet_plain_rule`). sRGB, 10/16-bit unorm,
+/// snorm and the small floats keep Metal's rounding. Link keeps such an attachment's state as
+/// `fetch` gives it: a blend of one and zero takes no Vulkan blend (`link::graphics`).
+pub fn sweet_color_writes_plain() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("SWEET_M2V_COLOR_WRITES").is_ok_and(|v| v == "plain"))
+}
+
+/// sweet 0110/0162: whether a fetching fragment function leaves its float colour outputs to the
+/// device: `SWEET_M2V_COLOR_WRITES` is `fetch` or `plain`.
+pub fn sweet_color_writes_fetching_device() -> bool {
+    sweet_color_writes_fetch() || sweet_color_writes_plain()
+}
