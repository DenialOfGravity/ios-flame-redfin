+/// sweet 0162: the rule a channel of rule `r` takes under SWEET_M2V_COLOR_WRITES=plain: an 8-bit
+/// unorm channel's rounding is left to the device's conversion. The render backend converts the
+/// stored float itself (Vulkan: `c = convertFloatToUint(f * 255)`, one of the two nearest codes,
+/// nearest recommended); Metal's code is the exact product rounded to nearest, so the two differ
+/// only where `f * 255` lies within an `f32` rounding of a half-integer, by one code. Every other
+/// rule is kept: sRGB (the device's encode is its own approximation, off well away from ties, and
+/// the function reads a table), the 10/16-bit unorm and snorm channels (rare, deep-colour or
+/// signed targets, left exact), and the small floats (Metal rounds toward zero, the device to
+/// nearest: a difference at every value, not only near ties).
+pub(crate) fn sweet_plain_rule(r: ChannelWrite) -> ChannelWrite {
+    match r {
+        ChannelWrite::Unorm { bits: 8 } => ChannelWrite::Device,
+        _ => r,
+    }
+}
+
+/// sweet 0162: whether pixel format `pf` has a channel [`sweet_plain_rule`] leaves to the device
+/// (an 8-bit unorm one): link then keeps a blend of one and zero off the Vulkan state.
+pub(crate) fn sweet_plain_format(pf: metal::PixelFormat) -> bool {
+    matches!(write_conversion(pf), Some(WriteConversion::Rules(rules))
+        if rules.contains(&Some(ChannelWrite::Unorm { bits: 8 })))
+}
