+/// ios-on-pixel (bridge 0111): whether a memoryless color attachment that no draw of its pass
+/// writes or reads is left out of the pass's subpass (`VK_ATTACHMENT_UNUSED`, its description
+/// kept, so its framebuffer and every pipeline's compatible pass are as before) in the passes
+/// `end_encoding` begins (env `SWEET_M2V_SCRATCH`, off unless set and not `0`). A tiler then keeps
+/// it out of tile memory (Turnip: half the bytes per pixel of CoreAnimation's two-color passes,
+/// twice the pixels per bin) and neither clears nor loads it. Metal keeps nothing of a memoryless
+/// texture past its pass, so a color no draw touches holds nothing anyone reads. The frontend's
+/// live knobs (`/var/local/mtl2-live`) override the env through `set_scratch_live`: the choice is
+/// made per pass (a trimmed pass and its framebuffer are other kept objects than the full ones,
+/// `render_target` keys them by their attachments and subpass), so it may change between passes.
+#[inline]
+pub fn scratch_trim() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    match SCRATCH_LIVE.load(Ordering::Relaxed) {
+        live if live >= 0 => live != 0,
+        _ => *ON.get_or_init(|| flag("SWEET_M2V_SCRATCH", false)),
+    }
+}
+
+static SCRATCH_LIVE: std::sync::atomic::AtomicI8 = std::sync::atomic::AtomicI8::new(-1);
+
+/// ios-on-pixel (bridge 0111): `scratch_trim`'s live value from the next pass on: 0 off, 1 on,
+/// negative = the env's again.
+pub fn set_scratch_live(value: i8) {
+    SCRATCH_LIVE.store(value.max(-1), Ordering::Relaxed);
+}
