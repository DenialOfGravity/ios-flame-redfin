+/// sweet 0160: how `half` arithmetic is compiled (`SWEET_FP16`, `REGISTRY`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SweetFp16 {
+    /// Unset (or any other value): upstream's rounding of each `half` result.
+    Off,
+    /// `wide`: `half` held in `f32`, never rounded back (`narrow::round` is the identity).
+    Wide,
+    /// `native`: the device's 16-bit `+ - *` and `fma` (`derive::Device::new` takes the three
+    /// `half` deviations), and no barrier before a conversion to 16 bits.
+    Native,
+}
+
+/// sweet 0160: `SWEET_FP16` (`wide` or `native`), read once per process. It changes what the
+/// library compiles, so every cache key includes it ([`sweet_key_tag`]).
+pub fn sweet_fp16() -> SweetFp16 {
+    static MODE: std::sync::OnceLock<SweetFp16> = std::sync::OnceLock::new();
+    *MODE.get_or_init(|| match std::env::var("SWEET_FP16").as_deref() {
+        Ok("wide") => SweetFp16::Wide,
+        Ok("native") => SweetFp16::Native,
+        _ => SweetFp16::Off,
+    })
+}
+
 /// sweet: the bytes the sweet knobs that change compiled modules add to every cache key (the
 /// compile layer's keys, the runtime's shader cache build); empty with every knob off, so the
 /// keys are then upstream's.
@@ -116,6 +148,11 @@ pub fn sweet_key_tag() -> &'static [u8] {
         if sweet_color_writes_fetch() {
             t.extend_from_slice(b"sweet-color-writes-fetch\0");
         }
+        match sweet_fp16() {
+            SweetFp16::Off => {}
+            SweetFp16::Wide => t.extend_from_slice(b"sweet-fp16-wide\0"),
+            SweetFp16::Native => t.extend_from_slice(b"sweet-fp16-native\0"),
+        }
         t
     })
 }
