     /// is on (`InvalidDescriptor`).
     pub fn new(desc: DeviceDescription, policy: DevicePolicy) -> Result<Device, Error> {
         // The driver's measured deviations at its release, never its name.
-        let deviations = super::driver_facts::deviations(&desc);
+        let mut deviations = super::driver_facts::deviations(&desc);
+        // sweet 0160: SWEET_FP16=native takes the device's 16-bit `half` arithmetic, conversion
+        // and fused multiply-add as Metal's (unmeasured on this driver: a relaxed-precision
+        // choice), so `half` `+ - *` and `fma` emit 16-bit instructions. The deviations enter the
+        // profile, its properties and so its fingerprint; off, the table's alone.
+        if crate::env_vars::sweet_fp16() == crate::env_vars::SweetFp16::Native {
+            for d in [
+                DriverDeviation::MetalHalfArithmetic,
+                DriverDeviation::MetalHalfConversion,
+                DriverDeviation::MetalHalfFma,
+            ] {
+                deviations.entry(d).or_insert(Standing::Measured);
+            }
+        }
         Device::with_deviations(desc, policy, deviations)
     }
 
