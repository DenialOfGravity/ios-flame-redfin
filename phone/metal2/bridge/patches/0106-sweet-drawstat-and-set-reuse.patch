+++ b/crates/metal2vulkan-runtime/src/binding.rs
@@ -767,6 +767,33 @@ const WRITES_AT_ONCE: usize = 16;
 ///
 /// No pending or recording command uses `sets`, and every buffer, view and sampler written stays
 /// live while a command that binds the sets can run.
+/// ios-on-pixel: what a set 0 written with `writes` through `layout` holds, flattened, for
+/// `DescriptorArena::sweet_memo`: two sets of one layout written with equal keys hold the same
+/// descriptors. `None` where a write keeps something alive (`Write::held`), never reused.
+pub(super) fn sweet_set_key(layout: vk::PipelineLayout, writes: &[Write]) -> Option<Vec<u64>> {
+    use ash::vk::Handle;
+    let mut key = Vec::with_capacity(1 + writes.len() * 7);
+    key.push(layout.as_raw());
+    for write in writes {
+        if write.held.is_some() {
+            return None;
+        }
+        key.push(u64::from(write.set) | (u64::from(write.binding) << 32));
+        key.push(u64::from(write.element) | ((write.ty.as_raw() as u32 as u64) << 32));
+        match write.info {
+            Info::Buffer(info) => key.extend([1, info.buffer.as_raw(), info.offset, info.range]),
+            Info::Image(info) => key.extend([
+                2,
+                info.sampler.as_raw(),
+                info.image_view.as_raw(),
+                info.image_layout.as_raw() as u32 as u64,
+            ]),
+            Info::Texel(view) => key.extend([3, view.as_raw(), 0, 0]),
+        }
+    }
+    Some(key)
+}
