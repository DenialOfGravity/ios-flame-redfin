+/// sweet 0109: whether float color outputs keep the device's conversion (`REGISTRY`):
+/// `SWEET_M2V_COLOR_WRITES` is `device` or `1`. Read once per process. It changes what the
+/// library compiles, so every cache key includes it ([`sweet_key_tag`]).
+pub fn sweet_color_writes_device() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("SWEET_M2V_COLOR_WRITES").is_ok_and(|v| v == "device" || v == "1")
+    })
+}
+
+/// sweet: the bytes the sweet knobs that change compiled modules add to every cache key (the
+/// compile layer's keys, the runtime's shader cache build); empty with every knob off, so the
+/// keys are then upstream's.
+pub fn sweet_key_tag() -> &'static [u8] {
+    static TAG: std::sync::OnceLock<Vec<u8>> = std::sync::OnceLock::new();
+    TAG.get_or_init(|| {
+        let mut t = Vec::new();
+        if sweet_color_writes_device() {
+            t.extend_from_slice(b"sweet-color-writes-device\0");
+        }
+        t
+    })
+}
+
 /// Optional path override for an external tool `cmd` (`llvm-as`, `spirv-val`, …), read from
 /// `METAL2VULKAN_<CMD>` (uppercased, `-`→`_`). A dynamic family — one var per tool the binary or
 /// the crate's test support runs — documented in `REGISTRY` as a single `METAL2VULKAN_<TOOL>`
diff --git a/crates/metal2vulkan/src/pipeline/color_writes.rs b/crates/metal2vulkan/src/pipeline/color_writes.rs
index 86f6acba..6ad79869 100644
--- a/crates/metal2vulkan/src/pipeline/color_writes.rs
+++ b/crates/metal2vulkan/src/pipeline/color_writes.rs
@@ -113,6 +113,13 @@ pub(crate) fn exact_writes(
             }
             _ => write,
         };
+        // sweet 0109: under SWEET_M2V_COLOR_WRITES=device every channel the function would round
+        // to Metal's code itself is left to the device's conversion instead (it differs only at
+        // the exact ties between two codes), so the module carries no rounding and no rule word.
+        let write = match crate::env_vars::sweet_color_writes_device() {
+            true => write.map(|w| w.map(|r| r.map(sweet_device_rule))),
+            false => write,
+        };
         if let Some(write) = write {
             out.insert(attachment, write);
         }
@@ -120,6 +127,16 @@ pub(crate) fn exact_writes(
     out
 }
 
+/// sweet 0109: the rule a channel of rule `r` takes under SWEET_M2V_COLOR_WRITES=device: the
+/// device's conversion for every rounding the function would compute (unorm, snorm, sRGB, the
+/// small floats' and the packed formats'); a blended channel's rule is kept.
+fn sweet_device_rule(r: ChannelWrite) -> ChannelWrite {
+    match r {
+        ChannelWrite::BlendedNearestEven { .. } | ChannelWrite::Device => r,
+        _ => ChannelWrite::Device,
+    }
+}
+
 /// A rule word's code of a channel that takes no rule: the output as written.
 pub(crate) const NO_RULE_CODE: u32 = 0;
 
