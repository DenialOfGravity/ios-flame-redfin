+/// ios-on-pixel u-cpu: the runtime's bits of env `SWEET_CPUFAST` (one bitmask with the SweetMetal2
+/// frontend's 0x1 and 0x2; unset or empty = [`CPU_FAST_DEFAULT`]).
+#[inline]
+pub fn cpu_fast() -> u32 {
+    static BITS: OnceLock<u32> = OnceLock::new();
+    *BITS.get_or_init(|| {
+        std::env::var("SWEET_CPUFAST")
+            .ok()
+            .map(|v| v.trim().to_string())
+            .filter(|v| !v.is_empty())
+            .and_then(|v| match v.strip_prefix("0x").or_else(|| v.strip_prefix("0X")) {
+                Some(hex) => u32::from_str_radix(hex, 16).ok(),
+                None => v.parse().ok(),
+            })
+            .unwrap_or(CPU_FAST_DEFAULT)
+    })
+}
+
+/// `SWEET_CPUFAST` bit 0x4: an encoder keeps [`FAST_KEPT_MORE`] fast-draw entries, not
+/// [`FAST_KEPT`] (`render/sweet_fast.rs`). Exact either way: an entry is taken only where its
+/// whole key matches; more entries only let fewer draws settle again.
+pub const CPU_FAST_KEPT: u32 = 0x4;
+/// The bits on where `SWEET_CPUFAST` is unset (the frontend's 0x1 and 0x2 among them).
+pub const CPU_FAST_DEFAULT: u32 = 0x1 | 0x2 | CPU_FAST_KEPT;
+/// The fast-draw entries an encoder keeps by default.
+pub(crate) const FAST_KEPT: usize = 6;
+/// The fast-draw entries an encoder keeps with [`CPU_FAST_KEPT`].
+pub(crate) const FAST_KEPT_MORE: usize = 16;
+
+/// The fast-draw entries an encoder keeps now.
+#[inline]
+pub(crate) fn fast_kept() -> usize {
+    match cpu_fast() & CPU_FAST_KEPT {
+        0 => FAST_KEPT,
+        _ => FAST_KEPT_MORE,
+    }
+}
