+/// sweet 0161: `SWEET_M2V_CONTRACT=1`: contraction wherever the AIR operation carries
+/// `contract` (`lower::arith::contraction`). Read once per process; part of every cache key.
+pub fn sweet_contract() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("SWEET_M2V_CONTRACT").is_ok_and(|v| v == "1"))
+}
