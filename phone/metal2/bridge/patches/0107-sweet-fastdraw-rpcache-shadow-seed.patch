+//! ios-on-pixel: the steps a render encoder's draw settled, kept for its next draws (env
+//! `SWEET_FASTDRAW`, on unless `0`: `sweet_drawstat::fast_draw`).
+//!
+//! A draw's settings (`draw_settings`) and Vulkan draw state (`DrawState`) are functions of the
+//! encoder's state, the pass instance and layout it records into, its pipeline state and its
+//! assembly. Its notices, `VkPipeline` and coverage are, beside those, functions of its variant
+//! and plan, the formats of the textures it binds, its vertex strides and its instance's
+//! compatible pass. The encoder counts the calls that may change its state
+//! (`RenderCommandEncoder::sweet_gen`: every logged call but the bindings of buffers, bytes,
+//! textures and samplers, of the pipeline state, and the draws) and those that bind textures and
+//! samplers (`sweet_tex_gen`), and forgets every kept entry where a draw installs another
+//! instance or layout. A draw whose pipeline state (the same object) and assembly are an entry's
+//! at the entry's `sweet_gen` takes the entry's settings and draw state, and records no notice
+//! of them again (each announced as the entry's draw ran); one whose variant, plan, strides and
+//! compatible pass are the entry's too, at its `sweet_tex_gen`, takes its `VkPipeline` and
+//! records the entry's notices no more; and the pass's coverage, which the entry's draw added
+//! already, is not added again (a union of the same rectangles).
+//!
+//! Kept only for draws outside an execution's replay, a reroute and a capture, of a pass without
+//! a rate map, custom sample positions or extended-range colors.
+
+use super::{
+    Assembly, BindingPlan, DrawSettings, DrawState, DrawingState, RawPipeline,
+    RenderCommandEncoder, RenderPassObject, RenderVariant,
+};
+use std::sync::Arc;
+
+/// The most entries an encoder keeps: a window server's pass draws a few states in turn.
+const KEPT: usize = 6;
+
+/// What one draw settled (the module docs).
+pub(super) struct SweetFast {
+    gen: u64,
+    pipeline: DrawingState,
+    assembly: Assembly,
+    pub(super) settings: DrawSettings,
+    pub(super) draw_state: Option<DrawState>,
+    pub(super) bound: Option<SweetBound>,
+    /// The entry's draw added its coverage (`RenderCommandEncoder::draw`).
+    pub(super) covered: bool,
+}
+
+/// The `VkPipeline` an entry's draw took, and what it was found by beside the entry's key.
+pub(super) struct SweetBound {
+    pub(super) tex_gen: u64,
+    pub(super) variant: Arc<RenderVariant>,
+    pub(super) plan: Arc<BindingPlan>,
+    pub(super) strides: Vec<(u32, u32)>,
+    pub(super) compatible: Arc<RenderPassObject>,
+    pub(super) made: Arc<RawPipeline>,
+}
+
+impl SweetBound {
+    /// Whether a draw of these finds the entry's `VkPipeline`.
+    pub(super) fn takes(
+        &self,
+        tex_gen: u64,
+        (variant, plan): (&Arc<RenderVariant>, &Arc<BindingPlan>),
+        strides: &[(u32, u32)],
+        compatible: &Arc<RenderPassObject>,
+    ) -> bool {
+        self.tex_gen == tex_gen
+            && Arc::ptr_eq(&self.variant, variant)
+            && Arc::ptr_eq(&self.plan, plan)
+            && Arc::ptr_eq(&self.compatible, compatible)
+            && self.strides.as_slice() == strides
+    }
+}
+
+impl RenderCommandEncoder {
+    /// Whether the encoder keeps entries for its draws now (the module docs).
+    pub(super) fn sweet_eligible(&self) -> bool {
+        crate::sweet_drawstat::fast_draw()
+            && !self.replaying
+            && !self.rerouting
+            && self.rate_map.is_none()
+            && self.layout.sample_positions.is_empty()
+            && self.capture_addresses().is_none()
+            && self.extended_colors().is_empty()
+    }
+
+    /// The entry a draw of `pipeline` and `assembly` takes now, its place.
+    pub(super) fn sweet_find(&self, pipeline: &DrawingState, assembly: Assembly) -> Option<usize> {
+        self.sweet_fast.iter().rposition(|kept| {
+            kept.gen == self.sweet_gen && kept.assembly == assembly && kept.pipeline.same(pipeline)
+        })
+    }
+
+    /// Keep what a draw of `pipeline` and `assembly` settled, its own entry's place.
+    pub(super) fn sweet_keep(
+        &mut self,
+        pipeline: DrawingState,
+        assembly: Assembly,
+        (settings, draw_state): (DrawSettings, Option<DrawState>),
+        bound: Option<SweetBound>,
+    ) {
+        let gen = self.sweet_gen;
+        self.sweet_fast
+            .retain(|kept| kept.gen == gen && !(kept.assembly == assembly && kept.pipeline.same(&pipeline)));
+        if self.sweet_fast.len() >= KEPT {
+            self.sweet_fast.remove(0);
+        }
+        self.sweet_fast.push(SweetFast {
+            gen,
+            pipeline,
+            assembly,
+            settings,
+            draw_state,
+            bound,
+            covered: false,
+        });
+    }
+
+    /// Forget every entry: another instance or layout.
+    pub(super) fn sweet_forget(&mut self) {
+        self.sweet_fast.clear();
+    }
+}
