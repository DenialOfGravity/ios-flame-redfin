diff --git a/crates/metal2vulkan-runtime/src/sweet_seed.rs b/crates/metal2vulkan-runtime/src/sweet_seed.rs
new file mode 100644
index 0000000..e069373
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/sweet_seed.rs
@@ -0,0 +1,107 @@
+//! ios-on-pixel: a surface texture's shadow that skips its copy in while its image holds the
+//! surface's bytes (env `SWEET_SHADOW_SEED`, `sweet_drawstat::shadow_seed`).
+//!
+//! An encoder copies a shadowed texture's bytes into its image before its first use of it
+//! (`shadow.rs`), as between encoders the image holds nothing the bytes lack. For a texture over
+//! an IOSurface, the frontend gives the surface's seed (+ 1) at each bind ([`want`]); the seed moves
+//! on with every CPU write of the surface (and the frontend of a process whose GPU wrote the
+//! surface moves it on as those writes complete). A copy in made at a seed ([`copied_in`]) leaves
+//! the image holding that seed's bytes, so a later encoder skips its copy in while the seed is the
+//! same ([`unchanged`]) — unless the GPU wrote the bytes since in this process: any command that
+//! wrote the texture's buffer or the host memory it joined ([`written`]) ends the skipping for
+//! that buffer for good (a copy back is such a write too). Generation 0 forgets the held seed: the
+//! bytes changed some way no seed tells (a `replaceRegion`).
+
+use crate::resource::ResourceKey;
+use crate::tracker::Use;
+use std::collections::{HashMap, HashSet};
+use std::sync::{Mutex, MutexGuard};
+
+/// A shadow's seeds: the one its texture was last bound at, and the one its image holds.
+#[derive(Clone, Copy, Default)]
+struct Seeds {
+    wanted: u64,
+    held: u64,
+}
+
+/// The most shadows and written keys kept: past either, both are forgotten (every image copied in
+/// again), which is always safe.
+const MOST: usize = 16384;
+
+static SEEDS: Mutex<Option<HashMap<ResourceKey, Seeds>>> = Mutex::new(None);
+static WRITTEN: Mutex<Option<HashSet<ResourceKey>>> = Mutex::new(None);
+
+fn locked<T>(m: &'static Mutex<Option<T>>) -> MutexGuard<'static, Option<T>> {
+    m.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+/// The texture of shadow `shadow` is bound with its surface at `generation` (seed + 1; 0 = the
+/// bytes changed some other way).
+pub(crate) fn want(shadow: ResourceKey, generation: u64) {
+    let mut seeds = locked(&SEEDS);
+    let seeds = seeds.get_or_insert_with(HashMap::new);
+    if seeds.len() >= MOST && !seeds.contains_key(&shadow) {
+        seeds.clear();
+    }
+    let entry = seeds.entry(shadow).or_default();
+    entry.wanted = generation;
+    if generation == 0 {
+        entry.held = 0;
+    }
+}
+
+/// Whether shadow `shadow`'s image holds the bytes of the generation its texture was last bound
+/// at, its truth (`keys`: the buffer, and the host memory it joined) unwritten by the GPU.
+pub(crate) fn unchanged(shadow: ResourceKey, keys: [Option<ResourceKey>; 2]) -> bool {
+    let held = {
+        let seeds = locked(&SEEDS);
+        match seeds.as_ref().and_then(|seeds| seeds.get(&shadow)) {
+            Some(s) => s.wanted != 0 && s.held == s.wanted,
+            None => false,
+        }
+    };
+    if !held {
+        return false;
+    }
+    let written = locked(&WRITTEN);
+    let Some(written) = written.as_ref() else {
+        return true;
+    };
+    !keys.iter().flatten().any(|key| written.contains(key))
+}
+
+/// A copy in of shadow `shadow` recorded: its image holds the generation its texture was bound at.
+pub(crate) fn copied_in(shadow: ResourceKey) {
+    let mut seeds = locked(&SEEDS);
+    if let Some(entry) = seeds.as_mut().and_then(|seeds| seeds.get_mut(&shadow)) {
+        entry.held = entry.wanted;
+    }
+}
+
+/// Shadow `shadow`'s image is to hold something else than its bytes (a command overwrites it).
+pub(crate) fn forget(shadow: ResourceKey) {
+    let mut seeds = locked(&SEEDS);
+    if let Some(entry) = seeds.as_mut().and_then(|seeds| seeds.get_mut(&shadow)) {
+        entry.held = 0;
+    }
+}
+
+/// A command with `uses` recorded: the keys it writes.
+pub(crate) fn written(uses: &[Use<ResourceKey>]) {
+    let mut writes = uses.iter().filter(|used| !used.write.is_empty()).peekable();
+    if writes.peek().is_none() {
+        return;
+    }
+    let mut keys = locked(&WRITTEN);
+    let keys = keys.get_or_insert_with(HashSet::new);
+    for used in writes {
+        keys.insert(used.key);
+    }
+    if keys.len() >= MOST {
+        // Forget every held seed first: a write forgotten can then skip nothing.
+        if let Some(seeds) = locked(&SEEDS).as_mut() {
+            seeds.clear();
+        }
+        keys.clear();
+    }
+}
