+        let image = match sweet_u0015() {
+            true => {
+                let identity = Identity::new(hazard, false);
+                self.new_image_as_it_lies(plan, layout, descriptor, identity, Device::runtime_owner)?
+            }
+            false => self.new_image(plan, layout, descriptor, hazard)?,
+        };
