+
+/// ios-on-pixel (bridge 0136, UniXNU 0015): whether a two-plane texture's shadow starts as its
+/// memory lies (env `SWEET_U0015`, off unless set and not `0`).
+fn sweet_u0015() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("SWEET_U0015").is_ok_and(|v| !v.trim().is_empty() && v.trim() != "0")
+    })
+}
