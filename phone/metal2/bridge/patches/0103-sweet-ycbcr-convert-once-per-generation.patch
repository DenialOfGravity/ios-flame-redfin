@@ -417,9 +417,31 @@ pub(super) struct YCbCrConversion {
     kernel: OwnedKernel,
     sets: OwnedSets,
     groups: [u32; 2],
+    /// ios-on-pixel: the generation of the planes the caller names (`Texture::set_converted_generation`,
+    /// the surface's seed; 0 = none named) and the one the image was last converted from. A copy in
+    /// whose generation the image already holds is not made: the planes did not change.
+    generation: [std::sync::atomic::AtomicU64; 2],
 }
 
 impl YCbCrConversion {
+    /// ios-on-pixel: name the planes' generation (0: none, every copy in converts).
+    pub(super) fn set_generation(&self, generation: u64) {
+        self.generation[0].store(generation, std::sync::atomic::Ordering::Release);
+    }
+
+    /// ios-on-pixel: whether a copy in is needed: false when a generation is named and the image
+    /// already holds it; otherwise true, and the image counts as holding the named one from now
+    /// (the conversion recorded next runs before any later command buffer's on the queue).
+    pub(super) fn needs_copy_in(&self) -> bool {
+        use std::sync::atomic::Ordering;
+        let wanted = self.generation[0].load(Ordering::Acquire);
+        if wanted != 0 && self.generation[1].load(Ordering::Acquire) == wanted {
+            return false;
+        }
+        self.generation[1].store(wanted, Ordering::Release);
+        true
+    }
+
     /// The conversion of `planes`, whose bytes lie in `bytes` of their buffer, at `at` of its
