     /// `newTextureViewWithPixelFormat:`: a view of the whole texture as `pixel_format`.
+    /// ios-on-pixel: for a two-plane YCbCr texture over a surface, the generation of its planes
+    /// (the surface's seed + 1; 0 = unknown): its image is converted again only when it changes.
+    /// Answers whether the texture is such a texture.
+    pub fn set_converted_generation(&self, generation: u64) -> bool {
+        match self.shadow().map(|copies| &copies.source) {
+            Some(crate::shadow::ShadowSource::Converted { conversion, .. }) => {
+                conversion.set_generation(generation);
+                true
+            }
+            _ => false,
+        }
+    }
