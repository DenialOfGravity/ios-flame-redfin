+/* "12.3M" */
+static const char *
+sweet_pf_si(char *buf, size_t size, double v)
+{
+   const char *u = "";
+   if (v >= 1e9) { v /= 1e9; u = "G"; }
+   else if (v >= 1e6) { v /= 1e6; u = "M"; }
+   else if (v >= 1e3) { v /= 1e3; u = "k"; }
+   snprintf(buf, size, v >= 100 || !*u ? "%.0f%s" : "%.1f%s", v, u);
+   return buf;
+}
+
+/* one sum: " clk 9.8M 587MHz sp 92% full 12.3M ... [derived]" (counts per draw when per_draw, else totals) */
+static size_t
+sweet_pf_put_sum(char *out, size_t size, unsigned p, const struct sweet_pf_sum *s, double per, bool clock)
+{
+#define PF_PUT(...) at += snprintf(out + at, size > at ? size - at : 0, __VA_ARGS__)
+   size_t at = 0;
+   char b[32];
+   const struct sweet_pf_preset *ps = &sweet_pf_presets[p];
+   const double cyc = (double) s->v[0];
+   for (unsigned i = 0; i < SWEET_PF_N; i++) {
+      const struct sweet_pf_cnt *c = &ps->c[i];
+      if (!sweet_pf_regs[p][i].ok)
+         continue;
+      const double v = (double) s->v[i];
+      if (i == 0) {
+         PF_PUT(" %s %s", c->label, sweet_pf_si(b, sizeof(b), v / per));
+         if (clock && s->ticks)
+            PF_PUT(" %.0fMHz", v / (s->ticks / 19.2));
+      } else if (c->kind == PF_CYC) {
+         PF_PUT(" %s %.0f%%", c->label, cyc > 0 ? 100.0 * v / cyc : 0.0);
+      } else if (c->kind == PF_BEAT) {
+         PF_PUT(" %s %.2fMB", c->label, v * 32 / 1e6 / per);
+      } else {
+         PF_PUT(" %s %s", c->label, sweet_pf_si(b, sizeof(b), v / per));
+      }
+   }
+   /* the preset's ratios, by label */
+   double val[SWEET_PF_N] = {};
+   auto get = [&](const char *label) -> double {
+      for (unsigned i = 0; i < SWEET_PF_N; i++)
+         if (sweet_pf_regs[p][i].ok && !strcmp(ps->c[i].label, label))
+            return val[i];
+      return -1;
+   };
+   for (unsigned i = 0; i < SWEET_PF_N; i++)
+      val[i] = (double) s->v[i];
+   const double px = s->px ? (double) s->px : -1;
+   if (!strcmp(ps->name, "alu")) {
+      const double lanes = get("quads") * 4, sp = get("sp"), full = get("full"), half = get("half");
+      if (lanes > 0)
+         PF_PUT(" -> full/px %.1f half/px %.1f", full / lanes, half / lanes);
+      if (sp > 0)
+         PF_PUT(" alu/sp %.0f%% instr/spclk %.1f", 100.0 * get("alu") / sp, (full + half) / sp);
+   } else if (!strcmp(ps->name, "wave")) {
+      const double sp = get("sp"), w = get("wctx");
+      if (sp > 0 && w > 0)
+         PF_PUT(" -> waves %.1f nop %.0f%% idle %.0f%% ss %.0f%% sy %.0f%%", w / sp, 100 * get("wnop") / w,
+                100 * get("widle") / w, 100 * get("wss") / w, 100 * get("wsy") / w);
+   } else if (!strcmp(ps->name, "mem")) {
+      const double bytes = (get("rd") + get("wr")) * 32;
+      if (cyc > 0)
+         PF_PUT(" -> B/clk %.1f", bytes / cyc);
+      if (px > 0)
+         PF_PUT(" B/px %.1f", bytes / px);
+   } else if (!strcmp(ps->name, "rop")) {
+      if (cyc > 0)
+         PF_PUT(" -> px/clk %.2f", get("pass") / cyc);
+      if (get("rb") > 0)
+         PF_PUT(" px/rbclk %.2f", get("pass") / get("rb"));
+   } else if (!strcmp(ps->name, "tex")) {
+      if (get("l1req") > 0)
+         PF_PUT(" -> l1miss %.1f%%", 100 * get("l1miss") / get("l1req"));
+      if (px > 0)
+         PF_PUT(" texels/px %.2f", get("texels") / px);
+   } else if (!strcmp(ps->name, "ras")) {
+      if (get("lrzpx") > 0)
+         PF_PUT(" -> lrzkill %.0f%%", 100 * (1 - get("lrzvis") / get("lrzpx")));
+      if (get("t8x4") > 0)
+         PF_PUT(" full8x4 %.0f%% quads/px %.2f", 100 * get("full8x4") / get("t8x4"), px > 0 ? get("quads") / px : 0.0);
+   }
+#undef PF_PUT
+   return at;
+}
