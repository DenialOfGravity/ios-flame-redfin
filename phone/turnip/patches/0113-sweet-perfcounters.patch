 /* sweet 0110 (u-tr): SWEET_TU_CPUPROF counters (tu_cs.h) */
 extern "C" {
@@ -4470,6 +4471,554 @@ sweet_tu_draw_report(char *out, size_t size)
    return at < size ? at : size - 1;
 }
 
+/* sweet 0113 (u-perfctr): the Adreno's hardware performance counters per render pass and, with SWEET_TU_PERFCTR_DRAW=1,
+ * per draw. SWEET_TU_PERFCTR=<preset> (busy alu wave mem rop tex ras; 1 = busy) picks up to 8 countables from Mesa's
+ * a6xx tables (perfcntrs/, a6xx_perfcntrs.xml); SWEET_TU_PERFCTR_SWEEP=1 moves to the next preset at every report
+ * (every 5 s in backboardd). Only with SWEET_TIMELINE on, in the device the pass timeline uses; off (the default) it costs
+ * one branch per command buffer, pass and draw. Each countable gets the highest free counter of its group (Mesa and the
+ * kernel keep CP and SP counter 0: CP_ALWAYS_COUNT, programmed by sweet_a6xx at CP init); every preset's first countable
+ * is CP_ALWAYS_COUNT (GPU core clocks), the reference for the cycle counters' percentages.
+ * Per pass (the primary's cs, outside the tile loop): WFI, the select registers (pkt4), WFI, the counters (CP_REG_TO_MEM)
+ * before the pass's begin stamp; WFI, the counters, a done mark after its end stamp. Per draw (draw_cs, not in the
+ * binning pass): WFI + counters before the draw packet, WFI + counters after it and acc += after - before
+ * (CP_MEM_TO_MEM), so GMEM bins add up; each draw then runs alone (measurement mode). The CPU never reads a counter:
+ * sweet_tu_perf_report() sums the samples the GPU finished since its last call by pass kind and fragment shader
+ * (the ids of T tu-draw). */
+#define SWEET_PF_N 8u
+#define SWEET_PF_DS 8192u       /* per-draw slots: acc[8], before[8], after[8], done */
+#define SWEET_PF_DQ 25u
+#define SWEET_PF_PQ 17u         /* per-pass slots (as the pass timeline's): before[8], after[8], done */
+enum sweet_pf_unit { PF_CYC, PF_CNT, PF_BEAT };
+struct sweet_pf_cnt {
+   const char *group, *countable, *label;
+   enum sweet_pf_unit kind;
+};
+struct sweet_pf_preset {
+   const char *name;
+   struct sweet_pf_cnt c[SWEET_PF_N];
+};
+#define PF_CLK { "CP", "PERF_CP_ALWAYS_COUNT", "clk", PF_CNT }
+static const struct sweet_pf_preset sweet_pf_presets[] = {
+   { "busy", { PF_CLK, { "CP", "PERF_CP_BUSY_CYCLES", "cp", PF_CYC }, { "SP", "PERF_SP_BUSY_CYCLES", "sp", PF_CYC },
+               { "TP", "PERF_TP_BUSY_CYCLES", "tp", PF_CYC }, { "RB", "PERF_RB_BUSY_CYCLES", "rb", PF_CYC },
+               { "UCHE", "PERF_UCHE_BUSY_CYCLES", "uche", PF_CYC }, { "CCU", "PERF_CCU_BUSY_CYCLES", "ccu", PF_CYC },
+               { "RAS", "PERF_RAS_BUSY_CYCLES", "ras", PF_CYC } } },
+   { "alu", { PF_CLK, { "SP", "PERF_SP_BUSY_CYCLES", "sp", PF_CYC }, { "SP", "PERF_SP_ALU_WORKING_CYCLES", "alu", PF_CYC },
+              { "SP", "PERF_SP_EFU_WORKING_CYCLES", "efu", PF_CYC }, { "SP", "PERF_SP_NON_EXECUTION_CYCLES", "nonex", PF_CYC },
+              { "SP", "PERF_SP_FS_STAGE_FULL_ALU_INSTRUCTIONS", "full", PF_CNT },
+              { "SP", "PERF_SP_FS_STAGE_HALF_ALU_INSTRUCTIONS", "half", PF_CNT },
+              { "HLSQ", "PERF_HLSQ_QUADS", "quads", PF_CNT } } },
+   { "wave", { PF_CLK, { "SP", "PERF_SP_BUSY_CYCLES", "sp", PF_CYC }, { "SP", "PERF_SP_WAVE_CONTEXT_CYCLES", "wctx", PF_CNT },
+               { "SP", "PERF_SP_WAVE_NOP_CYCLES", "wnop", PF_CNT }, { "SP", "PERF_SP_WAVE_IDLE_CYCLES", "widle", PF_CNT },
+               { "SP", "PERF_SP_WAVE_SHORT_SYNC_CYCLES", "wss", PF_CNT },
+               { "SP", "PERF_SP_WAVE_LONG_SYNC_CYCLES", "wsy", PF_CNT },
+               { "SP", "PERF_SP_FS_STAGE_EFU_INSTRUCTIONS", "efui", PF_CNT } } },
+   { "mem", { PF_CLK, { "CMP", "PERF_CMPDECMP_VBIF_READ_DATA", "rd", PF_BEAT },
+              { "CMP", "PERF_CMPDECMP_VBIF_WRITE_DATA", "wr", PF_BEAT },
+              { "CMP", "PERF_CMPDECMP_VBIF_READ_DATA_CCU", "rdccu", PF_BEAT },
+              { "CMP", "PERF_CMPDECMP_VBIF_WRITE_DATA_CCU", "wrccu", PF_BEAT },
+              { "UCHE", "PERF_UCHE_VBIF_READ_BEATS_TP", "rdtp", PF_BEAT },
+              { "RB", "PERF_RB_STALL_CYCLES_CCU", "rbstall", PF_CYC },
+              { "UCHE", "PERF_UCHE_STALL_CYCLES_ARBITER", "uchestall", PF_CYC } } },
+   { "rop", { PF_CLK, { "RB", "PERF_RB_BUSY_CYCLES", "rb", PF_CYC }, { "RB", "PERF_RB_TOTAL_PASS", "pass", PF_CNT },
+              { "RB", "PERF_RB_C_READ", "cread", PF_CNT }, { "RB", "PERF_RB_C_WRITE", "cwrite", PF_CNT },
+              { "RB", "PERF_RB_STARVE_CYCLES_SP", "starvesp", PF_CYC },
+              { "RB", "PERF_RB_BLENDER_WORKING_CYCLES", "blend", PF_CYC },
+              { "RB", "PERF_RB_STALL_CYCLES_CCU", "stallccu", PF_CYC } } },
+   { "tex", { PF_CLK, { "TP", "PERF_TP_BUSY_CYCLES", "tp", PF_CYC }, { "TP", "PERF_TP_L1_CACHELINE_REQUESTS", "l1req", PF_CNT },
+              { "TP", "PERF_TP_L1_CACHELINE_MISSES", "l1miss", PF_CNT }, { "TP", "PERF_TP_OUTPUT_PIXELS", "texels", PF_CNT },
+              { "TP", "PERF_TP_STALL_CYCLES_UCHE", "tpstall", PF_CYC }, { "SP", "PERF_SP_STALL_CYCLES_TP", "spstalltp", PF_CYC },
+              { "SP", "PERF_SP_FS_STAGE_TEX_INSTRUCTIONS", "texi", PF_CNT } } },
+   { "ras", { PF_CLK, { "TSE", "PERF_TSE_INPUT_PRIM", "prims", PF_CNT }, { "TSE", "PERF_TSE_OUTPUT_VISIBLE_PRIM", "vis", PF_CNT },
+              { "RAS", "PERF_RAS_8X4_TILES", "t8x4", PF_CNT }, { "RAS", "PERF_RAS_FULLY_COVERED_8X4_TILES", "full8x4", PF_CNT },
+              { "LRZ", "PERF_LRZ_TOTAL_PIXEL", "lrzpx", PF_CNT }, { "LRZ", "PERF_LRZ_VISIBLE_PIXEL_AFTER_LRZ", "lrzvis", PF_CNT },
+              { "HLSQ", "PERF_HLSQ_QUADS", "quads", PF_CNT } } },
+};
+#undef PF_CLK
+#define SWEET_PF_PRESETS ((unsigned) ARRAY_SIZE(sweet_pf_presets))
+struct sweet_pf_reg {
+   uint32_t sel, lo, selector;
+   bool ok;
+};
+static struct sweet_pf_reg sweet_pf_regs[SWEET_PF_PRESETS][SWEET_PF_N];
+static int sweet_pf_state = -1;   /* -1 unknown, 0 off, 1 on */
+static bool sweet_pf_draws, sweet_pf_sweep, sweet_pf_resolved;
+static volatile unsigned sweet_pf_cur;
+static struct tu_bo *sweet_pf_pbo, *sweet_pf_dbo;
+static volatile uint64_t *sweet_pf_pv, *sweet_pf_dv;
+/* a pass slot's samples (the timeline's report clears its own meta, so the pass is copied here) */
+struct sweet_pf_pmeta {
+   uint32_t gen, w, h, draws;
+   uint8_t preset, gmem;   /* preset + 1, 0: none */
+};
+static struct sweet_pf_pmeta sweet_pf_pmeta[SWEET_PT_SLOTS];
+static uint32_t sweet_pf_pgen, sweet_pf_lost;
+struct sweet_pf_dmeta {
+   uint32_t gen, fs, px;
+   uint8_t preset;
+};
+static struct sweet_pf_dmeta sweet_pf_dmeta[SWEET_PF_DS];
+static uint32_t sweet_pf_dnext, sweet_pf_dgen;
+
+/* the preset a command buffer samples with (latched by tu_BeginCommandBuffer); the env read once */
+static unsigned
+sweet_pf_latch(void)
+{
+   if (sweet_pf_state < 0) {
+      pthread_mutex_lock(&sweet_pt_lock);
+      if (sweet_pf_state < 0) {
+         const char *e = getenv("SWEET_TU_PERFCTR");
+         int on = e && *e && strcmp(e, "0") ? 1 : 0;
+         unsigned p = 0;
+         for (unsigned i = 0; on && i < SWEET_PF_PRESETS; i++)
+            if (!strcmp(e, sweet_pf_presets[i].name))
+               p = i;
+         sweet_pf_cur = p;
+         sweet_pf_draws = debug_get_num_option("SWEET_TU_PERFCTR_DRAW", 0) != 0;
+         sweet_pf_sweep = debug_get_num_option("SWEET_TU_PERFCTR_SWEEP", 0) != 0;
+         if (sweet_pf_sweep)
+            on = 1;
+         if (on)
+            mesa_logi("sweet: perf counters on, preset %s%s%s", sweet_pf_presets[p].name, sweet_pf_draws ? ", per draw" : "",
+                      sweet_pf_sweep ? ", sweep" : "");
+         sweet_pf_state = on;
+      }
+      pthread_mutex_unlock(&sweet_pt_lock);
+   }
+   return sweet_pf_cur;
+}
+
+/* with sweet_pt_lock held: the counters of every preset (once), and the pass samples' buffer */
+static bool
+sweet_pf_setup(struct tu_device *dev)
+{
+   if (!sweet_pf_resolved) {
+      sweet_pf_resolved = true;
+      unsigned ngroups = 0;
+      const struct fd_perfcntr_group *groups = fd_perfcntrs(&dev->physical_device->dev_id, &ngroups);
+      for (unsigned p = 0; p < SWEET_PF_PRESETS; p++) {
+         unsigned used[32] = {};
+         for (unsigned i = 0; i < SWEET_PF_N; i++) {
+            const struct sweet_pf_cnt *c = &sweet_pf_presets[p].c[i];
+            struct sweet_pf_reg *r = &sweet_pf_regs[p][i];
+            unsigned g = 0;
+            for (; groups && g < ngroups && strcmp(groups[g].name, c->group); g++)
+               ;
+            const struct fd_perfcntr_countable *k =
+               groups && g < ngroups && g < 32 ? fd_perfcntrs_countable(&groups[g], c->countable) : NULL;
+            if (!k || used[g] >= groups[g].num_counters) {
+               mesa_logw("sweet: perf counters: no %s %s", c->group, c->countable);
+               continue;
+            }
+            const struct fd_perfcntr_counter *ctr = &groups[g].counters[groups[g].num_counters - 1 - used[g]++];
+            *r = (struct sweet_pf_reg) { ctr->select_reg, ctr->counter_reg_lo, k->selector, true };
+         }
+      }
+   }
+   if (!sweet_pf_pbo) {
+      struct tu_bo *bo = NULL;
+      if (tu_bo_init_new(dev, NULL, &bo, SWEET_PT_SLOTS * SWEET_PF_PQ * 8, TU_BO_ALLOC_NO_FLAGS, "sweet perf passes") ==
+             VK_SUCCESS &&
+          tu_bo_map(dev, bo, NULL) == VK_SUCCESS && bo->map) {
+         memset(bo->map, 0, SWEET_PT_SLOTS * SWEET_PF_PQ * 8);
+         sweet_pf_pv = (volatile uint64_t *) bo->map;
+         sweet_pf_pbo = bo;
+      } else {
+         mesa_logw("sweet: perf counters off (no buffer)");
+         sweet_pf_state = 0;
+         return false;
+      }
+   }
+   return true;
+}
+
+/* tu_cmd_render: the pass's slot (the timeline's) samples with the command buffer's preset */
+static int
+sweet_pf_open(struct tu_cmd_buffer *cmd, int slot)
+{
+   if (slot < 0 || sweet_pf_state != 1)
+      return slot;
+   pthread_mutex_lock(&sweet_pt_lock);
+   if (sweet_pf_setup(cmd->device)) {
+      for (unsigned i = 0; i < SWEET_PF_PQ; i++)
+         sweet_pf_pv[SWEET_PF_PQ * slot + i] = 0;
+      if (sweet_pf_pmeta[slot].preset)
+         sweet_pf_lost++;   /* never reported: the ring went round in a report's time */
+      const struct sweet_pt_meta *m = &sweet_pt_meta[slot];
+      sweet_pf_pgen = sweet_pf_pgen + 1 ? sweet_pf_pgen + 1 : 1;
+      sweet_pf_pmeta[slot] = (struct sweet_pf_pmeta) { sweet_pf_pgen, m->w, m->h, m->draws,
+                                                       (uint8_t) (cmd->sweet_pf_preset + 1), m->gmem };
+   }
+   pthread_mutex_unlock(&sweet_pt_lock);
+   return slot;
+}
+
+template <chip CHIP>
+static void
+sweet_pf_sample(struct tu_cs *cs, unsigned preset, uint64_t iova)
+{
+   for (unsigned i = 0; i < SWEET_PF_N; i++) {
+      const struct sweet_pf_reg *r = &sweet_pf_regs[preset][i];
+      if (!r->ok)
+         continue;
+      tu_cs_emit_pkt7(cs, CP_REG_TO_MEM, 3);
+      tu_cs_emit(cs, CP_REG_TO_MEM_0_REG(r->lo) | CP_REG_TO_MEM_0_64B);
+      tu_cs_emit_qw(cs, iova + i * 8);
+   }
+}
+
+/* around a pass, in the primary's cs: end 0 before its begin stamp (selects + before), 1 after its end stamp */
+template <chip CHIP>
+static void
+sweet_pf_pass(struct tu_cmd_buffer *cmd, int slot, unsigned end)
+{
+   if (CHIP != A6XX || slot < 0 || sweet_pf_state != 1 || !sweet_pf_pbo || !sweet_pf_pmeta[slot].preset)
+      return;
+   const unsigned p = sweet_pf_pmeta[slot].preset - 1;
+   struct tu_cs *cs = &cmd->cs;
+   const uint64_t base = sweet_pf_pbo->iova + (uint64_t) SWEET_PF_PQ * slot * 8;
+   tu_cs_emit_wfi(cs);
+   if (!end) {
+      for (unsigned i = 0; i < SWEET_PF_N; i++) {
+         const struct sweet_pf_reg *r = &sweet_pf_regs[p][i];
+         if (!r->ok)
+            continue;
+         tu_cs_emit_pkt4(cs, r->sel, 1);
+         tu_cs_emit(cs, r->selector);
+      }
+      tu_cs_emit_wfi(cs);
+      sweet_pf_sample<CHIP>(cs, p, base);
+   } else {
+      sweet_pf_sample<CHIP>(cs, p, base + SWEET_PF_N * 8);
+      tu_cs_emit_pkt7(cs, CP_MEM_WRITE, 4);
+      tu_cs_emit_qw(cs, base + 2 * SWEET_PF_N * 8);
+      tu_cs_emit_qw(cs, sweet_pf_pmeta[slot].gen);
+   }
+}
+
+/* per draw (SWEET_TU_PERFCTR_DRAW=1): the slot, -1 for none; the counters before the draw packet */
+template <chip CHIP>
+static int
+sweet_pf_before_draw(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   if (CHIP != A6XX || sweet_pf_state != 1 || !sweet_pf_draws || sweet_pt_state != 1 || !cmd->state.pass ||
+       cmd->device != sweet_pt_dev)
+      return -1;
+   pthread_mutex_lock(&sweet_pt_lock);
+   if (!sweet_pf_dbo) {
+      struct tu_bo *bo = NULL;
+      if (sweet_pf_setup(cmd->device) &&
+          tu_bo_init_new(cmd->device, NULL, &bo, SWEET_PF_DS * SWEET_PF_DQ * 8, TU_BO_ALLOC_NO_FLAGS,
+                         "sweet perf draws") == VK_SUCCESS &&
+          tu_bo_map(cmd->device, bo, NULL) == VK_SUCCESS && bo->map) {
+         memset(bo->map, 0, SWEET_PF_DS * SWEET_PF_DQ * 8);
+         sweet_pf_dv = (volatile uint64_t *) bo->map;
+         sweet_pf_dbo = bo;
+      } else {
+         mesa_logw("sweet: perf counters per draw off (no buffer)");
+         sweet_pf_draws = false;
+         pthread_mutex_unlock(&sweet_pt_lock);
+         return -1;
+      }
+   }
+   const uint32_t slot = sweet_pf_dnext++ % SWEET_PF_DS;
+   for (unsigned i = 0; i < SWEET_PF_DQ; i++)
+      sweet_pf_dv[SWEET_PF_DQ * slot + i] = 0;
+   sweet_pf_dgen = sweet_pf_dgen + 1 ? sweet_pf_dgen + 1 : 1;
+   sweet_pf_dmeta[slot] = (struct sweet_pf_dmeta) { sweet_pf_dgen, cmd->sweet_fs_id, cmd->sweet_px,
+                                                    (uint8_t) cmd->sweet_pf_preset };
+   pthread_mutex_unlock(&sweet_pt_lock);
+   const uint64_t base = sweet_pf_dbo->iova + (uint64_t) SWEET_PF_DQ * slot * 8;
+   /* not in the binning pass: its VS-only run of the draw is not the draw's work */
+   tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(RENDER_MODE) | CP_COND_REG_EXEC_0_GMEM | CP_COND_REG_EXEC_0_SYSMEM);
+   tu_cs_emit_wfi(cs);
+   sweet_pf_sample<CHIP>(cs, cmd->sweet_pf_preset, base + SWEET_PF_N * 8);
+   tu_cond_exec_end(cs);
+   return (int) slot;
+}
+
+template <chip CHIP>
+static void
+sweet_pf_after_draw(struct tu_cmd_buffer *cmd, struct tu_cs *cs, int slot)
+{
+   if (CHIP != A6XX || slot < 0)
+      return;
+   const uint64_t base = sweet_pf_dbo->iova + (uint64_t) SWEET_PF_DQ * slot * 8;
+   const unsigned p = cmd->sweet_pf_preset;
+   tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(RENDER_MODE) | CP_COND_REG_EXEC_0_GMEM | CP_COND_REG_EXEC_0_SYSMEM);
+   tu_cs_emit_wfi(cs);
+   sweet_pf_sample<CHIP>(cs, p, base + 2 * SWEET_PF_N * 8);
+   for (unsigned i = 0; i < SWEET_PF_N; i++) {
+      if (!sweet_pf_regs[p][i].ok)
+         continue;
+      /* acc (dst) = acc (srcA) + after (srcB) - before (srcC) */
+      tu_cs_emit_pkt7(cs, CP_MEM_TO_MEM, 9);
+      tu_cs_emit(cs, CP_MEM_TO_MEM_0_WAIT_FOR_MEM_WRITES | CP_MEM_TO_MEM_0_DOUBLE | CP_MEM_TO_MEM_0_NEG_C);
+      tu_cs_emit_qw(cs, base + i * 8);
+      tu_cs_emit_qw(cs, base + i * 8);
+      tu_cs_emit_qw(cs, base + (2 * SWEET_PF_N + i) * 8);
+      tu_cs_emit_qw(cs, base + (SWEET_PF_N + i) * 8);
+   }
+   tu_cs_emit_pkt7(cs, CP_MEM_WRITE, 4);
+   tu_cs_emit_qw(cs, base + 3 * SWEET_PF_N * 8);
+   tu_cs_emit_qw(cs, sweet_pf_dmeta[slot].gen);
+   tu_cond_exec_end(cs);
+}
+
+/* the report's sums: per preset, all passes, pass kinds (WxH, GMEM/sysmem), fragment shaders (per draw) */
+struct sweet_pf_sum {
+   uint32_t n, draws, gmem;
+   uint64_t ticks, px, v[SWEET_PF_N];
+};
+struct sweet_pf_kind {
+   uint8_t preset, gmem;
+   uint32_t w, h;
+   struct sweet_pf_sum s;
+};
+struct sweet_pf_fs {
+   uint8_t preset;
+   uint32_t fs;
+   struct sweet_pf_sum s;
+};
+#define SWEET_PF_KINDS 32u
+#define SWEET_PF_FSN 64u
+static struct sweet_pf_sum sweet_pf_all[SWEET_PF_PRESETS];
+static struct sweet_pf_kind sweet_pf_kinds[SWEET_PF_KINDS];
+static struct sweet_pf_fs sweet_pf_fss[SWEET_PF_FSN];
+static unsigned sweet_pf_nkinds, sweet_pf_nfs;
+
+/* with sweet_pt_lock held: every sample the GPU finished, summed, and its slot freed */
+static void
+sweet_pf_collect(void)
+{
+   memset(sweet_pf_all, 0, sizeof(sweet_pf_all));
+   sweet_pf_nkinds = sweet_pf_nfs = 0;
+   for (uint32_t slot = 0; sweet_pf_pv && sweet_pt_ts && slot < SWEET_PT_SLOTS; slot++) {
+      struct sweet_pf_pmeta *m = &sweet_pf_pmeta[slot];
+      const volatile uint64_t *q = &sweet_pf_pv[SWEET_PF_PQ * slot];
+      if (!m->preset || q[2 * SWEET_PF_N] != m->gen)
+         continue;   /* none, or not run yet */
+      const unsigned p = m->preset - 1;
+      m->preset = 0;
+      const uint64_t b = sweet_pt_ts[SWEET_PT_Q * slot], e = sweet_pt_ts[SWEET_PT_Q * slot + 2];
+      struct sweet_pf_sum d = {};
+      d.n = 1;
+      d.draws = m->draws;
+      d.gmem = m->gmem;
+      d.ticks = e > b && e - b < 19200000ull ? e - b : 0;
+      d.px = (uint64_t) m->w * m->h;
+      for (unsigned i = 0; i < SWEET_PF_N; i++)
+         d.v[i] = q[SWEET_PF_N + i] - q[i];
+      unsigned k = 0;
+      for (; k < sweet_pf_nkinds; k++)
+         if (sweet_pf_kinds[k].preset == p && sweet_pf_kinds[k].gmem == m->gmem && sweet_pf_kinds[k].w == m->w &&
+             sweet_pf_kinds[k].h == m->h)
+            break;
+      if (k == sweet_pf_nkinds && k < SWEET_PF_KINDS) {
+         sweet_pf_kinds[k] = (struct sweet_pf_kind) { (uint8_t) p, m->gmem, m->w, m->h, {} };
+         sweet_pf_nkinds++;
+      }
+      struct sweet_pf_sum *dst[2] = { &sweet_pf_all[p], k < sweet_pf_nkinds ? &sweet_pf_kinds[k].s : NULL };
+      for (unsigned j = 0; j < 2; j++) {
+         if (!dst[j])
+            continue;
+         dst[j]->n += d.n;
+         dst[j]->draws += d.draws;
+         dst[j]->gmem += d.gmem;
+         dst[j]->ticks += d.ticks;
+         dst[j]->px += d.px;
+         for (unsigned i = 0; i < SWEET_PF_N; i++)
+            dst[j]->v[i] += d.v[i];
+      }
+   }
+   for (uint32_t slot = 0; sweet_pf_dv && slot < SWEET_PF_DS; slot++) {
+      const struct sweet_pf_dmeta *dm = &sweet_pf_dmeta[slot];
+      const volatile uint64_t *q = &sweet_pf_dv[SWEET_PF_DQ * slot];
+      if (!dm->gen || q[3 * SWEET_PF_N] != dm->gen)
+         continue;
+      unsigned k = 0;
+      for (; k < sweet_pf_nfs; k++)
+         if (sweet_pf_fss[k].preset == dm->preset && sweet_pf_fss[k].fs == dm->fs)
+            break;
+      if (k == sweet_pf_nfs) {
+         if (k == SWEET_PF_FSN)
+            continue;
+         sweet_pf_fss[k] = (struct sweet_pf_fs) { dm->preset, dm->fs, {} };
+         sweet_pf_nfs++;
+      }
+      struct sweet_pf_sum *s = &sweet_pf_fss[k].s;
+      s->n++;
+      s->px += dm->px;
+      for (unsigned i = 0; i < SWEET_PF_N; i++)
+         s->v[i] += q[i];
+      sweet_pf_dmeta[slot].gen = 0;
+   }
+}
