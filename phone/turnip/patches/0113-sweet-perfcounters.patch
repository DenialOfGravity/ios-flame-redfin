+/* sweet 0113: "T tu-perf 5s" lines (SweetMetal2 dlsyms it): part 0 sums what the GPU finished since the last call and
+ * prints the passes, parts 1 and 2 the fragment shaders of most clocks (per draw: ranks 0-3, 4-7), part 3 and on
+ * nothing (0). With SWEET_TU_PERFCTR_SWEEP the
+ * preset moves on at part 0. */
+extern "C" __attribute__((visibility("default"))) size_t sweet_tu_perf_report(char *out, size_t size, unsigned part);
+extern "C" __attribute__((visibility("default"))) size_t
+sweet_tu_perf_report(char *out, size_t size, unsigned part)
+{
+   if (!out || size == 0)
+      return 0;
+   out[0] = 0;
+   if (sweet_pf_state != 1 || sweet_pt_state != 1 || part > 2)
+      return 0;
+   size_t at = 0;
+#define PF_PUT(...) at += snprintf(out + at, size > at ? size - at : 0, __VA_ARGS__)
+   pthread_mutex_lock(&sweet_pt_lock);
+   if (part == 0) {
+      sweet_pf_collect();
+      for (unsigned p = 0; p < SWEET_PF_PRESETS; p++) {
+         const struct sweet_pf_sum *s = &sweet_pf_all[p];
+         if (!s->n)
+            continue;
+         PF_PUT("%spreset %s: %u passes (gmem %u) %u draws %.1fms |", at ? " || " : "", sweet_pf_presets[p].name, s->n,
+                s->gmem, s->draws, s->ticks / 19200.0);
+         at += sweet_pf_put_sum(out + at, size > at ? size - at : 0, p, s, 1.0, true);
+         /* the 3 pass kinds of most clocks: per pass */
+         bool shown[SWEET_PF_KINDS] = {};
+         for (unsigned r = 0; r < 3; r++) {
+            int best = -1;
+            for (unsigned k = 0; k < sweet_pf_nkinds; k++)
+               if (!shown[k] && sweet_pf_kinds[k].preset == p &&
+                   (best < 0 || sweet_pf_kinds[k].s.v[0] > sweet_pf_kinds[best].s.v[0]))
+                  best = (int) k;
+            if (best < 0)
+               break;
+            shown[best] = true;
+            const struct sweet_pf_kind *k = &sweet_pf_kinds[best];
+            PF_PUT(" | %ux%u %c x%u d%.1f %.2fms/pass:", k->w, k->h, k->gmem ? 'g' : 's', k->s.n,
+                   (double) k->s.draws / k->s.n, k->s.ticks / 19200.0 / k->s.n);
+            at += sweet_pf_put_sum(out + at, size > at ? size - at : 0, p, &k->s, (double) k->s.n, true);
+         }
+      }
+      if (sweet_pf_lost)
+         PF_PUT(" | lost %u", sweet_pf_lost);
+      sweet_pf_lost = 0;
+      if (!at && sweet_pf_sweep)
+         PF_PUT("preset %s: no passes", sweet_pf_presets[sweet_pf_cur].name);
+      if (sweet_pf_sweep)
+         sweet_pf_cur = (sweet_pf_cur + 1) % SWEET_PF_PRESETS;
+   } else if (sweet_pf_nfs) {
+      /* the fragment shaders of most clocks (per draw, the ids of T tu-draw): per draw */
+      bool shown[SWEET_PF_FSN] = {};
+      for (unsigned r = 0; r < 4 * part; r++) {
+         int best = -1;
+         for (unsigned k = 0; k < sweet_pf_nfs; k++)
+            if (!shown[k] && (best < 0 || sweet_pf_fss[k].s.v[0] > sweet_pf_fss[best].s.v[0]))
+               best = (int) k;
+         if (best < 0)
+            break;
+         shown[best] = true;
+         if (r < 4 * (part - 1))
+            continue;   /* part 1: ranks 0-3, part 2: 4-7 */
+         const struct sweet_pf_fs *f = &sweet_pf_fss[best];
+         unsigned instrs = 0;
+         for (unsigned i = 0; i < sweet_fs_n; i++)
+            if (sweet_fs_tab[i].id == f->fs)
+               instrs = sweet_fs_tab[i].instrs;
+         PF_PUT("%s#%u %s i%u d%u a%.0fk:", at ? " " : "", f->fs, sweet_pf_presets[f->preset].name, instrs, f->s.n,
+                f->s.n ? f->s.px / 1000.0 / f->s.n : 0.0);
+         at += sweet_pf_put_sum(out + at, size > at ? size - at : 0, f->preset, &f->s, f->s.n ? (double) f->s.n : 1.0, false);
+         PF_PUT(";");
+      }
+   }
+   pthread_mutex_unlock(&sweet_pt_lock);
+#undef PF_PUT
+   return at < size ? at : size - 1;
+}
