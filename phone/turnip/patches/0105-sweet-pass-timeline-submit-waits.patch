+/* SweetMetal2 (u-t): counters of the waits below, reported by sweet_tu_pass_report (tu_cmd_buffer.cc). */
+extern "C" uint64_t sweet_tu_submit_cpu_waits, sweet_tu_submit_cpu_wait_ns, sweet_tu_submit_gpu_waits, sweet_tu_submits;
+
+/* SweetMetal2 (u-t): SWEET_TU_GPU_WAIT=1 lets a submission whose wait is on a fence already submitted (every fence is on
+ * the kernel's one ring, in submission order) go at once, behind a CP_WAIT_FOR_IDLE the GPU runs first, instead of
+ * holding the submitting thread until the GPU finished that fence: the GPU waits instead of the CPU, and the next work
+ * is queued while the earlier runs. Turnip ends every command buffer with its caches flushed and starts the next
+ * with them invalidated, so the idle is what the wait's ordering needs. A wait on a sync not yet submitted still
+ * waits on the CPU. Off by default. */
+static bool
+darwin_gpu_waits(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("SWEET_TU_GPU_WAIT");
+      on = e && *e == '1';
+   }
+   return on == 1;
+}
+
+/* The wait's buffer: CP_WAIT_FOR_IDLE, CP_WAIT_FOR_ME (16 bytes), made once. False where it could not be made. */
+static bool
+darwin_wfi(struct tu_device *dev, NativeAdrenoAbiSubmitBuffer *out)
+{
+   static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+   static struct tu_bo *bo;
+   static bool failed;
+   pthread_mutex_lock(&lock);
+   if (!bo && !failed) {
+      struct tu_bo *made = NULL;
+      if (tu_bo_init_new(dev, NULL, &made, 4096, TU_BO_ALLOC_NO_FLAGS, "sweet wfi") == VK_SUCCESS &&
+          tu_bo_map(dev, made, NULL) == VK_SUCCESS && made->map) {
+         uint32_t *ib = (uint32_t *) made->map;
+         ib[0] = pm4_pkt7_hdr(CP_WAIT_FOR_IDLE, 0);
+         ib[1] = pm4_pkt7_hdr(CP_WAIT_FOR_ME, 0);
+         ib[2] = pm4_pkt7_hdr(CP_NOP, 1);
+         ib[3] = 0;
+         __sync_synchronize();
+         bo = made;
+      } else {
+         failed = true;
+         mesa_logw("sweet: SWEET_TU_GPU_WAIT: no buffer for the wait; waits stay on the CPU");
+      }
+   }
+   pthread_mutex_unlock(&lock);
+   if (!bo)
+      return false;
+   if (out)
+      *out = (NativeAdrenoAbiSubmitBuffer) { .handle = bo->darwin_handle, .iova = bo->iova, .bytes = 16 };
+   return true;
+}
