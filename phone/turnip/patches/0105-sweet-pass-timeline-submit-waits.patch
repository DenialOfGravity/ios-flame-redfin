+/* SweetMetal2 (u-t, frame timeline): each render pass's GPU time, written by the GPU (RB_DONE_TS of the always-on
+ * counter, as u_trace's timestamps) into a ring of 4096 begin/end pairs, with what the pass was (render area, first
+ * attachment's format, load/store, GMEM or sysmem) beside it on the CPU. On only where SWEET_TIMELINE is set and not "0"
+ * (the bundle sets it for backboardd), and only for the first device that records a pass. sweet_tu_pass_report() sums
+ * the passes that completed since its last call by kind and prints the most expensive; backboardd's frontend calls it
+ * every 5 s for its "T 5s" line. Counters of darwin_queue_submit's waits (tu_knl_darwin.cc) are reported with it. */
+#define SWEET_PT_SLOTS 4096u
+struct sweet_pt_meta {
+   uint32_t w, h, format, gen;
+   uint8_t gmem, load, store, atts;
+};
+static pthread_mutex_t sweet_pt_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct tu_device *sweet_pt_dev;
+static struct tu_bo *sweet_pt_bo;
+static volatile uint64_t *sweet_pt_ts;
+static struct sweet_pt_meta sweet_pt_meta[SWEET_PT_SLOTS];
+static uint32_t sweet_pt_next, sweet_pt_gen;
+static int sweet_pt_state = -1;   /* -1 unknown, 0 off, 1 on */
+extern "C" __attribute__((visibility("default"))) size_t sweet_tu_pass_report(char *out, size_t size, unsigned top);
+extern "C" {
+uint64_t sweet_tu_submit_cpu_waits, sweet_tu_submit_cpu_wait_ns, sweet_tu_submit_gpu_waits, sweet_tu_submits;
+}
+
+static int
+sweet_pt_open(struct tu_cmd_buffer *cmd, bool gmem)
+{
+   if (sweet_pt_state == 0)
+      return -1;
+   pthread_mutex_lock(&sweet_pt_lock);
+   if (sweet_pt_state < 0) {
+      const char *e = getenv("SWEET_TIMELINE");
+      sweet_pt_state = e && *e && strcmp(e, "0") ? 1 : 0;
+   }
+   int slot = -1;
+   if (sweet_pt_state == 1 && !sweet_pt_bo && !sweet_pt_dev) {
+      sweet_pt_dev = cmd->device;
+      struct tu_bo *bo = NULL;
+      if (tu_bo_init_new(cmd->device, NULL, &bo, SWEET_PT_SLOTS * 16, TU_BO_ALLOC_NO_FLAGS, "sweet pass timeline") == VK_SUCCESS) {
+         if (tu_bo_map(cmd->device, bo, NULL) == VK_SUCCESS && bo->map) {
+            memset(bo->map, 0, SWEET_PT_SLOTS * 16);
+            sweet_pt_ts = (volatile uint64_t *) bo->map;
+            sweet_pt_bo = bo;
+         }
+      }
+      if (!sweet_pt_bo) {
+         mesa_logw("sweet: pass timeline off (no buffer)");
+         sweet_pt_state = 0;
+      }
+   }
+   if (sweet_pt_state == 1 && sweet_pt_bo && sweet_pt_dev == cmd->device && cmd->state.pass) {
+      slot = (int) (sweet_pt_next++ % SWEET_PT_SLOTS);
+      sweet_pt_ts[2 * slot] = 0;
+      sweet_pt_ts[2 * slot + 1] = 0;
+      struct sweet_pt_meta m = {};
+      m.w = cmd->state.render_areas[0].extent.width;
+      m.h = cmd->state.render_areas[0].extent.height;
+      m.gmem = gmem;
+      const struct tu_render_pass *pass = cmd->state.pass;
+      const struct tu_subpass *sub = &pass->subpasses[0];
+      uint32_t att = VK_ATTACHMENT_UNUSED;
+      for (uint32_t i = 0; i < sub->color_count && att == VK_ATTACHMENT_UNUSED; i++)
+         att = sub->color_attachments[i].attachment;
+      if (att == VK_ATTACHMENT_UNUSED && sub->depth_used)
+         att = sub->depth_stencil_attachment.attachment;
+      if (att != VK_ATTACHMENT_UNUSED && att < pass->attachment_count) {
+         const struct tu_render_pass_attachment *a = &pass->attachments[att];
+         m.format = a->format;
+         m.load = a->clear_mask ? 'C' : a->load ? 'L' : 'D';
+         m.store = a->store ? 'S' : 'D';
+      } else {
+         m.load = m.store = '-';
+      }
+      m.atts = (uint8_t) MIN2(pass->attachment_count, 255u);
+      m.gen = ++sweet_pt_gen ? sweet_pt_gen : ++sweet_pt_gen;
+      sweet_pt_meta[slot] = m;
+   }
+   pthread_mutex_unlock(&sweet_pt_lock);
+   return slot;
+}
+
+template <chip CHIP>
+static void
+sweet_pt_stamp(struct tu_cmd_buffer *cmd, int slot, unsigned end)
+{
+   if (slot < 0)
+      return;
+   const uint64_t iova = sweet_pt_bo->iova + (uint64_t) (2 * slot + end) * 8;
+   struct tu_cs *cs = &cmd->cs;
+   if (CHIP == A6XX) {
+      tu_cs_emit_pkt7(cs, CP_EVENT_WRITE, 4);
+      tu_cs_emit(cs, CP_EVENT_WRITE_0_EVENT(RB_DONE_TS) | CP_EVENT_WRITE_0_TIMESTAMP);
+      tu_cs_emit_qw(cs, iova);
+      tu_cs_emit(cs, 0x00000000);
+   } else {
+      tu_cs_emit_pkt7(cs, CP_EVENT_WRITE7, 3);
+      tu_cs_emit(cs, CP_EVENT_WRITE7_0(.event = RB_DONE_TS, .write_src = EV_WRITE_ALWAYSON,
+                                       .write_dst = EV_DST_RAM, .write_enabled = true).value);
+      tu_cs_emit_qw(cs, iova);
+   }
+}
+
+/* "passes N M.Mms (gmem a sysmem b) top: WxH FMT L/S gmem|sysmem T.Tms/n ... | tu waits cpu n (x ms) gpu n of s submits" */
+extern "C" __attribute__((visibility("default"))) size_t
+sweet_tu_pass_report(char *out, size_t size, unsigned top)
+{
+   if (!out || size == 0)
+      return 0;
+   out[0] = 0;
+   struct key {
+      uint32_t w, h, format;
+      uint8_t gmem, load, store;
+      uint64_t ticks;
+      uint32_t n;
+   } keys[48];
+   unsigned nkeys = 0;
+   uint64_t all_ticks = 0;
+   uint32_t passes = 0, gmem_passes = 0;
+   pthread_mutex_lock(&sweet_pt_lock);
+   if (sweet_pt_ts) {
+      for (uint32_t slot = 0; slot < SWEET_PT_SLOTS; slot++) {
+         struct sweet_pt_meta *m = &sweet_pt_meta[slot];
+         if (!m->gen)
+            continue;
+         const uint64_t b = sweet_pt_ts[2 * slot], e = sweet_pt_ts[2 * slot + 1];
+         if (!b || !e || e < b)
+            continue;   /* not run yet (or a reused slot half written): next time */
+         m->gen = 0;
+         const uint64_t t = e - b;
+         if (t > 19200000ull)
+            continue;   /* over a second: not one pass's time */
+         passes++;
+         gmem_passes += m->gmem;
+         all_ticks += t;
+         unsigned k = 0;
+         for (; k < nkeys; k++)
+            if (keys[k].w == m->w && keys[k].h == m->h && keys[k].format == m->format && keys[k].gmem == m->gmem &&
+                keys[k].load == m->load && keys[k].store == m->store)
+               break;
+         if (k == nkeys) {
+            if (nkeys == ARRAY_SIZE(keys))
+               continue;
+            keys[nkeys++] = (struct key) { m->w, m->h, m->format, m->gmem, m->load, m->store, 0, 0 };
+         }
+         keys[k].ticks += t;
+         keys[k].n++;
+      }
+   }
+   pthread_mutex_unlock(&sweet_pt_lock);
+   /* the always-on counter: 19.2 MHz (timestampPeriod) */
+   const double ms_per_tick = 1000.0 / 19200000.0;
+   size_t at = 0;
+   at += snprintf(out + at, size > at ? size - at : 0, "passes %u %.1fms (gmem %u sysmem %u)", passes, all_ticks * ms_per_tick,
+                  gmem_passes, passes - gmem_passes);
+   for (unsigned i = 0; i < top && i < nkeys; i++) {
+      unsigned best = i;
+      for (unsigned k = i + 1; k < nkeys; k++)
+         if (keys[k].ticks > keys[best].ticks)
+            best = k;
+      struct key tmp = keys[i];
+      keys[i] = keys[best];
+      keys[best] = tmp;
+      const char *f = keys[i].format ? util_format_short_name(vk_format_to_pipe_format((VkFormat) keys[i].format)) : "none";
+      at += snprintf(out + at, size > at ? size - at : 0, "%s %ux%u %s %c/%c %s %.2fms x%u", i ? "," : " top:", keys[i].w,
+                     keys[i].h, f ? f : "?", keys[i].load, keys[i].store, keys[i].gmem ? "gmem" : "sysmem",
+                     keys[i].ticks * ms_per_tick / keys[i].n, keys[i].n);
+   }
+   static uint64_t last[4];
+   const uint64_t now[4] = { p_atomic_read(&sweet_tu_submits), p_atomic_read(&sweet_tu_submit_cpu_waits),
+                             p_atomic_read(&sweet_tu_submit_cpu_wait_ns), p_atomic_read(&sweet_tu_submit_gpu_waits) };
+   at += snprintf(out + at, size > at ? size - at : 0, " | tu submits %llu, cpu-waited %llu (%.1fms), gpu-waited %llu",
+                  (unsigned long long) (now[0] - last[0]), (unsigned long long) (now[1] - last[1]),
+                  (now[2] - last[2]) / 1e6, (unsigned long long) (now[3] - last[3]));
+   memcpy(last, now, sizeof(last));
+   return at < size ? at : size - 1;
+}
