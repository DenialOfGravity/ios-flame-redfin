+/* sweet 0110 (u-tr): SWEET_TU_CPUPROF=1: per entry point "name calls/mean us/total ms" since the last call, then the
+ * draw counts; "" when off. SweetMetal2's frontend logs it as its own T line ("native-metal: T tu-cpu:"). */
+extern "C" __attribute__((visibility("default"))) size_t sweet_tu_cpu_report(char *out, size_t size);
+extern "C" __attribute__((visibility("default"))) size_t
+sweet_tu_cpu_report(char *out, size_t size)
+{
+   if (!out || size == 0)
+      return 0;
+   out[0] = 0;
+   if (!sweet_cp_enabled())
+      return 0;
+   static const char *const names[SWEET_CP_COUNT] = {
+      "draw", "state", "const+desc", "pipeline", "sets", "push", "rp-begin", "rp-end", "render", "exec",
+      "begin-cb", "end-cb", "bo-new", "full", "prog", "consts", "desc",
+   };
+   size_t at = 0;
+#define SWEET_PUT(...) (at += snprintf(out + at, size > at ? size - at : 0, __VA_ARGS__))
+   for (unsigned k = 0; k < SWEET_CP_COUNT; k++) {
+      const uint64_t n = p_atomic_xchg(&sweet_cp_n[k], 0);
+      const uint64_t ns = k < SWEET_CP_TIMED ? p_atomic_xchg(&sweet_cp_ns[k], 0) : 0;
+      if (!n)
+         continue;
+      if (k < SWEET_CP_TIMED)
+         SWEET_PUT("%s%s %llu/%.1fus/%.1fms", at ? " " : "", names[k], (unsigned long long) n, ns / 1e3 / n, ns / 1e6);
+      else
+         SWEET_PUT("%s%s %llu", at ? " " : "", names[k], (unsigned long long) n);
+   }
+#undef SWEET_PUT
+   return at < size ? at : size - 1;
+}
