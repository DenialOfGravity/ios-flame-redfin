+/* sweet 0110 (u-tr): SWEET_TU_CPUPROF=1 times Turnip's own CPU work per entry point (os_time_get_nano around each, summed
+ * with atomics across recording threads) and counts what made draws re-emit state; sweet_tu_cpu_report (tu_cmd_buffer.cc)
+ * gives per entry calls/mean us/total ms since its last call and starts the sums again. Off: one relaxed load. */
+enum sweet_cp {
+   SWEET_CP_DRAW,        /* vkCmdDrawIndexed, all of it */
+   SWEET_CP_STATE,       /* tu6_draw_common: state emission of a draw (any vkCmdDraw*) */
+   SWEET_CP_CONSTDESC,   /* of which: push/inline consts and descriptor set draw states */
+   SWEET_CP_PIPELINE,    /* vkCmdBindPipeline */
+   SWEET_CP_SETS,        /* vkCmdBindDescriptorSets2 */
+   SWEET_CP_PUSH,        /* vkCmdPushConstants2 */
+   SWEET_CP_RP_BEGIN,    /* vkCmdBeginRenderPass2 */
+   SWEET_CP_RP_END,      /* vkCmdEndRenderPass2 */
+   SWEET_CP_RENDER,      /* of which: tu_cmd_render (sysmem/gmem decision, IB assembly, tile loop) */
+   SWEET_CP_EXEC,        /* vkCmdExecuteCommands */
+   SWEET_CP_BEGIN_CB,    /* vkBeginCommandBuffer (a reset cs frees all but its last BO) */
+   SWEET_CP_END_CB,      /* vkEndCommandBuffer */
+   SWEET_CP_BO_NEW,      /* tu_cs_add_bo: a new command-stream BO (kernel alloc + map) */
+   SWEET_CP_TIMED,
+   SWEET_CP_FULL = SWEET_CP_TIMED, /* counts only: draws that re-emitted every draw state (first in a pass/secondary) */
+   SWEET_CP_PROG,        /* draws after a program change */
+   SWEET_CP_CONSTS,      /* draws with dirty consts */
+   SWEET_CP_DESC,        /* draws with dirty descriptor sets */
+   SWEET_CP_COUNT
+};
+extern "C" uint64_t sweet_cp_ns[SWEET_CP_COUNT], sweet_cp_n[SWEET_CP_COUNT];
+extern "C" int sweet_cp_on;
+
+static inline bool
+sweet_cp_enabled(void)
+{
+   int on = p_atomic_read(&sweet_cp_on);
+   if (on < 0) {
+      const char *e = getenv("SWEET_TU_CPUPROF");
+      on = e && *e == '1';
+      p_atomic_set(&sweet_cp_on, on);
+   }
+   return on;
+}
+
+static inline uint64_t
+sweet_cp_t0(void)
+{
+   return sweet_cp_enabled() ? os_time_get_nano() : 0;
+}
+
+static inline void
+sweet_cp_add(int k, uint64_t t0)
+{
+   if (t0) {
+      p_atomic_add(&sweet_cp_ns[k], os_time_get_nano() - t0);
+      p_atomic_inc(&sweet_cp_n[k]);
+   }
+}
+
+static inline void
+sweet_cp_count(int k)
+{
+   p_atomic_inc(&sweet_cp_n[k]);
+}
+
+struct sweet_cp_scope {
+   int k;
+   uint64_t t0;
+   sweet_cp_scope(int k) : k(k), t0(sweet_cp_t0()) {}
+   ~sweet_cp_scope() { sweet_cp_add(k, t0); }
+};
