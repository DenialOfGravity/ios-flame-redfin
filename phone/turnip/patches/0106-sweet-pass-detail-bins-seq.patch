+/* u-w (0106): after the binning pass, its visibility bits (which bins of each VSC pipe have geometry; Turnip skips
+ * the loads, draws and stores of the others) into the slot, then the "binned" timestamp */
+template <chip CHIP>
+static void
+sweet_pt_binned(struct tu_cmd_buffer *cmd, int slot)
+{
+   if (slot < 0)
+      return;
+   if (CHIP == A6XX && sweet_pt_meta[slot].binning) {
+      struct tu_cs *cs = &cmd->cs;
+      tu_cs_emit_pkt7(cs, CP_REG_TO_MEM, 3);
+      tu_cs_emit(cs, CP_REG_TO_MEM_0_REG(REG_A6XX_VSC_CHANNEL_VISIBILITY(0)) | CP_REG_TO_MEM_0_CNT(32));
+      tu_cs_emit_qw(cs, sweet_pt_bo->iova + (uint64_t) (SWEET_PT_Q * slot + 4) * 8);
+   }
+   sweet_pt_stamp<CHIP>(cmd, slot, 1);
+}
