diff --git a/src/freedreno/vulkan/tu_pipeline.cc b/src/freedreno/vulkan/tu_pipeline.cc
index ae72a0f..a1376ea 100644
--- a/src/freedreno/vulkan/tu_pipeline.cc
+++ b/src/freedreno/vulkan/tu_pipeline.cc
@@ -3787,6 +3787,14 @@ tu6_emit_prim_mode_sysmem(struct tu_cs *cs,
       FLUSH_PER_OVERLAP_AND_OVERWRITE : NO_FLUSH;
    if (!sweet_prim_order)
       sysmem_prim_mode = NO_FLUSH;
+   /* sweet 0107: SWEET_TU_ORDER_FETCHERS_ONLY=1: in a pass with rasterization-order access (metal2vulkan flags every
+    * pipeline of a pass in which any draw fetches), only the pipelines whose fragment shader reads an input
+    * attachment flush per overlap; the others draw unflushed, as the blob draws everything but its advanced-blend
+    * draws. A feedback loop keeps the flush. */
+   static const unsigned sweet_fetchers_only = debug_get_num_option("SWEET_TU_ORDER_FETCHERS_ONLY", 0);
+   if (sweet_fetchers_only && fs && !fs->fs.sweet_reads_input_attachments && !feedback_loops &&
+       !fs->fs.dynamic_input_attachments_used && !TU_DEBUG(RAST_ORDER))
+      sysmem_prim_mode = NO_FLUSH;
 
