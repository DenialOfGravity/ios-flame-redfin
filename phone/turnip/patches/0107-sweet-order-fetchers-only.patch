       *sysmem_single_prim_mode = true;
@@ -4429,6 +4437,15 @@ tu_pipeline_builder_parse_rasterization_order(
     * test of what it costs; overlapping fetch draws may then read a stale pixel) */
    if (!debug_get_num_option("TU_SWEET_PRIM_ORDER", 1))
       gmem_prim_mode = NO_FLUSH;
+   /* sweet 0107: SWEET_TU_ORDER_FETCHERS_ONLY=1, as in tu6_emit_prim_mode_sysmem: only fetching fragment shaders
+    * flush per overlap in GMEM (only where the pipeline has its fragment shader) */
+   {
+      static const unsigned sweet_fetchers_only = debug_get_num_option("SWEET_TU_ORDER_FETCHERS_ONLY", 0);
+      const struct tu_shader *sweet_fs = pipeline->shaders[MESA_SHADER_FRAGMENT];
+      if (sweet_fetchers_only && sweet_fs && !sweet_fs->fs.sweet_reads_input_attachments &&
+          !sweet_fs->fs.dynamic_input_attachments_used && !TU_DEBUG(RAST_ORDER))
+         gmem_prim_mode = NO_FLUSH;
+   }
 
    struct tu_cs cs;
 
