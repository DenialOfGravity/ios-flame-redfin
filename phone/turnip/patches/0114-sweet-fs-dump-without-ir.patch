+/* sweet 0114: SWEET_TU_FS_DUMP's disassembly. A compiled variant no longer holds its ir3 (ir3 frees it after assembly
+ * unless shader debugging keeps it), and ir3_shader_disasm() reads it (the r47 crash: SIGSEGV at 0x18): without the ir
+ * only the binary is disassembled. */
+static void
+sweet_variant_disasm(const struct ir3_shader_variant *v, FILE *f)
+{
+   if (v->ir) {
+      ir3_shader_disasm((struct ir3_shader_variant *) v, v->bin, f);
+      return;
+   }
+   fprintf(f, "; %u instrs, %u dwords, %u full regs, %u half regs, constlen %u (binary only: no ir kept)\n",
+           v->info.instrs_count, v->info.sizedwords, v->info.max_reg + 1, v->info.max_half_reg + 1, v->constlen);
+   disasm_a3xx(v->bin, v->info.sizedwords, 0, f, v->compiler->gen * 100);
+}
