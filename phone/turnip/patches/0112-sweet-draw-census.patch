+/* sweet 0112 (u-gpudraw): the draw census. The fragment shaders the passes' draws use (by tu_shader, at most 128),
+ * their ir3 stats and draws, and with SWEET_TU_DRAWTS=1 each draw's GPU time: an RB_DONE_TS after every draw inside
+ * a render pass, into a ring of 16384 stamps, the time from the draw before it in its recording charged to its
+ * fragment shader. In GMEM a pass's draw_cs runs once per bin and a slot keeps the last bin's stamp, so the times
+ * mean what they say in sysmem (TU_DEBUG=sysmem). Only with SWEET_TIMELINE on, in the device the timeline uses. */
+#define SWEET_FS_N 128u
+#define SWEET_DS_SLOTS 16384u
+struct sweet_fs_ent {
+   const struct tu_shader *fs;
+   uint32_t id, draws, timed;
+   uint64_t ticks, px_all, px_timed;   /* px: each draw's scissor/viewport/render area, summed */
+   uint16_t instrs, sizedw, max_reg, max_half, constlen, tex, ss, sy, sstall, pvt;
+   uint8_t waves, dbl, fetch, gorder, sorder, noearlyz, kill;
+};
+static struct sweet_fs_ent sweet_fs_tab[SWEET_FS_N];
+static uint32_t sweet_fs_n, sweet_fs_ids, sweet_fs_last;
+static uint32_t sweet_cb_serials;
+struct sweet_ds_meta {
+   uint32_t gen, serial, idx, fs, px;
+};
+/* sweet 0112: the passes the last pass report counted (begin, end), for the draw report's time split */
+static struct sweet_pt_win { uint64_t b, e; } sweet_pt_win[SWEET_PT_SLOTS];
+static uint32_t sweet_pt_nwin;
+static struct sweet_ds_meta sweet_ds_meta[SWEET_DS_SLOTS];
+static struct tu_bo *sweet_ds_bo;
+static volatile uint64_t *sweet_ds_ts;
+static uint32_t sweet_ds_next, sweet_ds_gen;
+static int sweet_ds_state = -1;   /* -1 unknown, 0 off, 1 on */
+extern "C" {
+/* tu_descriptor_set.cc: sampled image descriptors written, by layout: linear, tiled, UBWC */
+extern uint64_t sweet_tex_writes[3];
+}
+
+static void
+sweet_draw_census(struct tu_cmd_buffer *cmd)
+{
+   if (sweet_pt_state != 1 || !cmd->state.pass)
+      return;
+   struct tu_render_pass_state *rp = &cmd->state.rp;
+   const struct tu_shader *fs = cmd->state.shaders[MESA_SHADER_FRAGMENT];
+   if (fs && fs->fs.sweet_reads_input_attachments)
+      rp->sweet_fetch_draws++;
+   if (cmd->state.sweet_gmem_flush)
+      rp->sweet_gorder_draws++;
+   if (cmd->state.pipeline_sysmem_single_prim_mode)
+      rp->sweet_sorder_draws++;
+   cmd->sweet_fs_id = 0;
+   {
+      /* the draw's bound: scissor 0 within viewport 0 within the render area */
+      const struct vk_viewport_state *vp = &cmd->vk.dynamic_graphics_state.vp;
+      const VkRect2D *sc = &vp->scissors[0];
+      const VkViewport *v = &vp->viewports[0];
+      const VkRect2D *ra = &cmd->state.render_areas[0];
+      int64_t x0 = MAX2((int64_t) sc->offset.x, (int64_t) MIN2(v->x, v->x + v->width));
+      int64_t y0 = MAX2((int64_t) sc->offset.y, (int64_t) MIN2(v->y, v->y + v->height));
+      int64_t x1 = MIN2((int64_t) sc->offset.x + sc->extent.width, (int64_t) MAX2(v->x, v->x + v->width));
+      int64_t y1 = MIN2((int64_t) sc->offset.y + sc->extent.height, (int64_t) MAX2(v->y, v->y + v->height));
+      if (ra->extent.width && ra->extent.height) {   /* a secondary has none: scissor in viewport alone */
+         x0 = MAX2(x0, (int64_t) ra->offset.x);
+         y0 = MAX2(y0, (int64_t) ra->offset.y);
+         x1 = MIN2(x1, (int64_t) ra->offset.x + ra->extent.width);
+         y1 = MIN2(y1, (int64_t) ra->offset.y + ra->extent.height);
+      }
+      cmd->sweet_px = (x1 > x0 && y1 > y0) ? (uint32_t) ((x1 - x0) * (y1 - y0)) : 0;
+   }
+   if (!fs || cmd->device != sweet_pt_dev)
+      return;
+   pthread_mutex_lock(&sweet_pt_lock);
+   unsigned i = sweet_fs_last;
+   if (i >= sweet_fs_n || sweet_fs_tab[i].fs != fs) {
+      for (i = 0; i < sweet_fs_n && sweet_fs_tab[i].fs != fs; i++)
+         ;
+      if (i == sweet_fs_n) {
+         if (sweet_fs_n == SWEET_FS_N) {
+            i = 0;   /* full: the entry of fewest draws goes */
+            for (unsigned k = 1; k < SWEET_FS_N; k++)
+               if (sweet_fs_tab[k].draws < sweet_fs_tab[i].draws)
+                  i = k;
+         } else {
+            i = sweet_fs_n++;
+         }
+         struct sweet_fs_ent e = {};
+         e.fs = fs;
+         e.id = ++sweet_fs_ids;
+         const struct ir3_shader_variant *v = fs->variant;
+         if (v) {
+            e.instrs = (uint16_t) v->info.instrs_count;
+            e.sizedw = (uint16_t) v->info.sizedwords;
+            e.max_reg = (uint16_t) (v->info.max_reg + 1);
+            e.max_half = (uint16_t) (v->info.max_half_reg + 1);
+            e.constlen = (uint16_t) v->constlen;
+            e.tex = (uint16_t) v->info.instrs_per_cat[5];
+            e.ss = (uint16_t) v->info.ss;
+            e.sy = (uint16_t) v->info.sy;
+            e.sstall = (uint16_t) v->info.sstall;
+            e.pvt = (uint16_t) MIN2(v->pvtmem_size, 0xffffu);
+            e.waves = (uint8_t) v->info.max_waves;
+            e.dbl = v->info.double_threadsize;
+            e.noearlyz = v->no_earlyz;
+            e.kill = v->has_kill;
+         }
+         e.fetch = fs->fs.sweet_reads_input_attachments;
+         sweet_fs_tab[i] = e;
+         /* SWEET_TU_FS_DUMP=N: the ir3 disassembly of each new fragment shader of at least N instructions (1: all),
+          * with its pipeline's vertex shader, into /var/local/tmp/sweet-fs/<pid>-<id>.txt */
+         static const unsigned sweet_fs_dump = debug_get_num_option("SWEET_TU_FS_DUMP", 0);
+         if (sweet_fs_dump && v && v->bin && e.instrs >= sweet_fs_dump) {
+            char path[128];
+            mkdir("/var/local/tmp/sweet-fs", 0755);
+            snprintf(path, sizeof(path), "/var/local/tmp/sweet-fs/%d-%u.txt", (int) getpid(), e.id);
+            FILE *f = fopen(path, "w");
+            if (f) {
+               fprintf(f, "fs #%u: i%u r%u/%u w%u%s c%u t%u fetch %u blake3 %s\n", e.id, e.instrs, e.max_reg, e.max_half,
+                       e.waves, e.dbl ? "x2" : "", e.constlen, e.tex, e.fetch, v->blake3_str);
+               ir3_shader_disasm((struct ir3_shader_variant *) v, v->bin, f);
+               const struct tu_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+               if (vs && vs->variant && vs->variant->bin) {
+                  fprintf(f, "\n---- vertex shader (blake3 %s)\n", vs->variant->blake3_str);
+                  ir3_shader_disasm((struct ir3_shader_variant *) vs->variant, vs->variant->bin, f);
+               }
+               fclose(f);
+            }
+         }
+      }
+      sweet_fs_last = i;
+   }
+   struct sweet_fs_ent *e = &sweet_fs_tab[i];
+   e->draws++;
+   e->px_all += cmd->sweet_px;
+   e->gorder |= cmd->state.sweet_gmem_flush;
+   e->sorder |= cmd->state.pipeline_sysmem_single_prim_mode;
+   cmd->sweet_fs_id = e->id;
+   pthread_mutex_unlock(&sweet_pt_lock);
+}
+
+template <chip CHIP>
+static void
+sweet_ds_after_draw(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   if (sweet_ds_state == 0 || sweet_pt_state != 1 || !cmd->state.pass || cmd->device != sweet_pt_dev)
+      return;
+   pthread_mutex_lock(&sweet_pt_lock);
+   if (sweet_ds_state < 0) {
+      const char *e = getenv("SWEET_TU_DRAWTS");
+      sweet_ds_state = e && *e && strcmp(e, "0") ? 1 : 0;
+      if (sweet_ds_state) {
+         struct tu_bo *bo = NULL;
+         if (tu_bo_init_new(cmd->device, NULL, &bo, SWEET_DS_SLOTS * 8, TU_BO_ALLOC_NO_FLAGS, "sweet draw stamps") ==
+                VK_SUCCESS &&
+             tu_bo_map(cmd->device, bo, NULL) == VK_SUCCESS && bo->map) {
+            memset(bo->map, 0, SWEET_DS_SLOTS * 8);
+            sweet_ds_ts = (volatile uint64_t *) bo->map;
+            sweet_ds_bo = bo;
+         } else {
+            mesa_logw("sweet: draw stamps off (no buffer)");
+            sweet_ds_state = 0;
+         }
+      }
+   }
+   if (sweet_ds_state != 1) {
+      pthread_mutex_unlock(&sweet_pt_lock);
+      return;
+   }
+   const uint32_t slot = sweet_ds_next++ % SWEET_DS_SLOTS;
+   sweet_ds_ts[slot] = 0;
+   sweet_ds_gen = sweet_ds_gen + 1 ? sweet_ds_gen + 1 : 1;
+   sweet_ds_meta[slot] = (struct sweet_ds_meta) { sweet_ds_gen, cmd->sweet_serial, cmd->state.rp.drawcall_count,
+                                                  cmd->sweet_fs_id, cmd->sweet_px };
+   pthread_mutex_unlock(&sweet_pt_lock);
+   const uint64_t iova = sweet_ds_bo->iova + (uint64_t) slot * 8;
+   if (CHIP == A6XX) {
+      tu_cs_emit_pkt7(cs, CP_EVENT_WRITE, 4);
+      tu_cs_emit(cs, CP_EVENT_WRITE_0_EVENT(RB_DONE_TS) | CP_EVENT_WRITE_0_TIMESTAMP);
+      tu_cs_emit_qw(cs, iova);
+      tu_cs_emit(cs, 0x00000000);
+   } else {
+      tu_cs_emit_pkt7(cs, CP_EVENT_WRITE7, 3);
+      tu_cs_emit(cs, CP_EVENT_WRITE7_0(.event = RB_DONE_TS, .write_src = EV_WRITE_ALWAYSON,
+                                       .write_dst = EV_DST_RAM, .write_enabled = true).value);
+      tu_cs_emit_qw(cs, iova);
+   }
+}
+
+/* with sweet_pt_lock held: the GPU time of the passes the last pass report counted, split by the draw stamps in
+ * GPU order: from the pass's begin to its first stamped draw ("first"), from each stamped draw to the next (charged to
+ * the later draw's fragment shader), from the last to the pass's end ("tail"); passes without stamps ("bare") */
+struct sweet_ds_ev { uint64_t t; uint32_t fs, px; };
+static struct sweet_ds_ev sweet_ds_evs[SWEET_DS_SLOTS];
+static uint64_t sweet_split[5];   /* first, draws, tail, bare, all (ticks) */
+static uint32_t sweet_split_passes;
+static int
+sweet_ds_ev_cmp(const void *a, const void *b)
+{
+   const uint64_t x = ((const struct sweet_ds_ev *) a)->t, y = ((const struct sweet_ds_ev *) b)->t;
+   return x < y ? -1 : x > y;
+}
+static int
+sweet_pt_win_cmp(const void *a, const void *b)
+{
+   const uint64_t x = ((const struct sweet_pt_win *) a)->b, y = ((const struct sweet_pt_win *) b)->b;
+   return x < y ? -1 : x > y;
+}
+static void
+sweet_fs_charge(uint32_t fs, uint32_t px, uint64_t t)
+{
+   for (unsigned i = 0; i < sweet_fs_n; i++)
+      if (sweet_fs_tab[i].id == fs) {
+         sweet_fs_tab[i].ticks += t;
+         sweet_fs_tab[i].timed++;
+         sweet_fs_tab[i].px_timed += px;
+         return;
+      }
+}
+static void
+sweet_ds_collect(void)
+{
+   memset(sweet_split, 0, sizeof(sweet_split));
+   sweet_split_passes = 0;
+   if (sweet_ds_state != 1 || !sweet_ds_ts)
+      return;
+   uint32_t n = 0;
+   for (uint32_t s = 0; s < SWEET_DS_SLOTS; s++) {
+      if (!sweet_ds_meta[s].gen || !sweet_ds_ts[s])
+         continue;
+      sweet_ds_evs[n++] = (struct sweet_ds_ev) { sweet_ds_ts[s], sweet_ds_meta[s].fs, sweet_ds_meta[s].px };
+   }
+   qsort(sweet_ds_evs, n, sizeof(sweet_ds_evs[0]), sweet_ds_ev_cmp);
+   qsort(sweet_pt_win, sweet_pt_nwin, sizeof(sweet_pt_win[0]), sweet_pt_win_cmp);
+   uint32_t k = 0;
+   for (uint32_t w = 0; w < sweet_pt_nwin; w++) {
+      const uint64_t b = sweet_pt_win[w].b, e = sweet_pt_win[w].e;
+      while (k < n && sweet_ds_evs[k].t < b)
+         k++;
+      sweet_split[4] += e - b;
+      sweet_split_passes++;
+      uint64_t prev = b;
+      bool any = false;
+      for (; k < n && sweet_ds_evs[k].t <= e; k++) {
+         const uint64_t d = sweet_ds_evs[k].t - prev;
+         sweet_split[any ? 1 : 0] += d;
+         sweet_fs_charge(sweet_ds_evs[k].fs, sweet_ds_evs[k].px, d);
+         prev = sweet_ds_evs[k].t;
+         any = true;
+      }
+      sweet_split[any ? 2 : 3] += e - prev;
+   }
+   /* every stamp read now; stamps of passes reported later are lost (the ring holds about 3 s) */
+   for (uint32_t s = 0; s < SWEET_DS_SLOTS; s++)
+      sweet_ds_meta[s].gen = 0;
+}
+
+/* with sweet_pt_lock held: the window's 10 fragment shaders of most GPU time (SWEET_TU_DRAWTS) or most draws, with
+ * their stats; then every entry starts over. " | fs N shaders D draws: #id T.Tms/n U.Uus i<instrs> r<full>/<half>
+ * w<waves>[x2] c<constlen> t<tex> ss/sy<..> [F fetch][O gmem order][s sysmem order][P pvtmem][Z no early-z][K kill];" */
+static size_t
+sweet_fs_report(char *out, size_t size)
+{
+   sweet_ds_collect();
+   size_t at = 0;
+   uint32_t draws = 0, used = 0;
+   for (unsigned i = 0; i < sweet_fs_n; i++) {
+      draws += sweet_fs_tab[i].draws;
+      used += sweet_fs_tab[i].draws > 0;
+   }
+   at += snprintf(out + at, size > at ? size - at : 0, "fs %u shaders %u draws:", used, draws);
+   if (sweet_ds_state == 1)
+      at += snprintf(out + at, size > at ? size - at : 0, " split %u passes %.1fms = first %.1f + draws %.1f + tail %.1f + bare %.1f;",
+                     sweet_split_passes, sweet_split[4] / 19200.0, sweet_split[0] / 19200.0, sweet_split[1] / 19200.0,
+                     sweet_split[2] / 19200.0, sweet_split[3] / 19200.0);
+   bool shown[SWEET_FS_N] = {};
+   for (unsigned r = 0; r < 10; r++) {
+      int best = -1;
+      for (unsigned i = 0; i < sweet_fs_n; i++) {
+         if (shown[i] || !sweet_fs_tab[i].draws)
+            continue;
+         if (best < 0 || (sweet_ds_state == 1 ? sweet_fs_tab[i].ticks > sweet_fs_tab[best].ticks
+                                              : sweet_fs_tab[i].draws > sweet_fs_tab[best].draws))
+            best = (int) i;
+      }
+      if (best < 0)
+         break;
+      shown[best] = true;
+      const struct sweet_fs_ent *e = &sweet_fs_tab[best];
+      at += snprintf(out + at, size > at ? size - at : 0, " #%u", e->id);
+      if (sweet_ds_state == 1)
+         at += snprintf(out + at, size > at ? size - at : 0, " %.2fms/%u %.1fus", e->ticks / 19200.0, e->timed,
+                        e->timed ? e->ticks / 19.2 / e->timed : 0.0);
+      at += snprintf(out + at, size > at ? size - at : 0, " a%.0fk", e->draws ? e->px_all / 1000.0 / e->draws : 0.0);
+      if (sweet_ds_state == 1 && e->px_timed)
+         at += snprintf(out + at, size > at ? size - at : 0, " %.1fns/px", e->ticks / 19.2e-3 / (double) e->px_timed);
+      at += snprintf(out + at, size > at ? size - at : 0, " d%u i%u r%u/%u w%u%s c%u t%u ss%u sy%u st%u%s%s%s%s%s%s;",
+                     e->draws, e->instrs, e->max_reg, e->max_half, e->waves, e->dbl ? "x2" : "", e->constlen, e->tex,
+                     e->ss, e->sy, e->sstall, e->fetch ? " F" : "", e->gorder ? " O" : "", e->sorder ? " s" : "",
+                     e->pvt ? " P" : "", e->noearlyz ? " Z" : "", e->kill ? " K" : "");
+   }
+   for (unsigned i = 0; i < sweet_fs_n; i++) {
+      sweet_fs_tab[i].draws = 0;
+      sweet_fs_tab[i].timed = 0;
