index a90fefb..379559c 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -54,6 +54,7 @@ bool sweet_gpu_present_poll(void);      /* 0943: a present's blit still out (pol
