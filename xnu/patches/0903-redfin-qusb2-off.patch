From 16c42e170dae71b2408d19cbc58fabeba8d7f9cc Mon Sep 17 00:00:00 2001
From: Rory Axton <roryaxton@gmail.com>
Date: Sat, 24 Oct 2026 01:55:30 +0200
Subject: [PATCH] 0153 redfin: QUSB2 v2 init off (redfin's HS PHY is femto at
 0x88e3000)

---
 bsd/dev/sweet_usb.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 7afa60e..f4054e1 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1340,7 +1340,9 @@ static const struct { uint16_t off; uint8_t val; } qusb2_v2_tbl[] = {
 static int
 ud_qusb2_init(void)
 {
-	int doinit = 1;
+	/* redfin: the primary HS PHY is the femto hsphy@88e3000 (ud_hsphy_init); there is no QUSB2 v2 and
+	 * 0x088e2000 is its eud register. Upstream sunfish 0151 stays off unless sweetqusb=1. */
+	int doinit = 0;
 	PE_parse_boot_argn("sweetqusb", &doinit, sizeof(doinit));
 	if (!doinit) {
 		return 0;
-- 
2.43.0

