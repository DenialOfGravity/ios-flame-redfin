 	if (fFcEdge == 0 || fFcCal) {
@@ -3969,11 +4061,22 @@ AppleCLCD::phaseFrameCount(uint64_t now)
 		fFcMiss = 0;
 		if (fFcEdge != 0 && t - now > period / 2) {
