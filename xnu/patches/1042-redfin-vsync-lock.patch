+			if (d > sweet_vlock_drift_max) {
+				sweet_vlock_drift_max = d;
+			}
+		}
 		if (fFcEdge != 0 && frames >= 1 && frames < 4096) {
 			uint64_t p = (t - fFcEdge) / frames;
 			if (p > fVsyncAbs * 3 / 4 && p < fVsyncAbs * 5 / 4) {
