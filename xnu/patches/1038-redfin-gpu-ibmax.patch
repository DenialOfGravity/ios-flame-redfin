From 7d79cb34adde55f1c3349289db6cfc51e95f2b0b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 17:31:30 +0000
Subject: [PATCH] redfin 1038: kern.sweet_gpu_ibmax, up to 128 IBs per v2
 submit (default 16)

v2 submits carry at most 16 IBs (NativeAdrenoAbiMaxBuffers / A6_SUBMIT_MAX). kern.sweet_gpu_ibmax N (1..128) raises
the limit at run time. ABI-compatible: the record is still NativeAdrenoAbiSubmit; a client sending more than 16
appends the extra NativeAdrenoAbiSubmitBuffer entries after the fixed array (structure input = sizeof + (count - 16)
x 24; 3104 bytes at 128, inline). Old clients (exact sizeof, count <= 16) are unchanged. Ring: one submit is
27 + 4 x N dwords (539 at 128) of 8192; the room check (used + n + 16 < 8192) is unchanged; the packet buffer is
static (the GPU lock is held). Busy is reported against the live limit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013SvAC2ugyLE29nbFLJoQZd
---
 bsd/dev/sweet_a6xx.c                  |  7 +++--
 bsd/dev/sweet_a6xx.h                  |  2 ++
 bsd/dev/sweet_gpu.c                   | 39 +++++++++++++++++++++++++--
 iokit/Kernel/arm/SweetAccelerator.cpp | 32 ++++++++++++++++------
 4 files changed, 68 insertions(+), 12 deletions(-)

diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
index ef93e98..0ff9d55 100644
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -26,6 +26,7 @@ int a6_submit_rbts;
 /* 0999: the GPU interrupt for fence waits (sweet_gpu.c: boot-arg sweetgpuirq, p gpuirq); 0: none, as before */
 uint32_t a6_irq_mask;
 int a6_submit_irq;
+unsigned a6_submit_max = A6_SUBMIT_MAX;	/* 1038 */
 
 #define rd32		a6_rd
 #define wr32		a6_wr
@@ -1303,8 +1304,10 @@ uint32_t a6_submit_ibs_async_wait(struct a6_gpu *g, const uint64_t *iova, const
 	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
 	/* GPU time of this submit: CP_ALWAYS_ON_COUNTER before the IBs and once they are idle (a6_submit_time) */
 	uint64_t ts = a6_pool_va(A6_OFF_SCRATCH + A6_TS_OFF) + 16ull * ((g->fence + 1) % A6_TS_SLOTS);
-	uint32_t dw[7 + 4 + 4 + 4 * A6_SUBMIT_MAX + 5 + 5 + 2], n = 0;	/* 0988: + the longer end stamp; 0989: + the wait */
-	if (nib == 0 || nib > A6_SUBMIT_MAX)
+	/* 0988: + the longer end stamp; 0989: + the wait; 1038: up to A6_SUBMIT_MAX_HW IBs, static (callers hold the GPU lock) */
+	static uint32_t dw[7 + 4 + 4 + 4 * A6_SUBMIT_MAX_HW + 5 + 5 + 2];
+	uint32_t n = 0;
+	if (nib == 0 || nib > a6_submit_max || nib > A6_SUBMIT_MAX_HW)
 		return 0;
 	if (wait_va != 0) {
 		dw[n++] = a6_pkt7(0x3c, 6);		/* CP_WAIT_REG_MEM */
diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
index 030accd..7dba219 100644
--- a/bsd/dev/sweet_a6xx.h
+++ b/bsd/dev/sweet_a6xx.h
@@ -132,6 +132,8 @@ uint32_t a6_submit_ib_async(struct a6_gpu *g, uint64_t iova, uint32_t dwords, un
  * returns the fence, or 0 when the ring has no room within timeout_ms (0 = look once).
  */
 #define A6_SUBMIT_MAX	16
+#define A6_SUBMIT_MAX_HW	128	/* 1038: kern.sweet_gpu_ibmax up to this (ring: 27 + 4 x 128 = 539 of 8192 dwords) */
+extern unsigned a6_submit_max;		/* 1038: IBs one submit may carry (default A6_SUBMIT_MAX) */
 uint32_t a6_submit_ibs_async_wait(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords, unsigned n,
 	unsigned timeout_ms, uint64_t wait_va, uint32_t wait_ref);	/* 0989 */
 #define A6_SCAN_WORD_OFF	0x3000ull	/* 0989: in the scratch page: the direct scanout's latched frame */
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 5106a7c..a006ad9 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -2010,7 +2010,42 @@ sweet_gpu_fence_of(int pid)
 	return 0;
 }
 
-/* Queue up to A6_SUBMIT_MAX IBs: the fence, 0 when the GPU is not usable, or 0 with *busy when the ring is full. */
+/*
+ * 1038: kern.sweet_gpu_ibmax N (1..128, default 16 = A6_SUBMIT_MAX as before): IBs one v2 submit may carry. The v2
+ * record stays NativeAdrenoAbiSubmit; a client sending more than 16 appends the extra NativeAdrenoAbiSubmitBuffer
+ * entries right after the fixed array (structure input = sizeof + (count - 16) x 24 bytes; SweetAccelerator.cpp).
+ * Ring room: one submit is 27 + 4 x N dwords (539 at 128) of the 8192-dword ring; a6_submit_ibs_async_wait waits for
+ * used + n + 16 < 8192 as before. Each IB is one CP_INDIRECT_BUFFER (IB1) in the ring, so N has no CP limit.
+ */
+static int
+sysctl_sweet_gpu_ibmax SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = 0, changed = 0;
+	int error = sysctl_io_number(req, (int)a6_submit_max, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value < 1 || value > A6_SUBMIT_MAX_HW) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);  /* not while a submit builds its packet */
+	a6_submit_max = (unsigned)value;
+	lck_mtx_unlock(&sweet_gpu_lock);
+	printf("SWEET GPU: ibmax %d IBs per v2 submit\n", value);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_gpu_ibmax, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_gpu_ibmax, "I", "SWEET GPU: IBs per v2 submit (1..128, default 16)");
+
+unsigned sweet_gpu_ibmax(void);
+unsigned
+sweet_gpu_ibmax(void)
+{
+	return a6_submit_max;
+}
+
+/* Queue up to kern.sweet_gpu_ibmax IBs: the fence, 0 when the GPU is not usable, or 0 with *busy when the ring is full. */
 uint32_t
 sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy)
 {
@@ -2060,7 +2095,7 @@ sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bo
 		pid_fence[slot].fence = fence;
 	}
 	lck_mtx_unlock(&sweet_gpu_lock);
-	*busy = fence == 0 && n > 0 && n <= A6_SUBMIT_MAX;
+	*busy = fence == 0 && n > 0 && n <= a6_submit_max;     /* 1038 */
 	SWEET_TRACE_END(SWT_GPU_SUBMIT, fence, wait_ref, pid, gpu_ticks);    /* 0994 */
 	return fence;
 }
