+	ud_txbatch = (txb >= 2 && txb <= UD_TXB_MAX && ud_txb_va) ? txb : 0;
+	ud_poll_us = (pollus >= 50 && pollus <= 1000) ? pollus : 0;
+	printf("SWEET USB: fast path: txbatch %d (buffer %s at 0x%llx) poll_us %d\n", ud_txbatch,
+	    ud_txb_va ? "ok" : "none", ud_txb_pa, ud_poll_us);
 	ud_if_create();
