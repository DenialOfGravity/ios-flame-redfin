 static int
 ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
 {
@@ -579,47 +660,103 @@ ud_rx_done(void)
 	ud_rx_arm();
 }
 
+/* Copy one queued frame to fr (2 KiB), with the fix-ups below; frees m. 0 = dropped. */
+static uint32_t
+ud_tx_fill(mbuf_t m, uint8_t *fr)
+{
+	size_t len = mbuf_pkthdr_len(m);
+	if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+		mbuf_freem(m);
+		return 0;
+	}
+	mbuf_copydata(m, 0, len, (void *)fr);
+	mbuf_freem(m);
+	ud_log_frame("tx", fr, (uint32_t)len);
+	/*
+	 * ARP replies go to the Ethernet broadcast address: macOS's ECM
+	 * driver shows the host as 02:00:5e:77:ee:01 (our iMACAddress) on
+	 * the wire, but en17's own lladdr is 02:00:00:00:00:00, and its
+	 * ARP drops replies unicast to ..:01, so 192.168.7.2 never
+	 * resolved (frames carrying IP are accepted either way).
+	 */
+	if (len >= 42 && fr[12] == 0x08 && fr[13] == 0x06 && fr[20] == 0 && fr[21] == 2) {
+		memset(fr, 0xff, ETHER_ADDR_LEN);
+	}
+	/* Pad to the Ethernet minimum (60 bytes without FCS), as a MAC
+	 * would: macOS drops shorter frames, e.g. our 42-byte ARP replies,
+	 * so the Mac never resolved 192.168.7.2. */
+	while (len < 60) {
+		fr[len++] = 0;
+	}
+	/* A frame of a multiple of 512 bytes would need a zero-length
+	 * packet to end it; one pad byte does the same (IP ignores it). */
+	if ((len % 512) == 0) {
+		fr[len++] = 0;
+	}
+	return (uint32_t)len;
+}
+
+/* 1034: up to ud_txbatch queued frames in one bulk IN transfer, one TRB per frame. ud.lock held, TX idle. */
+static void
+ud_tx_kick_batch_locked(unsigned max)
+{
+	volatile uint32_t *t = NULL;
+	unsigned k = 0;
+
+	while (k < max && ud.txq_count > 0) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ_MAX;
+		ud.txq_count--;
+		uint32_t len = ud_tx_fill(m, (uint8_t *)(ud_txb_va + UD_TXB_BUF(k)));
+		if (len == 0) {
+			continue;
+		}
+		flush_dcache64((addr64_t)(ud_txb_pa + UD_TXB_BUF(k)), len, TRUE);
+		uint64_t bpa = ud_txb_pa + UD_TXB_BUF(k);
+		t = (volatile uint32_t *)(ud_txb_va + 16u * k);
+		t[0] = (uint32_t)bpa;
+		t[1] = (uint32_t)(bpa >> 32);
+		t[2] = len;
+		t[3] = TRBCTL_NORMAL | TRB_HWO;         /* no CHN: its own short packet ends each frame */
+		k++;
+	}
+	if (k == 0) {
+		return;
+	}
+	t[3] |= TRB_LST | TRB_ISP_IMI | TRB_IOC;        /* one XferComplete for the batch */
+	flush_dcache64((addr64_t)ud_txb_pa, 16u * k, TRUE);
+	ud.tx_busy = true;
+	ud.tx_frames += k;
+	ud_tx_xfers++;
+	if (ud_epcmd(EP_TX, DEPCMD_STARTTRANSFER, (uint32_t)(ud_txb_pa >> 32), (uint32_t)ud_txb_pa, 0) != 0) {
+		ud.tx_busy = false;     /* no transfer started: no completion will come (ud_epcmd logged it) */
+		ud_tx_drops += k;
+	}
+}
+
 /* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
 static void
 ud_tx_kick_locked(void)
 {
+	unsigned batch = (unsigned)ud_txbatch;
+	if (batch >= 2 && ud_txb_va != 0) {
+		if (!ud.tx_busy && ud.txq_count > 0 && ud.configured) {
+			ud_tx_kick_batch_locked(batch > UD_TXB_MAX ? UD_TXB_MAX : batch);
+		}
+		return;
+	}
 	while (!ud.tx_busy && ud.txq_count > 0 && ud.configured) {
 		mbuf_t m = ud.txq[ud.txq_head];
-		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ_MAX;
 		ud.txq_count--;
-		size_t len = mbuf_pkthdr_len(m);
-		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
-			mbuf_freem(m);
+		uint32_t len = ud_tx_fill(m, (uint8_t *)(ud.dma + UD_TX));
+		if (len == 0) {
 			continue;
 		}
-		mbuf_copydata(m, 0, len, (void *)(ud.dma + UD_TX));
-		mbuf_freem(m);
-		ud_log_frame("tx", (const uint8_t *)(ud.dma + UD_TX), (uint32_t)len);
-		/*
-		 * ARP replies go to the Ethernet broadcast address: macOS's ECM
-		 * driver shows the host as 02:00:5e:77:ee:01 (our iMACAddress) on
-		 * the wire, but en17's own lladdr is 02:00:00:00:00:00, and its
-		 * ARP drops replies unicast to ..:01, so 192.168.7.2 never
-		 * resolved (frames carrying IP are accepted either way).
-		 */
-		uint8_t *fr = (uint8_t *)(ud.dma + UD_TX);
-		if (len >= 42 && fr[12] == 0x08 && fr[13] == 0x06 && fr[20] == 0 && fr[21] == 2) {
-			memset(fr, 0xff, ETHER_ADDR_LEN);
-		}
-		/* Pad to the Ethernet minimum (60 bytes without FCS), as a MAC
-		 * would: macOS drops shorter frames, e.g. our 42-byte ARP replies,
-		 * so the Mac never resolved 192.168.7.2. */
-		while (len < 60) {
-			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
-		}
-		/* A frame of a multiple of 512 bytes would need a zero-length
-		 * packet to end it; one pad byte does the same (IP ignores it). */
-		if ((len % 512) == 0) {
-			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
-		}
 		ud.tx_busy = true;
 		ud.tx_frames++;
-		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+		ud_tx_xfers++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, len, TRBCTL_NORMAL);
 	}
 }
 
@@ -627,14 +764,18 @@ static errno_t
