+/*
+ * redfin 1034: USB Ethernet fast path, off by default. Phone -> PC ran at ~1.2 MB/s: every frame was its own
+ * StartTransfer of one TRB, the next frame waited for that transfer's XferComplete, and the event buffer is
+ * only polled every 1 ms (with timer leeway) by ud_thread, so at most one frame per poll went each way (RX:
+ * one OUT TRB, re-armed per poll; the PC's TCP ACKs came back at the same rate). Two runtime switches:
+ *  - kern.sweet_usb_txbatch N (boot sweetusbtxb=N): 0/1 = as before; 2..16 = up to N queued frames per
+ *    StartTransfer, one TRB each (no CHN, so each ends with its own short packet = one ECM frame, one host
+ *    URB), LST|IOC on the last; buffers in their own contiguous kernel memory (SMMU translation off only),
+ *    TX queue cap 64 instead of 32.
+ *  - kern.sweet_usb_poll_us US (boot sweetusbpollus=US): 0 = 0969's 1 ms / 10 ms polls; 50..1000 = poll
+ *    every US microseconds (no timer coalescing) while TX is in flight or within 5 ms of an event; the 10 s status
+ *    line and 0969's quiet count keep counting milliseconds.
+ * Counters: kern.sweet_usb_tx_frames, _tx_xfers (frames/xfers > 1 = batching), _tx_drops (queue full), _rx_frames.
+ */
+#define UD_TXB_MAX      16
+#define UD_TXB_BUF(i)   (0x800u + 0x800u * (i))     /* TRBs at 0, 2 KiB per frame after them */
+#define UD_TXB_SIZE     UD_TXB_BUF(UD_TXB_MAX)
+static vm_offset_t ud_txb_va;
+static uint64_t ud_txb_pa;
+static int ud_txbatch;          /* 0/1 = one frame per transfer */
+static int ud_poll_us;          /* 0 = 0969 polling */
+static uint64_t ud_tx_xfers, ud_tx_drops;
+
+static int
+sysctl_sweet_usb_txbatch SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = 0, changed = 0;
+	int error = sysctl_io_number(req, ud_txbatch, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value < 0 || value > UD_TXB_MAX) {
+		return EINVAL;
+	}
+	if (value >= 2 && ud_txb_va == 0) {
+		return ENODEV;
+	}
+	ud_txbatch = value;     /* taken at the next idle TX kick */
+	printf("SWEET USB: txbatch %d\n", value);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_usb_txbatch, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_usb_txbatch, "I", "SWEET USB: frames per bulk IN transfer (0/1 one, 2..16)");
+
+static int
+sysctl_sweet_usb_poll_us SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = 0, changed = 0;
+	int error = sysctl_io_number(req, ud_poll_us, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value != 0 && (value < 50 || value > 1000)) {
+		return EINVAL;
+	}
+	ud_poll_us = value;
+	printf("SWEET USB: poll_us %d\n", value);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_usb_poll_us, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_usb_poll_us, "I", "SWEET USB: event poll interval while busy, us (0 = 1 ms/10 ms)");
+SYSCTL_QUAD(_kern, OID_AUTO, sweet_usb_tx_frames, CTLFLAG_RD | CTLFLAG_LOCKED, &ud.tx_frames, "");
+SYSCTL_QUAD(_kern, OID_AUTO, sweet_usb_rx_frames, CTLFLAG_RD | CTLFLAG_LOCKED, &ud.rx_frames, "");
+SYSCTL_QUAD(_kern, OID_AUTO, sweet_usb_tx_xfers, CTLFLAG_RD | CTLFLAG_LOCKED, &ud_tx_xfers, "");
+SYSCTL_QUAD(_kern, OID_AUTO, sweet_usb_tx_drops, CTLFLAG_RD | CTLFLAG_LOCKED, &ud_tx_drops, "");
+
+static void
+ud_sleep_us_crit(unsigned us)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(us, NSEC_PER_USEC, &deadline);
+	if (assert_wait_deadline_with_leeway(&ud.sleep_chan, THREAD_UNINT, TIMEOUT_URGENCY_SYS_CRITICAL,
+	    deadline, 0) == THREAD_WAITING) {
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
