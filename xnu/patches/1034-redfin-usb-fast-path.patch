+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) == KERN_SUCCESS) {
+			ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+			if (pn) {
+				ud_txb_pa = ptoa_64(pn);
+				ud_txb_va = va;
+			}
