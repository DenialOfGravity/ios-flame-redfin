+static bool
+sweet_mdp_scale(void)
+{
+	if (!sweet_mdp_pattern(SWEET_FB_LOGICAL_W, SWEET_FB_LOGICAL_H, SWEET_MDP_SURF_STRIDE, SWEET_FB_LOGICAL_W / 2 + 1)) {
