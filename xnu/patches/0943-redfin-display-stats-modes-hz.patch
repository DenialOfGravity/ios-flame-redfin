+static void
+sweet_fb_set_number(OSDictionary *d, const char *key, uint64_t v)
+{
+	OSNumber *n = OSNumber::withNumber(v, 32);
+	if (n != NULL) {
+		d->setObject(key, n);
+		n->release();
+	}
+}
