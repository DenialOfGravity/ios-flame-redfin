diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 99a62073f..cd7cc4c65 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1829,7 +1829,8 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
- * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ * for a framebuffer alias that survives bootstrap TTBR0 teardown. Device-GRE
+ * like start.s: the 32MB block reaches into pil_slpi_region on flame.
  */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
@@ -1845,7 +1846,7 @@ sweet_early_map_final(void)
 	assert(*slot == ARM_TTE_EMPTY);
 	*slot = (tt_entry_t)SWEET_EARLY_FB_BLOCK_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_POSTED_COMBINED_REORDERED) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index bfbc10387..145bb8b30 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -680,14 +680,17 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * Splash framebuffer: one 32MB Device-GRE block in the EXISTING V=P
 	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
 	 * create_bootstrap_mapping would replace the RAM L2 table.
+	 * Device, not Normal-NC: on flame the block also covers the end of
+	 * pil_slpi_region (0x9ab00000-0x9c300000), an XPU-protected carve-out,
+	 * and Normal memory may be read speculatively. Device memory never is.
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
 	MOV64	x10, SWEET_EARLY_FB_BLOCK_PA
-	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_POSTED_COMBINED_REORDERED) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index c3ab94f7b..d3d8f8033 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,7 +1,8 @@
 /*
  * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
  * per-CPU state: panic() can reach this before a current thread exists.
- * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
+ * start.s maps the splash framebuffer VA=PA as Device-GRE memory (aligned
+ * 32-bit stores only).
  * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
  * retain this console until the normal framebuffer serial console is ready.
  */
