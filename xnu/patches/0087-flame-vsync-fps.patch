 void
 AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 {
 	AppleCLCD *fb = (AppleCLCD *)owner;
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
+	/*
+	 * Fixed-rate ticks: re-arm from the previous deadline before any work.
+	 * Re-arming 16.7 ms after the panel copy made "60 Hz" vsync run at
+	 * ~40 Hz with jitter, and backboardd paces its frames on it.
+	 */
+	if (fb->fVsyncAbs == 0) {
+		nanoseconds_to_absolutetime(SWEET_FB_VSYNC_US * 1000ULL, &fb->fVsyncAbs);
+		fb->fNextVsync = now;
+	}
+	fb->fNextVsync += fb->fVsyncAbs;
+	if (fb->fNextVsync <= now) {
+		fb->fNextVsync = now + fb->fVsyncAbs;
+	}
+	sender->wakeAtTime(fb->fNextVsync);
+	if ((count % 300) == 0) {
+		/* Every 5 s: frames backboardd swapped, frames copied to the panel. */
+		uint64_t swaps = sweet_fb_swap_count - fb->fStatSwaps, ns = 0;
+		absolutetime_to_nanoseconds(fb->fStatPresentAbs, &ns);
+		if (swaps || fb->fStatPresents) {
+			IOLog("SWEET FB: 5s: %llu swaps (%llu.%llu fps), %llu panel copies, avg copy %llu us\n",
+			    swaps, swaps / 5, (swaps * 2) % 10, fb->fStatPresents,
+			    fb->fStatPresents ? ns / 1000 / fb->fStatPresents : 0);
+		}
+		fb->fStatSwaps = sweet_fb_swap_count;
+		fb->fStatPresents = 0;
+		fb->fStatPresentAbs = 0;
+	}
 	uint64_t values[6] = {
 		(uint32_t)count, (uint32_t)(count >> 32),
 		(uint32_t)now, (uint32_t)(now >> 32),
