 				}
 			}
 		}
-		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
 		return;
 	}
 	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
@@ -253,10 +284,12 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
