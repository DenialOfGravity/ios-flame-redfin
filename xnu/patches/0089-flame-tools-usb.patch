diff --git a/bsd/dev/sweet_poke.c b/bsd/dev/sweet_poke.c
new file mode 100644
index 000000000..2465222c9
--- /dev/null
+++ b/bsd/dev/sweet_poke.c
@@ -0,0 +1,242 @@
+/*
+ * Register poke scripts: hardware experiments without a kernel rebuild.
+ * tools/mkpayload.py --poke FILE puts FILE in the ADT as /chosen/sweet-poke;
+ * a kernel thread runs it line by line and logs every step ("POKE:").
+ *
+ *   @SECS                  wait until SECS seconds after the timer started
+ *   r ADDR [N]             read N (default 1) 32-bit words
+ *   w ADDR VAL             write
+ *   m ADDR MASK VAL        read-modify-write: (old & ~MASK) | (VAL & MASK)
+ *   p ADDR MASK VAL MS     poll until (read & MASK) == VAL, at most MS ms
+ *   s MS                   sleep
+ *   # ...                  comment
+ *
+ * Numbers are hex with 0x, else decimal. Addresses are physical; each 4K
+ * page is mapped once (device memory). A read of an unclocked block hangs
+ * the SoC: the RAM log rescue (shim/ramlog.c) keeps the lines up to it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <mach/mach_time.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_poke_start(void);
+void sweet_poke_run(const char *text, unsigned len);
+
+#define POKE_MAPS       32
+#define POKE_TICKS_S    19200000ULL     /* flame timer */
+
+static struct {
+	uint64_t page;
+	vm_offset_t va;
+} poke_map[POKE_MAPS];
+static const char *poke_script;
+static unsigned poke_len;
+
+static volatile uint32_t *
+poke_reg(uint64_t pa)
+{
+	uint64_t page = pa & ~0xfffULL;
+	for (unsigned i = 0; i < POKE_MAPS; i++) {
+		if (poke_map[i].va && poke_map[i].page == page) {
+			return (volatile uint32_t *)(poke_map[i].va + (pa & 0xfff));
+		}
+	}
+	for (unsigned i = 0; i < POKE_MAPS; i++) {
+		if (!poke_map[i].va) {
+			poke_map[i].va = ml_io_map((vm_offset_t)page, 0x1000);
+			poke_map[i].page = page;
+			return poke_map[i].va ? (volatile uint32_t *)(poke_map[i].va + (pa & 0xfff)) : NULL;
+		}
+	}
+	return NULL;
+}
+
+static uint32_t
+poke_rd(volatile uint32_t *r)
+{
+	uint32_t v = *r;
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+poke_wr(volatile uint32_t *r, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*r = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+poke_sleep_ms(unsigned ms)
+{
+	delay((int)ms * 1000);
+}
+
+/* Parse one number; returns false at end of line. */
+static bool
+poke_num(const char **p, const char *end, uint64_t *out)
+{
+	const char *s = *p;
+	while (s < end && (*s == ' ' || *s == '\t')) {
+		s++;
+	}
+	if (s >= end || *s == '\n' || *s == '#') {
+		*p = s;
+		return false;
+	}
+	uint64_t v = 0;
+	unsigned base = 10;
+	if (s + 1 < end && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+		base = 16;
+		s += 2;
+	}
+	const char *d0 = s;
+	for (; s < end; s++) {
+		unsigned c = (unsigned char)*s, digit;
+		if (c >= '0' && c <= '9') {
+			digit = c - '0';
+		} else if (base == 16 && c >= 'a' && c <= 'f') {
+			digit = c - 'a' + 10;
+		} else if (base == 16 && c >= 'A' && c <= 'F') {
+			digit = c - 'A' + 10;
+		} else if (c == '_') {
+			continue;
+		} else {
+			break;
+		}
+		v = v * base + digit;
+	}
+	*p = s;
+	*out = v;
+	return s > d0;
+}
+
+static void
+poke_line(const char *s, const char *end, unsigned lineno)
+{
+	while (s < end && (*s == ' ' || *s == '\t')) {
+		s++;
+	}
+	if (s >= end || *s == '#' || *s == '\n') {
+		return;
+	}
+	char op = *s++;
+	uint64_t a = 0, b = 0, c = 0, d = 0;
+	bool ha = poke_num(&s, end, &a), hb = poke_num(&s, end, &b);
+	bool hc = poke_num(&s, end, &c), hd = poke_num(&s, end, &d);
+	volatile uint32_t *r = NULL;
+	if (op != '@' && op != 's') {
+		if (!ha || (a & 3) || !(r = poke_reg(a))) {
+			printf("POKE: line %u: bad address\n", lineno);
+			return;
+		}
+	}
+	switch (op) {
+	case '@': {
+		uint64_t target = a * POKE_TICKS_S;
+		while (mach_absolute_time() < target) {
+			poke_sleep_ms(10);
+		}
+		printf("POKE: @%llu s\n", a);
+		break;
+	}
+	case 's':
+		poke_sleep_ms((unsigned)a);
+		break;
+	case 'r': {
+		uint64_t n = hb ? b : 1;
+		for (uint64_t i = 0; i < n && i < 256; i += 4) {
+			char line[96];
+			int len = snprintf(line, sizeof(line), "POKE: r %09llx:", a + 4 * i);
+			for (uint64_t j = i; j < n && j < i + 4; j++) {
+				volatile uint32_t *rj = poke_reg(a + 4 * j);
+				len += snprintf(line + len, sizeof(line) - len, " %08x", rj ? poke_rd(rj) : 0xdeadbeef);
+			}
+			printf("%s\n", line);
+		}
+		break;
+	}
+	case 'w':
+		poke_wr(r, (uint32_t)b);
+		printf("POKE: w %09llx = %08llx -> %08x\n", a, b, poke_rd(r));
+		break;
+	case 'm': {
+		uint32_t old = poke_rd(r);
+		poke_wr(r, (old & ~(uint32_t)b) | ((uint32_t)c & (uint32_t)b));
+		printf("POKE: m %09llx %08x -> %08x\n", a, old, poke_rd(r));
+		break;
+	}
+	case 'p': {
+		uint64_t ms = hd ? d : 100, t;
+		uint32_t v = 0;
+		for (t = 0; t <= ms; t++) {
+			v = poke_rd(r);
+			if ((v & (uint32_t)b) == (uint32_t)c) {
+				break;
+			}
+			poke_sleep_ms(1);
+		}
+		printf("POKE: p %09llx & %08llx == %08llx: %s after %llu ms (%08x)\n", a, b, c,
+		    t <= ms ? "ok" : "TIMEOUT", t, v);
+		break;
+	}
+	default:
+		printf("POKE: line %u: unknown op '%c'\n", lineno, op);
+	}
+	(void)hc;
+}
+
+/* Run script text in the calling thread (also used by the USB command server). */
+void
+sweet_poke_run(const char *text, unsigned len)
+{
+	const char *s = text, *end = text + len;
+	unsigned lineno = 1;
+	while (s < end && *s) {
+		const char *e = s;
+		while (e < end && *e && *e != '\n') {
+			e++;
+		}
+		poke_line(s, e, lineno++);
+		s = e < end && *e == '\n' ? e + 1 : e;
+	}
+}
+
+static void
+poke_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	printf("POKE: running %u-byte script\n", poke_len);
+	sweet_poke_run(poke_script, poke_len);
+	printf("POKE: done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_poke_start(void)
+{
+	DTEntry chosen;
+	void const *script;
+	unsigned size;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-poke", &script, &size) != kSuccess || size < 2) {
+		return;
+	}
+	poke_script = (const char *)script;
+	poke_len = size;
+	thread_t thread;
+	if (kernel_thread_start(poke_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6cefbe88b..ac07c2fba 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -689,8 +689,80 @@ static uint64_t _Atomic sweet_log_total;
 static int sweet_log_chan;
 static uint32_t sweet_log_secs = SWEET_LOG_SECS;
 
-/* Called for all console output, any context: never blocks. */
+/*
+ * Uncached mirror of the ring for crash rescue (shim/ramlog.c): DRAM keeps
+ * its contents across the warm reset into fastboot, but the cached ring
+ * itself loses whatever was still dirty in the CPU caches. From
+ * sweet_log_mirror_start() on (once ml_io_map works), every byte also goes
+ * to a write-combining mirror at the top of RAM, above XNU's range:
+ *   +0      "SWEETMIR" | u64 total | u32 ring size
+ *   +0x1000 ring bytes (offset of byte n = n % ring size)
+ * The next shim boot copies its tail to UFS (tools/flame-log-pull.sh rescue).
+ */
+#define SWEET_MIRROR_PA         0x1fa000000ULL
+struct sweet_mirror_header {
+	char magic[8];
+	uint64_t total;
+	uint32_t size;
+};
+static volatile struct sweet_mirror_header *sweet_mirror_hdr;
+static volatile char *sweet_mirror_ring;
+
+static void
+sweet_log_put(const char *c, int size)
+{
+	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+	}
+	if (sweet_mirror_ring) {
+		for (int i = 0; i < size; i++) {
+			sweet_mirror_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+		}
+		uint64_t end = at + (uint64_t)size;
+		if (end > sweet_mirror_hdr->total) {
+			sweet_mirror_hdr->total = end;
+		}
+	}
+}
+
+void sweet_log_mirror_start(void);
+
+void
+sweet_log_mirror_start(void)
+{
+	extern vm_offset_t ml_io_map_wcomb(vm_offset_t, vm_size_t);
+	vm_offset_t m = ml_io_map_wcomb((vm_offset_t)SWEET_MIRROR_PA, 0x1000 + SWEET_LOG_SIZE);
+	if (!m) {
+		return;
+	}
+	volatile struct sweet_mirror_header *h = (volatile struct sweet_mirror_header *)m;
+	volatile char *r = (volatile char *)(m + 0x1000);
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	for (uint64_t i = total > SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0; i < total; i++) {
+		r[i % SWEET_LOG_SIZE] = sweet_log_ring[i % SWEET_LOG_SIZE];
+	}
+	h->total = total;
+	h->size = SWEET_LOG_SIZE;
+	const char *magic = "SWEETMIR";
+	for (int i = 0; i < 8; i++) {
+		h->magic[i] = magic[i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	sweet_mirror_hdr = h;
+	sweet_mirror_ring = r;
+	printf("SWEET LOG: uncached mirror at 0x%llx for crash rescue\n", SWEET_MIRROR_PA);
+}
+
+/*
+ * Called for all console output, any context: never blocks. Each line in
+ * the ring (not on screen) starts with "[sss.mmm] ", seconds since the
+ * timer started (flame: 19.2 MHz). No boot-arg: this runs from the first
+ * console byte, before boot-args can be read.
+ * Concurrent writers can interleave mid-line, as on the console itself.
+ */
 void sweet_log_append(const char *c, int size);
+static bool sweet_log_sol = true;
 
 void
 sweet_log_append(const char *c, int size)
@@ -698,9 +770,25 @@ sweet_log_append(const char *c, int size)
 	if (size <= 0) {
 		return;
 	}
-	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
+	int start = 0;
 	for (int i = 0; i < size; i++) {
-		sweet_log_ring[(at + (uint64_t)i) % SWEET_LOG_SIZE] = c[i];
+		if (sweet_log_sol) {
+			if (i > start) {
+				sweet_log_put(c + start, i - start);
+			}
+			char ts[24];
+			uint64_t ms = mach_absolute_time() / 19200;
+			int n = snprintf(ts, sizeof(ts), "[%4llu.%03llu] ", ms / 1000, ms % 1000);
+			sweet_log_put(ts, n);
+			start = i;
+			sweet_log_sol = false;
+		}
+		if (c[i] == '\n') {
+			sweet_log_sol = true;
+		}
+	}
+	if (size > start) {
+		sweet_log_put(c + start, size - start);
 	}
 }
 
