 iokit/Kernel/IOUserClient.cpp   |  36 ++++++
 iokit/Kernel/arm/SweetBTNub.cpp | 232 ++++ ++++++++++++++++++++++++++++
 iokit/conf/files.arm64          |   1 +
 4 files changed, 254 insertions(+)
