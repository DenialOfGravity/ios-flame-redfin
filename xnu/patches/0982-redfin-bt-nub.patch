diff --git a/iokit/Kernel/arm/SweetBTNub.cpp b/iokit/Kernel/arm/SweetBTNub.cpp
new file mode 100644
index 0000000..ac2e7d8
--- /dev/null
+++ b/iokit/Kernel/arm/SweetBTNub.cpp
@@ -0,0 +1,133 @@
+/*
+ * redfin 0982: stand-in Bluetooth nubs for the B2 probe. The r-probe boot showed bluetoothd registering
+ * IOKit notifications for IONameMatch "marconi-bt" and IONameMatch "bluetooth" (on an iPhone these are
+ * device-tree nubs, e.g. a "bluetooth" child of the BT UART under /arm-io) and doing nothing else until
+ * one appears. Boot-arg sweetbtnub (default 0: nothing) publishes, under the platform expert:
+ *   1 = a service named "bluetooth", 2 = one named "marconi-bt", 3 = both.
+ * The properties are deliberately few (a marker, device_type, local-mac-address): every property a process
+ * reads from these nubs is logged with found/MISSING (IOUserClient.cpp sweet_btnub_read), so the next boot
+ * says which keys bluetoothd wants. A user client is refused (logged with its type); setProperties is
+ * logged key by key and accepted. Log lines "SWEET BTNUB:".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSCollectionIterator.h>
+
+extern "C" {
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+void SweetBTNubStart(void);
+bool SweetBTNubIs(const void *entry);
+}
+
+class SweetBTNub : public IOService
+{
+	OSDeclareDefaultStructors(SweetBTNub);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetBTNub, IOService);
+
+static SweetBTNub * sweet_btnubs[2];
+static unsigned sweet_btnub_lines;
+
+static void
+who(char * name, int len)
+{
+	proc_selfname(name, len);
+}
+
+IOReturn
+SweetBTNub::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+    IOUserClient ** handler)
+{
+	char p[32];
+	who(p, sizeof(p));
+	if (sweet_btnub_lines++ < 500) {
+		IOLog("SWEET BTNUB: %s asks %s for a user client of type %u%s: refused\n", p, getName(), (unsigned) type,
+		    properties ? " (with properties)" : "");
+	}
+	return kIOReturnUnsupported;
+}
+
+IOReturn
+SweetBTNub::setProperties(OSObject * properties)
+{
+	char p[32];
+	who(p, sizeof(p));
+	OSDictionary * d = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator * it = d ? OSCollectionIterator::withCollection(d) : NULL;
+	OSSymbol * k;
+	while (it && (k = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		if (sweet_btnub_lines++ < 500) {
+			IOLog("SWEET BTNUB: %s sets %s.%s\n", p, getName(), k->getCStringNoCopy());
+		}
+	}
+	OSSafeReleaseNULL(it);
+	return kIOReturnSuccess;
+}
+
+bool
+SweetBTNubIs(const void * entry)
+{
+	return entry != NULL && (entry == sweet_btnubs[0] || entry == sweet_btnubs[1]);
+}
+
+static SweetBTNub *
+publish(IOService * platform, const char * name)
+{
+	SweetBTNub * nub = OSTypeAlloc(SweetBTNub);
+	if (nub == NULL || !nub->init()) {
+		OSSafeReleaseNULL(nub);
+		return NULL;
+	}
+	static const uint8_t mac[6] = { 0x02, 0x50, 0x49, 0x58, 0x45, 0x4d };   /* tools/mkadt.py mac-address-bluetooth0 */
+	OSData * d = OSData::withBytes(mac, sizeof(mac));
+	if (d) {
+		nub->setProperty("local-mac-address", d);
+		d->release();
+	}
+	nub->setProperty("device_type", "bluetooth");
+	nub->setProperty("SweetBTNub", true);
+	if (!nub->attach(platform)) {
+		nub->release();
+		return NULL;
+	}
+	nub->setName(name);
+	if (!nub->start(platform)) {
+		nub->detach(platform);
+		nub->release();
+		return NULL;
+	}
+	nub->registerService();
+	IOLog("SWEET BTNUB: published \"%s\" under %s\n", name, platform->getName());
+	return nub;
+}
+
+void
+SweetBTNubStart(void)
+{
+	uint32_t which = 0;
+	PE_parse_boot_argn("sweetbtnub", &which, sizeof(which));
+	IOService * platform = IOService::getPlatform();
+	if (!which || platform == NULL || sweet_btnubs[0] || sweet_btnubs[1]) {
+		return;
+	}
+	if (which & 1) {
+		sweet_btnubs[0] = publish(platform, "bluetooth");
+	}
+	if (which & 2) {
+		sweet_btnubs[1] = publish(platform, "marconi-bt");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/conf/files.arm64 b/iokit/conf/files.arm64
index 898752d..b2871d5 100644
--- a/iokit/conf/files.arm64
+++ b/iokit/conf/files.arm64
@@ -19,6 +19,7 @@ iokit/Kernel/arm/SweetBattery.cpp                                optional iokitc
