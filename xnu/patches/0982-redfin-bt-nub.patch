From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WS-B <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 01:48:52 +0100
Subject: [PATCH] 0982 redfin: stand-in Bluetooth nubs for the probe
 (sweetbtnub=1|2|3)

The sweetbtlog boot showed bluetoothd waiting on IOKit notifications for
IONameMatch "marconi-bt" and "bluetooth" (device-tree nubs on an iPhone)
and doing nothing else. New iokit/Kernel/arm/SweetBTNub.cpp publishes,
under the platform expert, a SweetBTNub service named "bluetooth"
(sweetbtnub=1), "marconi-bt" (=2) or both (=3), with only a marker,
device_type and local-mac-address. IOUserClient.cpp logs every property
read from them (get, bytes, bin, recursive, all) with found/MISSING, the
nub logs user-client requests (refused, with the type) and setProperties
keys, so the next boot shows what bluetoothd wants next. "SWEET BTNUB:"
lines, at most 500 each. Default off: nothing published. Called from
sweet_geniuart_init (0981).
---
 bsd/dev/sweet_geniuart.c        |   3 +
 iokit/Kernel/IOUserClient.cpp   |  36 +++++++++
 iokit/Kernel/arm/SweetBTNub.cpp | 133 ++++++++++++++++++++++++++++++++
 iokit/conf/files.arm64          |   1 +
 4 files changed, 173 insertions(+)
 create mode 100644 iokit/Kernel/arm/SweetBTNub.cpp

diff --git a/bsd/dev/sweet_geniuart.c b/bsd/dev/sweet_geniuart.c
index 6c1bb88..d37e021 100644
--- a/bsd/dev/sweet_geniuart.c
+++ b/bsd/dev/sweet_geniuart.c
@@ -878,9 +878,12 @@ sweet_geniuart_cmd(unsigned what)
 	return e ? e : (int)total;
 }
 
+extern void SweetBTNubStart(void);
+
 void
 sweet_geniuart_init(void)
 {
+	SweetBTNubStart();      /* 0982: stand-in "bluetooth" / "marconi-bt" nubs (sweetbtnub=1|2|3) */
 	uint32_t on = 0;
 	PE_parse_boot_argn("btuart", &on, sizeof(on));
 	if (!on) {
diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
index 56c0ad5..5911cb0 100644
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -2660,6 +2660,27 @@ sweet_iolog_dict(const char *name, const char *what, OSObject *dict, const char
 }
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* redfin 0982: every property read from the sweetbtnub stand-in nubs (iokit/Kernel/arm/SweetBTNub.cpp) */
+extern "C" bool SweetBTNubIs(const void *entry);
+static uint32_t sweet_btnub_reads;
+
+static void
+sweet_btnub_read(IORegistryEntry *entry, const char *key, const char *how)
+{
+	if (!SweetBTNubIs(entry) || sweet_btnub_reads >= 500) {
+		return;
+	}
+	sweet_btnub_reads++;
+	char pname[32];
+	proc_selfname(pname, (int)sizeof(pname));
+	OSObject *v = key ? entry->copyProperty(key) : NULL;
+	IOLog("SWEET BTNUB: %s reads %s.%s (%s) -> %s\n", pname, entry->getName(), key ? key : "*", how,
+	    key ? (v ? "found" : "MISSING") : "all");
+	OSSafeReleaseNULL(v);
+}
+#endif
+
 kern_return_t
 internal_io_service_get_matching_services(
 	mach_port_t main_port,
@@ -3656,6 +3677,9 @@ is_io_registry_entry_get_property_bytes(
 	IOReturn            ret = kIOReturnSuccess;
 
 	CHECK( IORegistryEntry, registry_entry, entry );
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_btnub_read(entry, property_name, "bytes");
+#endif
 
 #if CONFIG_MACF
 	if (0 != mac_iokit_check_get_property(kauth_cred_get(), entry, property_name)) {
@@ -3724,6 +3748,9 @@ is_io_registry_entry_get_property(
 	OSObject *          obj;
 
 	CHECK( IORegistryEntry, registry_entry, entry );
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_btnub_read(entry, property_name, "get");
+#endif
 
 #if CONFIG_MACF
 	if (0 != mac_iokit_check_get_property(kauth_cred_get(), entry, property_name)) {
@@ -3771,6 +3798,9 @@ is_io_registry_entry_get_property_recursively(
 	OSObject *          obj;
 
 	CHECK( IORegistryEntry, registry_entry, entry );
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_btnub_read(entry, property_name, "recursive");
+#endif
 
 #if CONFIG_MACF
 	if (0 != mac_iokit_check_get_property(kauth_cred_get(), entry, property_name)) {
@@ -3864,6 +3894,9 @@ is_io_registry_entry_get_properties_bin_buf(
 	void                 * editRef = NULL;
 
 	CHECK(IORegistryEntry, registry_entry, entry);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_btnub_read(entry, NULL, "all");
+#endif
 
 #if CONFIG_MACF
 	GetPropertiesEditorRef ref;
@@ -3961,6 +3994,9 @@ is_io_registry_entry_get_property_bin_buf(
 	const OSSymbol *    sym;
 
 	CHECK( IORegistryEntry, registry_entry, entry );
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_btnub_read(entry, property_name, "bin");
+#endif
 
 #if CONFIG_MACF
