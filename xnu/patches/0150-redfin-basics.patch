diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index ddf0614..2cb21a5 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -1,7 +1,8 @@
 /*
  * Minimal polled SWEET keys. Call once after the scheduler is running.
  * flame: power (KPDPWR) and volume down (RESIN) on the PM8150 PON block,
- * volume up: sunfish PM6150L GPIO2 (SID 4, 0xc100, active low; was Pixel 4 PM8150 GPIO6).
+ * volume up: redfin PM8150L GPIO5 (SID 4, 0xc400, active low; sunfish PM6150L GPIO2 0xc100,
+ * Pixel 4 PM8150 GPIO6). The shim sets its pull-up (shim.c redfin_pmic_gpios).
  * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
  * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
  */
@@ -23,7 +24,7 @@ void sweet_keys_init(void);
 #define KEYS_CNFG_PA     0x0c40a000u
 #define KEYS_PON_RT      0x0810u
 #define KEYS_GPIO_SID    4u
-#define KEYS_GPIO_BASE   0xc100u
+#define KEYS_GPIO_BASE   0xc400u
 #define KEYS_GPIO_RT     (KEYS_GPIO_BASE + 0x10u)
 #define KEYS_NO_APID     0xffffu
 
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 6a121c5..5cb96be 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -5,6 +5,7 @@
  * Init is serialized by the single built-in SweetBattery personality.
  * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
  * Also the PM8150 RTC (peripheral 0x60) for the time of day (SweetPlatformExpert.cpp).
+ * redfin: the battery blocks are on PM7250B (SID 2), the RTC stays on SID 0.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -89,9 +90,11 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
 	/* Restrict access to the battery blocks and the RTC (0x60); keys retain their own lanes. */
 	unsigned peripheral = addr >> 8;
-	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
-	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48 && peripheral != 0x60)) {
+	/* redfin: battery blocks on PM7250B (SID 2), RTC on PM8150 (SID 0). */
+	bool batt = sid == 2 && (peripheral == 0x10 || peripheral == 0x11 ||
+	    peripheral == 0x12 || peripheral == 0x13 || peripheral == 0x48);
+	bool rtc = sid == 0 && peripheral == 0x60;
+	if (!sp_ready || !out || addr > 0xffffu || !(batt || rtc)) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 45d75f8..cd9a014 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1255,7 +1255,9 @@ ud_smmu_setup(uint64_t dma_pa)
  * as Linux qcom_snps_hsphy_init (phy-qcom-snps-femto-v2.c) minus the
  * regulators and the GCC block reset.
  */
-#define HSPHY_PA        0x088e2000
+/* redfin (lito): the primary port's femto PHY is hsphy@88e3000; 0x088e2000 is the
+ * EUD enable register there, never written. */
+#define HSPHY_PA        0x088e3000
 #define HP_UTMI_CTRL0   0x3c
 #define HP_UTMI_CTRL5   0x50
 #define HP_COMMON0      0x54
@@ -1311,7 +1313,9 @@ ud_hsphy_init(void)
 	hp_rmw(p, HP_UTMI_CTRL5, 1u << 1, 0);           /* POR release */
 	hp_rmw(p, HP_CTRL2, 1u << 3, 0);
 	hp_rmw(p, HP_CFG0, 1u << 1, 0);
-	hp_rmw(p, 0x70, 0xff, 0x43);                    /* DT qcom,param-override-seq: 0x43 @ X1 */
+	/* redfin DT qcom,param-override-seq <0xC7 0x6C 0xCC 0x70> (lito-redfin-usb.dtsi) */
+	hp_rmw(p, 0x6c, 0xff, 0xc7);
+	hp_rmw(p, 0x70, 0xff, 0xcc);
 	delay(1000);
 	ud_hsphy_dump(p, "after init");
 }
