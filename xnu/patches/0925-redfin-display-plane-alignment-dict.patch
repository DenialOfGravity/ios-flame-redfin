From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rory Axton <roryaxton@gmail.com>
Date: Sun, 25 Oct 2026 00:40:00 +0200
Subject: [PATCH] 0925 redfin: DisplayPipePlaneBaseAlignment as a dictionary

AppleCLCD published DisplayPipePlaneBaseAlignment as the number 64 (0046).
On an iPhone it is a dictionary, and VideoToolbox's
FigGetAlignmentForIOSurfaceOutputToDisplayService (called by CMCapture when
Camera.app's preview starts) takes CFDictionaryGetValue(property,
"PlaneBaseAlignmentLinear") of it: mediaserverd died with
"-[__NSCFNumber objectForKey:]: unrecognized selector" every time the
capture session started (r18d, after 0924 let the session start).
Now { PlaneBaseAlignmentLinear = 64 }.

---
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -507,7 +507,19 @@
 
 	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
 	setProperty("external", false);
-	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+	/*
+	 * 0925: a dictionary, as on an iPhone's AppleCLCD. VideoToolbox's FigGetAlignmentForIOSurfaceOutputToDisplayService
+	 * takes CFDictionaryGetValue(property, "PlaneBaseAlignmentLinear"): on a number mediaserverd died
+	 * ("-[__NSCFNumber objectForKey:]: unrecognized selector") whenever Camera.app's preview started.
+	 */
+	OSDictionary *align = OSDictionary::withCapacity(1);
+	OSNumber *linear = OSNumber::withNumber(64ULL, 32);
+	if (align != NULL && linear != NULL) {
+		align->setObject("PlaneBaseAlignmentLinear", linear);
+		setProperty("DisplayPipePlaneBaseAlignment", align);
+	}
+	OSSafeReleaseNULL(linear);
+	OSSafeReleaseNULL(align);
 	if (blStart()) {
 		uint32_t blOn = 0;
 		PE_parse_boot_argn("sweetbl", &blOn, sizeof(blOn));
-- 
