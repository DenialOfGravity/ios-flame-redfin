 }
 
 static int
@@ -1773,6 +1775,28 @@ sysctl_sweet_vsync_lock SYSCTL_HANDLER_ARGS
 SYSCTL_PROC(_kern, OID_AUTO, sweet_vsync_lock, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
     0, 0, sysctl_sweet_vsync_lock, "I", "SWEET FB: vsync ticks + IOMFBDisplayRefresh on the measured panel period (0995 mask 7)");
 
+/*
+ * 1048: kern.sweet_surf_inuse 0|1|2|3 (boot-arg sweetsurfinuse sets the start value; default 0 = 0983 exactly):
+ * which IOSurfaces publish their use count at state page +0x18 (what IOSurfaceIsInUse reads). 1 = every surface,
+ * counting userland's use counts, the display's holds and the GPU jobs that may still read it; 2 = 1 + 5 s klog
+ * line "SWEET SURF INUSE: 5s: ..."; 3 = 2 without the GPU holds. SweetSurface.cpp sweet_surface_inuse_set.
+ */
+extern int sweet_surface_inuse_mode(void);
+extern int sweet_surface_inuse_set(int mode);
+static int
+sysctl_sweet_surf_inuse SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = 0, changed = 0;
+	int error = sysctl_io_number(req, sweet_surface_inuse_mode(), sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	return sweet_surface_inuse_set(value);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_surf_inuse, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_surf_inuse, "I", "SWEET SURF: IOSurface use counts published (0 slots, 1 all + GPU, 2 +log, 3 no GPU)");
+
 /* ---- buffers and submissions for Metal (iokit/Kernel/arm/SweetAccelerator.cpp) ---- */
 
 #define USER_VA_BASE    0x200000000ULL  /* above the surface slots */
diff --git a/iokit/Kernel/arm/SweetAccelerator.cpp b/iokit/Kernel/arm/SweetAccelerator.cpp
index d487193..ba428d7 100644
--- a/iokit/Kernel/arm/SweetAccelerator.cpp
+++ b/iokit/Kernel/arm/SweetAccelerator.cpp
@@ -86,6 +86,9 @@ struct SweetV2BO {
 	uint64_t iova;                  /* GPU address while mapped, else 0 */
 	uint64_t pool_pa;               /* allocated: its memory in the GPU pool (sweet_gpu_pool_alloc) */
 	bool imported;                  /* the client's own pages (no CPU-map token) */
+	bool surfChecked;               /* 1048: looked up among the IOSurfaces (kern.sweet_surf_inuse != 0) */
+	uint32_t surfId;                /* 1048: the IOSurface whose byte 0 the import starts at (0: none) ... */
+	uint64_t surfPA;                /* ... and that byte's physical address (ids are reused: checked at each hold) */
 };
 
 class IOAcceleratorES : public IOService {
@@ -169,6 +172,7 @@ class SweetAcceleratorUserClient : public IOUserClient {
 	SweetV2BO *v2Find(uint64_t handle);
 	IOReturn v2NewSlot(IOMemoryDescriptor *md, uint64_t bytes, bool imported, uint64_t *handle);
 	void v2Release(SweetV2BO *bo);
+	void v2HoldSurfaces(uint32_t fence);    /* 1048 */
 	/* 0156: freed pool buffers >= 1 MB kept for this client's next allocation of the same size (no new pool
 	 * range, no 10 MB bzero per CoreAnimation intermediate); never shared across clients */
 	struct { IOMemoryDescriptor *md; uint64_t pa, len; } fReuse[16];
@@ -696,6 +700,46 @@ SweetAcceleratorUserClient::v2Release(SweetV2BO *bo)
 	bzero(bo, sizeof(*bo));
 }
 
+/*
+ * 1048 (kern.sweet_surf_inuse 1/2): the ABI's submits name only their IBs, not the buffers the job reads, so every
+ * IOSurface this client has imported and mapped into the GPU counts as used by the job until its fence lands
+ * (SweetSurface.cpp sweet_surface_gpu_hold: IOSurfaceIsInUse true meanwhile). Imports are matched to surfaces by the
+ * physical address of their first byte, once per import.
+ */
+void
+SweetAcceleratorUserClient::v2HoldSurfaces(uint32_t fence)
+{
+	uint32_t ids[64];
+	uint64_t pas[64];
+	uint32_t n = 0;
+	IOLockLock(fLock);
+	for (uint32_t i = 0; i < fBOCap; i++) {
+		SweetV2BO *bo = &fBO[i];
+		if (bo->md == NULL || !bo->imported || bo->iova == 0) {
+			continue;
+		}
+		if (!bo->surfChecked) {
+			bo->surfChecked = true;
+			IOByteCount seg = 0;
+			bo->surfPA = bo->md->getPhysicalSegment(0, &seg, kIOMemoryMapperNone);
+			bo->surfId = sweet_surface_find_pa(bo->surfPA);
+			sweet_surface_import_stat(bo->surfId != 0);
+		}
+		if (bo->surfId != 0) {
+			ids[n] = bo->surfId;
+			pas[n++] = bo->surfPA;
+			if (n == sizeof(ids) / sizeof(ids[0])) {
+				sweet_surface_gpu_hold(ids, pas, n, fence);
+				n = 0;
+			}
+		}
+	}
+	if (n != 0) {
+		sweet_surface_gpu_hold(ids, pas, n, fence);
+	}
+	IOLockUnlock(fLock);
+}
+
 IOReturn
 SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t inSize, void *out, uint32_t *outSize)
 {
@@ -999,6 +1043,9 @@ SweetAcceleratorUserClient::v2Method(uint32_t method, const void *in, uint32_t i
 		}
 		fLastFence = fence;
 		rp->fence = fence;
+		if (sweet_surface_inuse_mode() != 0) {
+			v2HoldSurfaces(fence);  /* 1048 */
+		}
 		if (fSystem && fName[0] == 'b') {
 			sweet_swaptrace('S', fence);    /* 0987: SweetFramebuffer.cpp (p swapdone trace) */
 		}
