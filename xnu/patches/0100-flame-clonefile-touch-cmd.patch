+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (error == ENOTSUP && v_type == VREG) {
+		error = sweet_clonefile_copy(fvp, tdvp, &tvp, cnp, &nva, ctx);
+	}
+#endif
 
