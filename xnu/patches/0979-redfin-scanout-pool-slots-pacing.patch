 	if (sweet_surface_scan_mode() == 1) {
 		sweet_scan_set(this, true, "boot-arg sweetscanout=1");  /* 0976 */
 	}
@@ -1579,7 +1580,7 @@ sweet_mdp_smmu(bool walk)
