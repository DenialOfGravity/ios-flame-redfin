@@ -2091,6 +2121,7 @@ sweet_scan_swap(AppleCLCD *fb, const uint8_t *rec, uint64_t now, uint32_t fence)
 		OSSafeReleaseNULL(s);
 		IOLockLock(fb->fLock);
