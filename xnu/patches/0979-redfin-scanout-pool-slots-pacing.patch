+			return false;
+		}
+		pa = 0;
+		if (sweet_gpu_pool_alloc(SWEET_SCAN_SLOT_LEN, &pa) != 0 || pa == 0 || pa + SWEET_SCAN_SLOT_LEN > (1ULL << 32)) {
+			IOLog("SWEET SURF: scanout slot %u: no %#llx bytes in the GPU pool below 4 GB (%#llx): no more RAM slots\n", n,
