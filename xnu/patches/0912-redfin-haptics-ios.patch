From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rory Axton <roryaxton@gmail.com>
Date: Sat, 24 Oct 2026 14:06:52 +0200
Subject: [PATCH] 0912 redfin: haptics for iOS (kern.sweet_haptic, sweetui, sweetenv)

sysctl kern.sweet_haptic (any user; write ms | strength << 16) queues a
pulse for the haptic driver's thread, which now stays up as a worker.
Boot-arg sweetui=1 inserts /var/local/lib/SweetHaptics.dylib
(phone/haptics) into SpringBoard and apps when the file exists. The
dylib maps UIKit feedback generators and the system vibrate sound onto
the sysctl. sweetenv=NAME:VAR=VAL[,..][;NAME:..] from sailfish 0104/0163.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GizUhEzkc6MoTcLnCZCfFa
---
  bsd/kern/kern_exec.c | 136 +++++++++++++++++++++++++++++++++++++++++++
  bsd/dev/sweet_haptic.c | 60 ++++++++++++++++++++++++++++++++++++++++++

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 68612db..afcb353 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -445,6 +445,135 @@ exec_add_user_string(struct image_params *imgp, user_addr_t str, int seg, boolea
 	return error;
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Append the kernel string var to the environment being built (exec_extract_strings). */
+static int
+sweet_exec_add_env(struct image_params *imgp, const char *var, int ptr_size)
+{
+	int error = exec_add_user_string(imgp, CAST_USER_ADDR_T(var), UIO_SYSSPACE, TRUE);
+	if (error) {
+		return error;
+	}
+	if (imgp->ip_argspace < ptr_size) {
+		return E2BIG;
+	}
+	imgp->ip_argspace -= ptr_size;
+	imgp->ip_envc++;
+	return 0;
+}
+
+/* Is there already an environment string starting with prefix? */
+static bool
+sweet_exec_has_env(struct image_params *imgp, const char *prefix)
+{
+	size_t n = strlen(prefix);
+	for (const char *e = imgp->ip_endargv; e < imgp->ip_strendp; e += strlen(e) + 1) {
+		if (strncmp(e, prefix, n) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * 0912 (after sailfish 0104/0163): boot-arg sweetenv=NAME:VAR=VAL[,VAR=VAL...][;NAME:...]
+ * appends VAR=VAL to the environment of every executable whose file name is NAME, e.g.
+ * sweetenv=backboardd:CA_DISABLE_BACKDROP_CACHE=1 (CoreAnimation knobs without editing
+ * launchd plists on the phone).
+ *
+ * Boot-arg sweetui=1: UI processes (SpringBoard and apps under /Applications and the app
+ * containers) get DYLD_INSERT_LIBRARIES=SWEET_UI_DYLIB when that file exists and they have
+ * no DYLD_INSERT_LIBRARIES of their own (dyld takes the last one, and stops the process if
+ * an inserted library is missing). AMFI's dyld policy (0114) honours it except for
+ * restricted and FairPlay-encrypted (App Store) executables. The library maps UIKit's
+ * haptic feedback onto the vibration motor (phone/haptics, kern.sweet_haptic).
+ */
+#define SWEET_UI_DYLIB  "/var/local/lib/SweetHaptics.dylib"
+
+static int
+sweet_exec_env(struct image_params *imgp, int ptr_size)
+{
+	static char spec[256];
+	static int state;       /* 0 not parsed, 1 none, 2 set */
+	static int ui = -1;
+	const char *path = imgp->ip_strings + strlen("executable_path="), *base = path;
+	for (const char *c = path; *c; c++) {
+		if (*c == '/') {
+			base = c + 1;
+		}
+	}
+	if (ui < 0) {
+		int v = 0;
+		(void)PE_parse_boot_argn("sweetui", &v, sizeof(v));
+		ui = v;
+	}
+	if (ui && (strncmp(path, "/Applications/", 14) == 0 ||
+	    strncmp(path, "/System/Library/CoreServices/SpringBoard.app/", 45) == 0 ||
+	    strncmp(path, "/private/var/containers/Bundle/Application/", 43) == 0 ||
+	    strncmp(path, "/var/containers/Bundle/Application/", 35) == 0) &&
+	    !sweet_exec_has_env(imgp, "DYLD_INSERT_LIBRARIES=")) {
+		vnode_t vp = NULLVP;
+		if (vnode_lookup(SWEET_UI_DYLIB, 0, &vp, vfs_context_kernel()) == 0) {
+			vnode_put(vp);
+			int error = sweet_exec_add_env(imgp, "DYLD_INSERT_LIBRARIES=" SWEET_UI_DYLIB, ptr_size);
+			if (error) {
+				return error;
+			}
+			static unsigned logged;
+			if (logged++ < 8) {
+				printf("SWEET ENV: %s += haptics\n", base);
+			}
+		}
+	}
+
+	if (state == 0) {
+		state = PE_parse_boot_argn("sweetenv", spec, sizeof(spec)) && spec[0] ? 2 : 1;
+	}
+	if (state != 2) {
+		return 0;
+	}
+	const char *entry = spec;
+	for (;;) {
+		size_t n = 0;
+		while (entry[n] && entry[n] != ':' && entry[n] != ';') {
+			n++;
+		}
+		if (entry[n] == ':' && strlen(base) == n && strncmp(base, entry, n) == 0) {
+			break;
+		}
+		while (*entry && *entry != ';') {
+			entry++;
+		}
+		if (*entry == '\0') {
+			return 0;
+		}
+		entry++;
+	}
+	const char *p = strchr(entry, ':') + 1;
+	while (*p && *p != ';') {
+		char var[128];
+		size_t len = 0;
+		while (p[len] && p[len] != ',' && p[len] != ';') {
+			len++;
+		}
+		if (len > 0 && len < sizeof(var)) {
+			memcpy(var, p, len);
+			var[len] = '\0';
+			int error = sweet_exec_add_env(imgp, var, ptr_size);
+			if (error) {
+				return error;
+			}
+			printf("SWEET ENV: %s += %s\n", base, var);
+		}
+		p += len;
+		if (*p == ',') {
+			p++;
+		}
+	}
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 /*
  * dyld is now passed the executable path as a getenv-like variable
  * in the same fashion as the stack_guard and malloc_entropy keys.
@@ -5741,6 +5870,13 @@ exec_extract_strings(struct image_params *imgp)
 		imgp->ip_envc++;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	error = sweet_exec_env(imgp, new_ptr_size);
+	if (error) {
+		goto bad;
+	}
+#endif
+
 	/* Save space for envv[] NULL terminator */
 	if (imgp->ip_argspace < new_ptr_size) {
 		error = E2BIG;
diff --git a/bsd/dev/sweet_haptic.c b/bsd/dev/sweet_haptic.c
index 089256f..5ebe2a5 100644
--- a/bsd/dev/sweet_haptic.c
+++ b/bsd/dev/sweet_haptic.c
@@ -12,6 +12,12 @@
  * (strength 1..127, open-loop RTP level) is the kernel API; the poke/command line
  * "v MS [STRENGTH]" calls it (tools/flame-cmd.py 'v 200').
  *
+ * 0912: for iOS, sysctl kern.sweet_haptic (write-only, any user) queues one pulse for the
+ * driver's thread, which stays up after bring-up and plays requests in order, newest
+ * winning: value = ms | strength << 16 (ms 1..2000, strength 1..127; 0 = defaults). The
+ * caller never waits on I2C. SweetHaptics.dylib (phone/haptics) maps UIKit's feedback
+ * generators and AudioServicesPlaySystemSound(kSystemSoundID_Vibrate) onto it.
+ *
  * Writes outside the SE and the motor: GCC branch votes and the SE9 RCG (XO), the two TLMM
  * pin configs, and three PM7250B GPIO1 registers (output high = motor enabled).
  */
@@ -19,6 +25,7 @@
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/errno.h>
+#include <sys/sysctl.h>
 #include <kern/clock.h>
 #include <kern/thread.h>
 #include <kern/locks.h>
@@ -32,6 +39,7 @@ extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
 void sweet_haptic_init(void);
 int sweet_haptic_buzz(unsigned ms, unsigned strength);
+int sweet_haptic_request(unsigned ms, unsigned strength);
 
 #define HAP_SE_PA       0x0098c000u
 #define HAP_GCC_PA      0x00100000u
@@ -110,6 +118,9 @@ static struct {
 static LCK_GRP_DECLARE(sweet_haptic_grp, "sweet_haptic");
 static LCK_MTX_DECLARE(sweet_haptic_lock, &sweet_haptic_grp);
 static int hap_sleep_chan;
+static int hap_req_chan;
+static volatile uint32_t hap_req;       /* pending pulse: ms | strength << 16; 0 = none */
+static volatile uint32_t hap_reqs;
 
 static uint32_t
 hap_rd(vm_offset_t base, uint32_t off)
@@ -530,11 +541,60 @@ hap_thread(void *arg __unused, wait_result_t wr __unused)
 			(void)sweet_haptic_buzz(80, 127);
 		}
 	}
+	/* 0912: the request worker (kern.sweet_haptic). */
+	while (hp.ready && !hp.dead) {
+		uint64_t deadline;
+		clock_interval_to_deadline(60000, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&hap_req_chan, THREAD_UNINT, deadline);
+		if (hap_req != 0) {
+			clear_wait(current_thread(), THREAD_AWAKENED);
+		} else {
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		uint32_t req = __atomic_exchange_n(&hap_req, 0, __ATOMIC_ACQ_REL);
+		if (req) {
+			(void)sweet_haptic_buzz(req & 0xffffu, (req >> 16) & 0xffu);
+		}
+	}
 out:
 	(void)thread_terminate(current_thread());
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/* Queue a pulse for the driver's thread (any context that may take a wakeup); newest wins. */
+int
+sweet_haptic_request(unsigned ms, unsigned strength)
+{
+	if (!hp.ready || hp.dead) {
+		return ENXIO;
+	}
+	if (ms == 0 || ms > 2000) {
+		ms = 60;
+	}
+	if (strength == 0 || strength > 127) {
+		strength = 127;
+	}
+	__atomic_store_n(&hap_req, ms | (strength << 16), __ATOMIC_RELEASE);
+	hap_reqs++;
+	thread_wakeup(&hap_req_chan);
+	return 0;
+}
+
+static int
+sysctl_sweet_haptic SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = 0;
+	int changed = 0;
+	int error = sysctl_io_number(req, (int)hap_reqs, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	return sweet_haptic_request((unsigned)value & 0xffffu, ((unsigned)value >> 16) & 0xffu);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_haptic, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_haptic, "I", "SWEET vibration: write ms | strength << 16");
+
 void
 sweet_haptic_init(void)
 {
