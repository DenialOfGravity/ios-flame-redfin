+
+vm_tag_t
+IOMemoryTag(vm_map_t map)
+{
+	vm_tag_t tag;
+
+	if (!vm_kernel_map_is_kernel(map)) {
+		return VM_MEMORY_IOKIT;
+	}
+
+	tag = vm_tag_bt();
+	if (tag == VM_KERN_MEMORY_NONE) {
+		tag = VM_KERN_MEMORY_IOKIT;
+	}
+
+	return tag;
+}
