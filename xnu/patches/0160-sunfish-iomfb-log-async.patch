+void
+testData()
+{
+#define DATA_SIZE_1      256
+#define DATA_SIZE_2      512
+#define DATA_SIZE_3     1024
+#define DATA_SIZE_4     8192
+
+	OSData *test1, *test2, *test3;
+	void *spaceCheck;
+	unsigned int len;
