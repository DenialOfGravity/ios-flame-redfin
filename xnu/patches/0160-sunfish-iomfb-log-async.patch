+	uint32_t new_value;
+
+	if (NULL == gRootDomain) {
+		return ENOENT;
+	}
+	error = sysctl_io_number(req, gRootDomain->_aotMode, sizeof(uint32_t), &new_value, &changed);
+	if (changed && gIOPMWorkLoop) {
+		error = update_aotmode(new_value);
+	}
+
+	return error;
+}
