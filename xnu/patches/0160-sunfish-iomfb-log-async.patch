+static inline BOOL
+isupper(char c)
+{
+	return c >= 'A' && c <= 'Z';
+}
+
+static inline BOOL
+isalpha(char c)
+{
+	return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
+}
+
+
