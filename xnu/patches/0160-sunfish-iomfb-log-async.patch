+#else /* !__LP64__ */
+OSMetaClassDefineReservedUsedX86(IOBufferMemoryDescriptor, 0);
+OSMetaClassDefineReservedUsedX86(IOBufferMemoryDescriptor, 1);
+#endif /* !__LP64__ */
