+IOPMrootDomain::sleepWakeDebugSpinDumpMemAlloc()
+{
+#if UNUSED
+	vm_size_t    size = SWD_SPINDUMP_SIZE;
+
+	swd_hdr      *hdr = NULL;
+
+	OSSharedPtr<IOBufferMemoryDescriptor>  memDesc;
+
+	if (!OSCompareAndSwap(0, 1, &gRootDomain->swd_lock)) {
