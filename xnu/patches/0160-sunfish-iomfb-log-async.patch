+void
+IOService::cancelIdlePowerDown( IOService * service )
+{
+	IOPMRequest * request;
+
+	request = acquirePMRequest(service, kIOPMRequestTypeIdleCancel);
+	if (request) {
+		submitPMRequest(request);
+	}
