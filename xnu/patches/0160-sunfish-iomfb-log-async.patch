diff --git a/iokit/DriverKit/IOWorkGroup.iig b/iokit/DriverKit/IOWorkGroup.iig
new file mode 100644
index 0000000..29c98a3
--- /dev/null
+++ b/iokit/DriverKit/IOWorkGroup.iig
@@ -0,0 +1,144 @@
+/*
