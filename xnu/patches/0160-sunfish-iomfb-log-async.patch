+/* Logging */
+
+#define LOG_LEVEL 0
+
+#define LOG(level, format, ...) \
+do { \
+	if (level <= LOG_LEVEL) \
+	        printf(format, ##__VA_ARGS__); \
+} while (0)
+
+/* Locks */
