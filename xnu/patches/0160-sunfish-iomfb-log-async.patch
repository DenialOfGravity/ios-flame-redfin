+IOUserIterator *
+IOUserIterator::withIterator(OSIterator * iter)
+{
+	IOUserIterator * me;
+
+	if (!iter) {
+		return NULL;
+	}
+
+	me = new IOUserIterator;
+	if (me && !me->init()) {
+		me->release();
+		me = NULL;
