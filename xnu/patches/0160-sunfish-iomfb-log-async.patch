+bool
+IOPanicPlatform::start(IOService * provider)
+{
+	const char * platform_name = "(unknown platform name)";
+
+	if (provider) {
+		platform_name = provider->getName();
+	}
+
+	panic("Unable to find driver for this platform: \"%s\".",
+	    platform_name);
+
+	return false;
+}
