+bool
+IORegistryEntry::setProperty( const char *      aKey,
+    void *            bytes,
+    unsigned int      length)
+{
+	bool ret = false;
+	OSData * data = OSData::withBytes( bytes, length );
+
+	if (data) {
+		const OSSymbol * tmpKey = OSSymbol::withCString( aKey );
+		ret = setProperty( tmpKey, data );
+
+		tmpKey->release();
+		data->release();
+	}
+	return ret;
+}
