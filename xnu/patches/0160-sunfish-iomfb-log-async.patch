+IONVRAMCHRPHandler::~IONVRAMCHRPHandler()
+{
+}
+
+bool
+IONVRAMCHRPHandler::isValidImage(const uint8_t *image, IOByteCount length)
+{
+	return validateNVRAMVersion(image, length, nullptr) != kNVRAMVersionUnknown;
+}
