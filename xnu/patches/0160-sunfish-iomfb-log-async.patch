+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+vm_size_t
+log2up(vm_size_t size)
+{
+	if (size <= 1) {
+		size = 0;
+	} else {
+#if __LP64__
+		size = 64 - __builtin_clzl(size - 1);
+#else
+		size = 32 - __builtin_clzl(size - 1);
+#endif
+	}
+	return size;
+}
