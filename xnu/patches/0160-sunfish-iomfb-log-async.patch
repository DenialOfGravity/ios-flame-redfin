+//*********************************************************************************
+// [private] restartIdleTimer
+//*********************************************************************************
+
+void
+IOService::restartIdleTimer( void )
+{
+	if (fDeviceDesire != kPowerStateZero) {
+		fIdleTimerStopped = false;
+		fActivityTickleCount = 0;
+		start_PM_idle_timer();
+	} else if (fHasAdvisoryDesire) {
+		fIdleTimerStopped = false;
+		start_PM_idle_timer();
+	} else {
+		fIdleTimerStopped = true;
+	}
+}
