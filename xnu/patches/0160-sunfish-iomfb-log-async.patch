+	return acc;
+}
+
+
+/*
+ * Convert a string to an unsigned quad integer.
+ *
+ * Ignores `locale' stuff.  Assumes that the upper and lower case
+ * alphabets and digits are each contiguous.
+ */
+u_quad_t
+strtouq(const char *nptr,
+    char **endptr,
+    int base)
+{
+	const char *s = nptr;
+	u_quad_t acc;
+	char c;
+	u_quad_t qbase, cutoff;
+	int neg, any, cutlim;
+
+	/*
