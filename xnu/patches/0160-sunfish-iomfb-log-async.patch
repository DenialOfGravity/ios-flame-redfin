+	sd->enqueue(&data, sizeof(UInt64));
+	/* dequeue moves head to end */
+	sd->dequeue(&data, &size);
+	/* Tail wraps around, head is still at end */
+	sd->enqueue(&data2, sizeof(UInt32));
+	/* something in the queue so peek() should return non-null */
+	assert(sd->peek() != NULL);
+	return KERN_SUCCESS;
+}
