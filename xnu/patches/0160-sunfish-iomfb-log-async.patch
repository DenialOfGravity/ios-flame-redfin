+IORegistryEntry::getParentSetReference(
+	const IORegistryPlane * plane ) const
+{
+	if (plane) {
+		return (OSArray *) registryTable()->getObject(
+			plane->keys[kParentSetIndex]);
+	} else {
+		return NULL;
+	}
+}
