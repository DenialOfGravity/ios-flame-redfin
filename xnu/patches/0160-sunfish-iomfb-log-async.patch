+OSDictionary *
+IOUserClient::copyClientEntitlements(task_t task)
+{
+	proc_t p = NULL;
+	pid_t pid = 0;
+	OSDictionary *entitlements = NULL;
+
+	p = (proc_t)get_bsdtask_info(task);
+	if (p == NULL) {
+		return NULL;
+	}
+	pid = proc_pid(p);
+
+	if (cs_entitlements_dictionary_copy(p, (void **)&entitlements) == 0) {
+		if (entitlements) {
+			return entitlements;
+		}
+	}
+
+	// If the above fails, thats it
+	return NULL;
+}
