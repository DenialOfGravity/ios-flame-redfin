+/* Helper to add a location matching dict to the table */
+
+OSDictionary *
+IOService::addLocation( OSDictionary * table )
+{
+	OSDictionary *      dict;
+
+	if (!table) {
+		return NULL;
+	}
+
+	dict = OSDictionary::withCapacity( 1 );
+	if (dict) {
+		bool ok = table->setObject( gIOLocationMatchKey, dict );
+		dict->release();
+		if (!ok) {
+			dict = NULL;
+		}
+	}
+
+	return dict;
+}
