+++ b/iokit/IOKit/IOStatisticsPrivate.h
@@ -0,0 +1,388 @@
+/*
+ * Copyright (c) 2010 Apple Computer, Inc. All rights reserved.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ *
