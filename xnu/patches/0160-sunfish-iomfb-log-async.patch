+     */
+	virtual kern_return_t
+	SetDispatchQueue(
+		const IODispatchQueueName name,
+		IODispatchQueue         * queue) override LOCAL;
+
+    /*!
+     * @brief       Obtain the IODispatchQueue for a given name on the IOService.
