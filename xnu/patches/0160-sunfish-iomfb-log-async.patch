+		TEST_ASSERT('d', "2b", !test1->getLength());
+		TEST_ASSERT('d', "2c", !test1->getBytesNoCopy());
+		TEST_ASSERT('d', "2d", test1->appendBytes(testData, DATA_SIZE_1));
