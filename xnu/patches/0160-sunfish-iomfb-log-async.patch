+bool
+IORegistryEntry::compareName( OSString * name, OSSharedPtr<OSString>& matched ) const
+{
+	OSString* matchedRaw = NULL;
+	bool result = compareName(name, &matchedRaw);
+	matched.reset(matchedRaw, OSNoRetain);
+	return result;
+}
