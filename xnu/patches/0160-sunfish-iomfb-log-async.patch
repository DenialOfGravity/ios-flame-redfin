+bool
+IOService::syncNotificationHandler(
+	void * /* target */, void * ref,
+	IOService * newService,
+	IONotifier * notifier )
+{
+	LOCKWRITENOTIFY();
+	if (!*((IOService **) ref)) {
+		newService->retain();
+		(*(IOService **) ref) = newService;
+		WAKEUPNOTIFY(ref);
+	}
+	UNLOCKNOTIFY();
+
+	return false;
