+static void
+IOPMRootDomainWillShutdown(void)
+{
+	if (OSCompareAndSwap(0, 1, &gWillShutdown)) {
+		IOService::willShutdown();
+		for (int i = 0; i < 100; i++) {
+			if (OSCompareAndSwap(0, 1, &gSleepOrShutdownPending)) {
+				break;
+			}
+			IOSleep( 100 );
+		}
+	}
+}
