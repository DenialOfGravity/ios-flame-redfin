+kern_return_t
+internal_io_service_get_matching_services(
+	mach_port_t main_port,
+	const char * matching,
+	mach_msg_type_number_t matching_size,
+	io_iterator_t *existing )
+{
+	kern_return_t       kr;
+	OSObject *          obj;
+	OSDictionary *      dict;
+
+	if (main_port != main_device_port) {
+		return kIOReturnNotPrivileged;
+	}
+
+	assert(matching_size);
+	obj = OSUnserializeXML(matching, matching_size);
+
+	if ((dict = OSDynamicCast( OSDictionary, obj))) {
+		IOTaskRegistryCompatibilityMatching(current_task(), dict);
+		OSIterator *found = IOService::getMatchingServices( dict );
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		char sname[32];
+		if (sweet_iolog(sname, sizeof(sname))) {
+			unsigned int count = 0;
+			if (found != NULL) {
+				while (found->getNextObject() != NULL) {
+					count++;
+				}
+				found->reset();
+			}
+			char res[16];
+			snprintf(res, sizeof(res), "%u found", count);
+			sweet_iolog_dict(sname, "matching", dict, res);
+		}
+#endif
+		*existing = IOUserIterator::withIterator(found);
+		kr = kIOReturnSuccess;
+	} else {
+		kr = kIOReturnBadArgument;
+	}
+
+	if (obj) {
+		obj->release();
+	}
+
+	return kr;
+}
