+
+		IOAddressRange ranges[3][2] =
+		{
+			{
+				{ (uintptr_t) &IOMemoryDescriptorTest, 0x2ffc },
+				{ 0, 0 },
+			},
+			{
+				{ ranges[0][0].address, 0x10 },
+				{ 0x3000 + ranges[0][0].address, 0xff0 },
