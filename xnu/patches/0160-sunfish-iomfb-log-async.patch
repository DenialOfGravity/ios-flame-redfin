+			entry = (IODataQueueEntry *)((uintptr_t)dataQueue->queue + tail);
+
+			callback(&entry->data, callerDataSize);
+
+			entry->size = callerDataSize;
+
+			newTail = tail + entrySize;
+		} else {
+			retVal = kIOReturnOverrun; // queue is full
+		}
+	}
