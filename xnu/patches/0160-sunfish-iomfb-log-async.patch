+bool
+IORegistryEntry::compareNames( OSObject * names, OSSharedPtr<OSString>& matched ) const
+{
+	OSString* matchedRaw = NULL;
+	bool result = compareNames(names, &matchedRaw);
+	matched.reset(matchedRaw, OSNoRetain);
+	return result;
+}
