+		}
+	}
+	if (any < 0) {
+		acc = UQUAD_MAX;
+//		errno = ERANGE;
+	} else if (neg) {
+		acc = -acc;
+	}
+	if (endptr != 0) {
+		if (any) {
+			*endptr = __CAST_AWAY_QUALIFIER(s - 1, const, char *);
+		} else {
+			*endptr = __CAST_AWAY_QUALIFIER(nptr, const, char *);
+		}
+	}
+
