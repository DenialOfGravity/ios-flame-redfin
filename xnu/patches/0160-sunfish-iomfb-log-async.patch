+
+enum{
+	kInternalFlagPhysical      = 0x00000001,
+	kInternalFlagPageSized     = 0x00000002,
+	kInternalFlagPageAllocated = 0x00000004,
+	kInternalFlagInit          = 0x00000008,
+	kInternalFlagHasPointers   = 0x00000010,
+	kInternalFlagGuardPages    = 0x00000020,
+};
