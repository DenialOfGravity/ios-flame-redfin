+void
+IOUserIterator::reset()
+{
+	IOLockLock(&lock);
+	assert(OSDynamicCast(OSIterator, userIteratorObject));
+	((OSIterator *)userIteratorObject)->reset();
+	IOLockUnlock(&lock);
+}
