+TestIOConnectMapMemoryPortLeak45265408UserClient::clientMemoryForType(UInt32 type, IOOptionBits *flags, IOMemoryDescriptor **memory)
+{
+	*memory = this->sharedMemory;
+	this->sharedMemory->retain();
+	return kIOReturnSuccess;
+}
