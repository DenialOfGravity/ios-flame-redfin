+#if defined(__i386__) || defined(__x86_64__) || defined(__arm64__)
+
+static void
+uart_putstring(const char *str)
+{
+	while (*str) {
+		hib_uart_putc(*str++);
+	}
+}
+
+static void
+uart_putdec(uint64_t num)
+{
+	bool leading = true;
+	for (uint64_t pos = 10000000000000000000ull; pos != 0; pos /= 10) {
+		char c = (char) (num / pos);
+		if (c) {
+			leading = false;
+			num -= c * pos;
+		} else if (leading && (pos != 1)) {
+			continue;
+		}
+		hib_uart_putc(c + '0');
+	}
+}
+
+static void
+uart_puthex(uint64_t num)
+{
+	int bit;
+	char c;
+	bool leading = true;
+
+	for (bit = 60; bit >= 0; bit -= 4) {
+		c = 0xf & (num >> bit);
+		if (c) {
+			leading = false;
+		} else if (leading && bit) {
+			continue;
+		}
+		if (c <= 9) {
+			c += '0';
+		} else {
+			c += 'a' - 10;
+		}
+		hib_uart_putc(c);
+	}
+}
+
+static void
+debug_code(uint32_t code, uint64_t value)
+{
+	int bit;
+	char c;
+
+	if (!(kIOHibernateDebugRestoreLogs & gIOHibernateDebugFlags)) {
+		return;
+	}
+
+	for (bit = 24; bit >= 0; bit -= 8) {
+		c = 0xFF & (code >> bit);
+		if (c) {
+			hib_uart_putc(c);
+		}
+	}
+	hib_uart_putc('=');
+	uart_puthex(value);
+	hib_uart_putc('\n');
+	hib_uart_putc('\r');
+}
+
+#endif /* defined(__i386__) || defined(__x86_64__) || defined(__arm64__) */
