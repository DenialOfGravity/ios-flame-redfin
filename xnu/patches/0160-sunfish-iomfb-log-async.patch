+bool
+IOUserIterator::isValid()
+{
+	bool ret;
+
+	IOLockLock(&lock);
+	assert(OSDynamicCast(OSIterator, userIteratorObject));
+	ret = ((OSIterator *)userIteratorObject)->isValid();
+	IOLockUnlock(&lock);
+
+	return ret;
