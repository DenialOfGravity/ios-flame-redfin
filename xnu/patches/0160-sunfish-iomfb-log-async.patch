+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+#undef  super
+#define super IOInterruptController
+
+IODefineMetaClassAndStructors(GenericInterruptController,
+    IOInterruptController);
