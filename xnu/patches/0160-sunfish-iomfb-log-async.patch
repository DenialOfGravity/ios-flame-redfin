+//*********************************************************************************
+
+IOReturn
+IOService::changePowerStateWithTagToPriv( unsigned long ordinal, IOPMRequestTag tag )
+{
+	OUR_PMLog(kPMLogChangeStateToPriv, ordinal, tag);
+	return requestPowerState(gIOPMPowerClientDevice, ordinal, tag);
+}
