+
+	if (obj->serialize( s )) {
+		len = s->getLength();
+		*propertiesCnt = len;
+		err = copyoutkdata( s->text(), len, properties );
+	} else {
+		err = kIOReturnUnsupported;
+	}
+
+	s->release();
+	obj->release();
+
+	return err;
