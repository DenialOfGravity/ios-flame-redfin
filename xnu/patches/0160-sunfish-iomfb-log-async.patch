+#if !defined(__LP64__)
+IONotifier *
+IOService::installNotification(const OSSymbol * type, OSDictionary * matching,
+    IOServiceNotificationHandler handler,
+    void * target, void * refCon,
+    SInt32 priority, OSIterator ** existing )
+{
