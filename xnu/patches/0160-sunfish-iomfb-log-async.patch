+	virtual void free() APPLE_KEXT_OVERRIDE;
+
+	bool appendBytes(const void * bytes, size_t length);
+	bool setLength(size_t length);
+
+	const void * getBytes() const;
+	size_t getLength() const;
+
+private:
+	void freeMemory();
+
+	void *  _data = nullptr;
+	size_t  _length = 0;
+	size_t  _capacity = 0;
+};
