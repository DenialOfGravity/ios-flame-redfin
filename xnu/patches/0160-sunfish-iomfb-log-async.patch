+		return kIOReturnNotPermitted;
+	}
+#endif
+
+	obj = IOCopyPropertyCompatible(entry, property_name);
+	if (!obj) {
+		return kIOReturnNotFound;
+	}
+
+	OSSerialize * s = OSSerialize::withCapacity(4096);
+	if (!s) {
+		obj->release();
+		return kIOReturnNoMemory;
