+kern_return_t
+IOService::JoinPMTree_Impl(void)
+{
+	if (!reserved->uvars || !reserved->uvars->userServer) {
+		return kIOReturnNotReady;
+	}
+	return reserved->uvars->userServer->serviceJoinPMTree(this);
+}
