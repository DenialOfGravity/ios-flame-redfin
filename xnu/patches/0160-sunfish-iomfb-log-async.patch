+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+
+void
+__hib_assert(const char *file, int line, const char *expression)
+{
+	uart_putstring(file);
+	hib_uart_putc(':');
+	uart_putdec(line);
+	uart_putstring(" Assertion failed: ");
+	uart_putstring(expression);
+	hib_uart_putc('\n');
+#if defined(__i386__) || defined(__x86_64__)
+	outb(0xcf9, 6);
+#endif /* defined(__i386__) || defined(__x86_64__) */
+	while (true) {
+	}
+}
