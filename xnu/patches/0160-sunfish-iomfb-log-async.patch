+	OSMetaClassDeclareReservedUnused(ApplePlatformExpert, 1);
+	OSMetaClassDeclareReservedUnused(ApplePlatformExpert, 2);
+	OSMetaClassDeclareReservedUnused(ApplePlatformExpert, 3);
+};
+
+
+#endif /* ! _IOKIT_APPLEPLATFORM_H */
