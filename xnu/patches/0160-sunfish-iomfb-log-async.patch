+	mach_msg_descriptor_type_t    type: 8;
+#if defined(__LP64__)
+	mach_msg_size_t               size;
+#endif
+#if defined(KERNEL) && !defined(__LP64__)
+	uint32_t          pad_end;
+#endif
+} mach_msg_ool_descriptor_t;
+
+typedef struct{
+	unsigned int                  val[80 / sizeof(int)];
+} mach_msg_max_trailer_t;
