+	uint32_t    foundzlen;
+	size_t      bytes;
+};
+
+lck_mtx_t *  gIOTrackingLock;
+queue_head_t gIOTrackingQ;
+
+enum{
+	kTrackingAddressFlagAllocated    = 0x00000001
+};
+
+#if defined(__LP64__)
+#define IOTrackingAddressFlags(ptr)     (ptr->flags)
+#else
+#define IOTrackingAddressFlags(ptr)     (ptr->tracking.flags)
