 			poll = false;
 			if (st_read(SEC_READ_ONE_EVENT, ev, sizeof(ev))) {
@@ -684,8 +886,37 @@ st_thread(void *arg, wait_result_t result)
 			if (events++ < 32 && !st.log) {
