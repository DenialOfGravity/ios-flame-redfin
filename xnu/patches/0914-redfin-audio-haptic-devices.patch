From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rory Axton <roryaxton@gmail.com>
Date: Sat, 24 Oct 2026 15:03:31 +0200
Subject: [PATCH] 0914 redfin: /dev/redwood-audio and /dev/redwood-haptic for RedwoodAudio.driver

The kernel ends of HackiOS's CoreAudio HAL plug-in (phone/audio). iOS
plays an iPhone X's haptics as waveforms on its "Actuator" audio device
(with /product/haptics closed-loop in the ADT); /dev/redwood-haptic turns
each write's peak into a DRV2624 drive level. The haptic thread now
follows a level (sweet_haptic_drive: on at the newest level until its
time is up, at most 1.5 s without a rest). /dev/redwood-audio takes the
speaker's frames and the volume ioctl and drops the samples until the
ADSP path exists. sweetaudio=0 makes neither node.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GizUhEzkc6MoTcLnCZCfFa
---
  bsd/dev/sweet_audio.c  | 168 +++++++++++++++++++++++++++++++++++++++++
  bsd/dev/sweet_haptic.c | 108 +++++++++++++++++++++-----
  bsd/dev/sweet_ufs.c    |   2 +

diff --git a/bsd/dev/sweet_audio.c b/bsd/dev/sweet_audio.c
new file mode 100644
index 0000000..4471b28
--- /dev/null
+++ b/bsd/dev/sweet_audio.c
@@ -0,0 +1,168 @@
+/*
+ * redfin: the kernel ends of HackiOS's RedwoodAudio.driver (phone/audio, after
+ * github.com/oosexgang/hackios-xnu-userland userland/src/audio_plugin.c, MIT), the CoreAudio HAL
+ * plug-in that gives iOS the iPhone X's built-in audio devices:
+ *
+ *   /dev/redwood-audio   the "Speaker" output: whole frames of 48 kHz 16-bit stereo, written by the
+ *                        audio server's real-time thread, never waited on. No sink yet (the speaker
+ *                        path is behind the ADSP): counted and dropped. ioctl _IOW('r', 1,
+ *                        {below, muted}) is the volume iOS sets, kept for the sink.
+ *   /dev/redwood-haptic  the "Actuator" output: 48 kHz 16-bit mono, the waveforms iOS plays on an
+ *                        iPhone X's Taptic Engine (UIKit feedback, CoreHaptics, system vibrations).
+ *                        Each write's peak becomes a drive level for the DRV2624 (sweet_haptic_drive):
+ *                        on while the waveform is above HAP_FLOOR, at a level that follows its peak
+ *                        (full from a third of full scale, never under HAP_LEVEL_MIN).
+ *
+ * iOS plays haptics on the actuator only when the device tree's /product/haptics says closed-loop
+ * (tools/mkadt.py copies it from the D22 tree). Boot-arg sweetaudio=0 makes neither node.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+
+void sweet_audio_init(void);
+extern int sweet_haptic_drive(unsigned ms, unsigned strength);
+
+struct sweet_audio_volume {
+	uint32_t below;                 /* eighths of a dB under the loudest */
+	uint32_t muted;
+};
+#define SWEET_AUDIO_SET_VOLUME  _IOW('r', 1, struct sweet_audio_volume)
+#define AUDIO_RATE              48000u
+#define MINOR_AUDIO             0
+#define MINOR_HAPTIC            1
+#define HAP_FLOOR               1000    /* peak under this: silence (3 % of full scale) */
+#define HAP_FULL                10923   /* a third of full scale: full level */
+#define HAP_LEVEL_MIN           48
+#define HAP_MIN_MS              14      /* the shortest drive: one tap */
+
+static struct {
+	uint64_t audio_frames, haptic_frames;
+	uint32_t audio_writes, haptic_writes, haptic_drives;
+	struct sweet_audio_volume volume;
+	uint32_t volume_set;
+} sa;
+
+static int
+sa_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return 0;
+}
+
+static int
+sa_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return 0;
+}
+
+static int
+sa_read(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return ENODEV;
+}
+
+static void
+sa_haptic(const int16_t *s, unsigned n)
+{
+	int peak = 0;
+	for (unsigned i = 0; i < n; i++) {
+		int v = s[i] < 0 ? -(int)s[i] : s[i];
+		peak = v > peak ? v : peak;
+	}
+	sa.haptic_frames += n;
+	if (peak < HAP_FLOOR) {
+		return;
+	}
+	unsigned level = (unsigned)(127u * (unsigned)peak / HAP_FULL);
+	level = level < HAP_LEVEL_MIN ? HAP_LEVEL_MIN : level > 127 ? 127 : level;
+	unsigned ms = n * 1000u / AUDIO_RATE + 4;
+	ms = ms < HAP_MIN_MS ? HAP_MIN_MS : ms;
+	if (sa.haptic_drives++ < 16) {
+		printf("SWEET AUDIO: actuator %u frames, peak %d -> level %u for %u ms\n", n, peak, level, ms);
+	}
+	(void)sweet_haptic_drive(ms, level);
+}
+
+static int
+sa_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t buf[1024];
+	bool haptic = minor(dev) == MINOR_HAPTIC;
+	while (uio_resid(uio) > 0) {
+		int n = (int)MIN(uio_resid(uio), (user_ssize_t)sizeof(buf));
+		int e = uiomove((caddr_t)buf, n, uio);
+		if (e) {
+			return e;
+		}
+		if (haptic) {
+			sa_haptic(buf, (unsigned)n / 2);
+		} else {
+			sa.audio_frames += (unsigned)n / 4;
+		}
+	}
+	uint32_t w = haptic ? ++sa.haptic_writes : ++sa.audio_writes;
+	if (w == 1 || (w & 0xfff) == 0) {
+		printf("SWEET AUDIO: %s: %u writes, %llu frames (%llu s)%s\n", haptic ? "actuator" : "speaker", w,
+		    haptic ? sa.haptic_frames : sa.audio_frames, (haptic ? sa.haptic_frames : sa.audio_frames) / AUDIO_RATE,
+		    haptic ? "" : ": no speaker yet, dropped");
+	}
+	return 0;
+}
+
+static int
+sa_ioctl(dev_t dev, u_long cmd, caddr_t data, __unused int fflag, __unused proc_t p)
+{
+	if (minor(dev) != MINOR_AUDIO || cmd != SWEET_AUDIO_SET_VOLUME) {
+		return ENOTTY;
+	}
+	sa.volume = *(struct sweet_audio_volume *)data;
+	if (sa.volume_set++ < 8) {
+		printf("SWEET AUDIO: speaker volume %u.%u dB under the loudest%s\n", sa.volume.below / 8,
+		    sa.volume.below % 8 * 125 / 100, sa.volume.muted ? ", muted" : "");
+	}
+	return 0;
+}
+
+static const struct cdevsw sa_cdevsw = {
+	.d_open       = sa_open,
+	.d_close      = sa_close,
+	.d_read       = sa_read,
+	.d_write      = sa_write,
+	.d_ioctl      = sa_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void
+sweet_audio_init(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetaudio", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	int major = cdevsw_add(-1, &sa_cdevsw);
+	if (major < 0) {
+		printf("SWEET AUDIO: cdevsw_add failed (%d)\n", major);
+		return;
+	}
+	void *a = devfs_make_node(makedev(major, MINOR_AUDIO), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-audio");
+	void *h = devfs_make_node(makedev(major, MINOR_HAPTIC), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-haptic");
+	printf("SWEET AUDIO: /dev/redwood-audio %s, /dev/redwood-haptic %s (major %d)\n", a ? "ready" : "failed",
+	    h ? "ready" : "failed", major);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_haptic.c b/bsd/dev/sweet_haptic.c
index 5ebe2a5..e71367e 100644
--- a/bsd/dev/sweet_haptic.c
+++ b/bsd/dev/sweet_haptic.c
@@ -18,6 +18,12 @@
  * caller never waits on I2C. SweetHaptics.dylib (phone/haptics) maps UIKit's feedback
  * generators and AudioServicesPlaySystemSound(kSystemSoundID_Vibrate) onto it.
  *
+ * 0914: the worker follows a level instead of playing fixed pulses: sweet_haptic_drive(strength,
+ * ms) keeps the motor on at that RTP level for at least ms more (a newer level replaces it at
+ * once), then stops it. /dev/redwood-haptic (bsd/dev/sweet_audio.c) drives it from the waveform
+ * iOS plays on its "Actuator" audio device, as on an iPhone X. At most HAP_MAX_ON_MS on without a
+ * break, then it rests as long.
+ *
  * Writes outside the SE and the motor: GCC branch votes and the SE9 RCG (XO), the two TLMM
  * pin configs, and three PM7250B GPIO1 registers (output high = motor enabled).
  */
@@ -40,6 +46,7 @@ extern void thread_deallocate(thread_t);
 void sweet_haptic_init(void);
 int sweet_haptic_buzz(unsigned ms, unsigned strength);
 int sweet_haptic_request(unsigned ms, unsigned strength);
+int sweet_haptic_drive(unsigned ms, unsigned strength);
 
 #define HAP_SE_PA       0x0098c000u
 #define HAP_GCC_PA      0x00100000u
@@ -119,8 +126,9 @@ static LCK_GRP_DECLARE(sweet_haptic_grp, "sweet_haptic");
 static LCK_MTX_DECLARE(sweet_haptic_lock, &sweet_haptic_grp);
 static int hap_sleep_chan;
 static int hap_req_chan;
-static volatile uint32_t hap_req;       /* pending pulse: ms | strength << 16; 0 = none */
+static volatile uint32_t hap_req;       /* pending: ms | strength << 16; 0 = none */
 static volatile uint32_t hap_reqs;
+#define HAP_MAX_ON_MS   1500u
 
 static uint32_t
 hap_rd(vm_offset_t base, uint32_t off)
@@ -541,19 +549,69 @@ hap_thread(void *arg __unused, wait_result_t wr __unused)
 			(void)sweet_haptic_buzz(80, 127);
 		}
 	}
-	/* 0912: the request worker (kern.sweet_haptic). */
-	while (hp.ready && !hp.dead) {
-		uint64_t deadline;
-		clock_interval_to_deadline(60000, NSEC_PER_MSEC, &deadline);
-		(void)assert_wait_deadline(&hap_req_chan, THREAD_UNINT, deadline);
-		if (hap_req != 0) {
-			clear_wait(current_thread(), THREAD_AWAKENED);
-		} else {
-			thread_block(THREAD_CONTINUE_NULL);
-		}
-		uint32_t req = __atomic_exchange_n(&hap_req, 0, __ATOMIC_ACQ_REL);
-		if (req) {
-			(void)sweet_haptic_buzz(req & 0xffffu, (req >> 16) & 0xffu);
+	/* 0912/0914: the worker: the motor on at the newest level until its time is up. */
+	{
+		bool on = false;
+		uint8_t level = 0;
+		uint64_t until = 0, on_since = 0, rest_until = 0;
+		unsigned drives = 0;
+		while (hp.ready && !hp.dead) {
+			uint64_t now = mach_absolute_time(), deadline;
+			if (on) {
+				deadline = until;
+			} else {
+				clock_interval_to_deadline(60000, NSEC_PER_MSEC, &deadline);
+			}
+			(void)assert_wait_deadline(&hap_req_chan, THREAD_UNINT, deadline);
+			if (hap_req != 0 || (on && now >= until)) {
+				clear_wait(current_thread(), THREAD_AWAKENED);
+			} else {
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+			now = mach_absolute_time();
+			uint32_t req = __atomic_exchange_n(&hap_req, 0, __ATOMIC_ACQ_REL);
+			if (req && now >= rest_until) {
+				unsigned ms = req & 0xffffu, strength = (req >> 16) & 0xffu;
+				uint64_t t;
+				clock_interval_to_deadline(ms, NSEC_PER_MSEC, &t);
+				int err = 0;
+				lck_mtx_lock(&sweet_haptic_lock);
+				if (!on) {
+					err |= drv_bits(DRV_MODE, 0x03, 0x00);
+					err |= drv_write(DRV_RTP, (uint8_t)strength);
+					err |= drv_bits(DRV_GO, 0x01, 0x01);
+					on = true;
+					on_since = now;
+					until = t;
+				} else {
+					if (strength != level) {
+						err |= drv_write(DRV_RTP, (uint8_t)strength);
+					}
+					until = t > until ? t : until;
+				}
+				lck_mtx_unlock(&sweet_haptic_lock);
+				level = (uint8_t)strength;
+				if (drives++ < 12 || err) {
+					printf("SWEET HAPTIC: drive %u ms level %u%s -> %d\n", ms, strength,
+					    on && now != on_since ? " (held)" : "", err);
+				}
+				if (err) {
+					hp.dead = true;
+				}
+			}
+			uint64_t max_on;
+			nanoseconds_to_absolutetime((uint64_t)HAP_MAX_ON_MS * NSEC_PER_MSEC, &max_on);
+			if (on && (now >= until || hp.dead || now - on_since >= max_on)) {
+				lck_mtx_lock(&sweet_haptic_lock);
+				(void)drv_bits(DRV_GO, 0x01, 0x00);
+				lck_mtx_unlock(&sweet_haptic_lock);
+				if (now - on_since >= max_on) {
+					rest_until = now + max_on;
+					printf("SWEET HAPTIC: on for %u ms: resting as long\n", HAP_MAX_ON_MS);
+				}
+				on = false;
+				level = 0;
+			}
 		}
 	}
 out:
@@ -561,7 +619,22 @@ out:
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
-/* Queue a pulse for the driver's thread (any context that may take a wakeup); newest wins. */
+/* The motor on at strength (1..127) for at least ms more, from the driver's thread; newest wins. */
+int
+sweet_haptic_drive(unsigned ms, unsigned strength)
+{
+	if (!hp.ready || hp.dead) {
+		return ENXIO;
+	}
+	ms = ms == 0 ? 1 : ms > 2000 ? 2000 : ms;
+	strength = strength == 0 ? 1 : strength > 127 ? 127 : strength;
+	__atomic_store_n(&hap_req, ms | (strength << 16), __ATOMIC_RELEASE);
+	hap_reqs++;
+	thread_wakeup(&hap_req_chan);
+	return 0;
+}
+
+/* A pulse (kern.sweet_haptic): 0 = defaults (60 ms, full strength). */
 int
 sweet_haptic_request(unsigned ms, unsigned strength)
 {
@@ -574,10 +647,7 @@ sweet_haptic_request(unsigned ms, unsigned strength)
 	if (strength == 0 || strength > 127) {
 		strength = 127;
 	}
-	__atomic_store_n(&hap_req, ms | (strength << 16), __ATOMIC_RELEASE);
-	hap_reqs++;
-	thread_wakeup(&hap_req_chan);
-	return 0;
+	return sweet_haptic_drive(ms, strength);
 }
 
 static int
