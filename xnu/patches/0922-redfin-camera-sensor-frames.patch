-	uint32_t io[2] = { rd(cm.tlmm, GPIO_IO(s->sda)), rd(cm.tlmm, GPIO_IO(s->scl)) };
 	bool ok = false;
-	line(s->sda, true);
-	line(s->scl, true);
-	half_bit();
+	bus_take();
 	if (!level(s->sda) || !level(s->scl)) {
 		*why = "bus not at rest";
 	} else {
@@ -688,10 +741,26 @@
 		}
 		i2c_stop(s->sda, s->scl);
 	}
-	wr(cm.tlmm, GPIO_IO(s->sda), io[0] & 2u);
-	wr(cm.tlmm, GPIO_IO(s->scl), io[1] & 2u);
-	wr(cm.tlmm, GPIO_CFG(s->sda), cfg[0]);
-	wr(cm.tlmm, GPIO_CFG(s->scl), cfg[1]);
+	bus_give();
+	return ok;
+}
+
+/* 0922: one register write (n bytes: the address's and the data's), every byte acknowledged */
+static bool
+sensor_write(uint8_t slave, const uint8_t *b, unsigned n)
+{
+	const struct sensor *s = cm.s;
+	bool ok = false;
+	bus_take();
+	if (level(s->sda) && level(s->scl)) {
+		i2c_start(s->sda, s->scl);
+		ok = i2c_byte(s->sda, s->scl, (uint8_t)(slave << 1));
+		for (unsigned i = 0; ok && i < n; i++) {
+			ok = i2c_byte(s->sda, s->scl, b[i]);
+		}
+		i2c_stop(s->sda, s->scl);
+	}
+	bus_give();
 	return ok;
 }
 
