 	uint64_t last_look = 0;
-	char t[16];
+	uint32_t generation = 0, ios_below = 0, changes = 0;
+	bool ios_muted = false;
+	char t[16], t2[16], t3[16];
 
 	watcher_runs = true;
 	while (!stopping) {
-		uint64_t now = now_us(), until = tone_until_us;
-		bool wanted = now < until + QUIET_BEFORE_OFF_US && until != 0;
-
