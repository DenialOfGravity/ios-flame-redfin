 		SAY("the LPASS votes were not granted\n");
 	}
@@ -1099,13 +1185,14 @@ sound_thread(__unused void *parameter, __unused wait_result_t result)
 	thread_deallocate(feeder);
 	path_up = true;
 	if (level >= 3) {
-		char t[16];
