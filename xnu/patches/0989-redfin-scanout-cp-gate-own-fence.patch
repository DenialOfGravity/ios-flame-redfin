From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rory Axton <roryaxton@gmail.com>
Date: Tue, 27 Oct 2026 11:00:00 +0100
Subject: [PATCH] 0989 redfin: direct scanout gate in the CP (p scanout gate 2), own-fence
 flips, display off leaves direct mode

p scanout gate 2 (boot-arg sweetscangate=2): the swapper's GPU submits after
SwapEnd K return at once with a CP_WAIT_REG_MEM (WRITE_GE, memory) on a
latched-frame word in the scratch page; the scanout thread writes the
frame on screen at each latch. The word only goes up; every armed wait is
released (word = newest reference) on a gate change, scanout off, leaving
the direct geometry, or 50 ms without a latch, so the ring cannot stall.
Gate 1 (CPU wait, default) cap 30 -> 50 ms. The flip now waits for the
swapper's own last fence (per-pid), not the latest fence of any client.
Display off (power key) leaves the direct geometry so the fade shows.
r39's 'gate 0 deadlock' was a power-key press at 491.4 s (display off), 20 s
before gate 0.
---
diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
index f7242d2..f769fc1 100644
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -1216,13 +1216,32 @@ uint32_t a6_fence_read(const struct a6_gpu *g)
 
 uint32_t a6_submit_ibs_async(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords, unsigned nib,
 			     unsigned timeout_ms)
+{
+	return a6_submit_ibs_async_wait(g, iova, dwords, nib, timeout_ms, 0, 0);
+}
+
+/*
+ * 0989: the same, with the CP first waiting until the word at GPU address wait_va is >= wait_ref (CP_WAIT_REG_MEM,
+ * memory poll, WRITE_GE; wait_va 0: no wait). Whoever arms it must make sure the word gets there (sweet_gpu_scan_word).
+ */
+uint32_t a6_submit_ibs_async_wait(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords, unsigned nib,
+				  unsigned timeout_ms, uint64_t wait_va, uint32_t wait_ref)
 {
 	uint64_t fva = a6_pool_va(A6_OFF_SCRATCH);
 	/* GPU time of this submit: CP_ALWAYS_ON_COUNTER before the IBs and once they are idle (a6_submit_time) */
 	uint64_t ts = a6_pool_va(A6_OFF_SCRATCH + A6_TS_OFF) + 16ull * ((g->fence + 1) % A6_TS_SLOTS);
-	uint32_t dw[4 + 4 + 4 * A6_SUBMIT_MAX + 5 + 5 + 2], n = 0;	/* 0988: + the longer end stamp */
+	uint32_t dw[7 + 4 + 4 + 4 * A6_SUBMIT_MAX + 5 + 5 + 2], n = 0;	/* 0988: + the longer end stamp; 0989: + the wait */
 	if (nib == 0 || nib > A6_SUBMIT_MAX)
 		return 0;
+	if (wait_va != 0) {
+		dw[n++] = a6_pkt7(0x3c, 6);		/* CP_WAIT_REG_MEM */
+		dw[n++] = 5u | 1u << 4;			/* FUNCTION WRITE_GE, POLL memory */
+		dw[n++] = (uint32_t)wait_va;
+		dw[n++] = (uint32_t)(wait_va >> 32);
+		dw[n++] = wait_ref;
+		dw[n++] = 0xffffffffu;			/* MASK */
+		dw[n++] = 16;				/* DELAY_LOOP_CYCLES */
+	}
 	dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1);
 	dw[n++] = 0x18;				/* PC_CCU_INVALIDATE_DEPTH */
 	dw[n++] = a6_pkt7(A6_CP_EVENT_WRITE, 1);
diff --git a/bsd/dev/sweet_a6xx.h b/bsd/dev/sweet_a6xx.h
index d2be646..710ee3a 100644
--- a/bsd/dev/sweet_a6xx.h
+++ b/bsd/dev/sweet_a6xx.h
@@ -125,6 +125,9 @@ uint32_t a6_submit_ib_async(struct a6_gpu *g, uint64_t iova, uint32_t dwords, un
  * returns the fence, or 0 when the ring has no room within timeout_ms (0 = look once).
  */
 #define A6_SUBMIT_MAX	16
+uint32_t a6_submit_ibs_async_wait(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords, unsigned n,
+	unsigned timeout_ms, uint64_t wait_va, uint32_t wait_ref);	/* 0989 */
+#define A6_SCAN_WORD_OFF	0x3000ull	/* 0989: in the scratch page: the direct scanout's latched frame */
 uint32_t a6_submit_ibs_async(struct a6_gpu *g, const uint64_t *iova, const uint32_t *dwords, unsigned n,
 			     unsigned timeout_ms);
 /* Has the fence (from a6_submit_ib_async) landed? (wraparound-safe) */
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 2920e62..f754b2d 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1522,7 +1522,35 @@ sweet_gpu_unmap_at(uint64_t iova, uint64_t len)
 	lck_mtx_unlock(&sweet_gpu_lock);
 }
 
-void sweet_scan_submit_gate(void);     /* 0985: SweetFramebuffer.cpp */
+uint32_t sweet_scan_submit_gate(void);         /* 0985: SweetFramebuffer.cpp; 0989: a GPU-side wait's reference */
+
+/*
+ * 0989: the direct scanout's "latched frame" word (scratch + A6_SCAN_WORD_OFF), which gated submits make the CP wait
+ * for (p scanout gate 2); and each process's last fence (the swapper's frame is done at its own last submit, not at
+ * the latest of anyone's: r39's fence waits included other clients' work queued after it).
+ */
+void sweet_gpu_scan_word(uint32_t v);
+void
+sweet_gpu_scan_word(uint32_t v)
+{
+	if (gpu_ready) {
+		a6_write(a6_pool_pa(&gpu, A6_OFF_SCRATCH + A6_SCAN_WORD_OFF), &v, 4);
+	}
+}
+
+static struct { int pid; uint32_t fence; } pid_fence[8];
+uint32_t sweet_gpu_fence_of(int pid);
+uint32_t
+sweet_gpu_fence_of(int pid)
+{
+	for (unsigned i = 0; i < 8; i++) {
+		if (pid_fence[i].pid == pid) {
+			return pid_fence[i].fence;
+		}
+	}
+	return 0;
+}
+
 /* Queue up to A6_SUBMIT_MAX IBs: the fence, 0 when the GPU is not usable, or 0 with *busy when the ring is full. */
 uint32_t
 sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bool *busy)
@@ -1536,11 +1564,28 @@ sweet_gpu_submit_v2(const uint64_t *iova, const uint32_t *dwords, unsigned n, bo
 	static uint32_t ring_wait_ms;
 	if (!ring_wait_ms && !PE_parse_boot_argn("sweetringwait", &ring_wait_ms, sizeof(ring_wait_ms)))
 		ring_wait_ms = 2000;
-	sweet_scan_submit_gate();       /* 0985: CA's next frame waits for its last one on screen (direct scanout) */
+	/* 0985: CA's next frame waits for its last one on screen (direct scanout): here (gate 1) or in the CP (0989, gate 2) */
+	uint32_t wait_ref = sweet_scan_submit_gate();
+	int pid = proc_selfpid();
 	lck_mtx_lock(&sweet_gpu_lock);
 	gpu_note_submit_locked();
-	uint32_t fence = a6_submit_ibs_async(&gpu, iova, dwords, n, ring_wait_ms);
-	gpu_owner_locked(fence, proc_selfpid());
+	uint32_t fence = a6_submit_ibs_async_wait(&gpu, iova, dwords, n, ring_wait_ms,
+	    wait_ref ? a6_pool_va(A6_OFF_SCRATCH + A6_SCAN_WORD_OFF) : 0, wait_ref);
+	gpu_owner_locked(fence, pid);
+	if (fence != 0) {
+		unsigned slot = 0;      /* 0989: this pid's entry, else the oldest */
+		for (unsigned i = 0; i < 8; i++) {
+			if (pid_fence[i].pid == pid) {
+				slot = i;
+				break;
+			}
+			if ((int32_t)(pid_fence[i].fence - pid_fence[slot].fence) < 0) {
+				slot = i;
+			}
+		}
+		pid_fence[slot].pid = pid;
+		pid_fence[slot].fence = fence;
+	}
 	lck_mtx_unlock(&sweet_gpu_lock);
 	*busy = fence == 0 && n > 0 && n <= A6_SUBMIT_MAX;
 	return fence;
