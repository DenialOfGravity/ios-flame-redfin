+/*
+ * 0932: another mode of the sensor that streams, without powering it down: the frames stopped at a frame's end ("off",
+ * then a frame's time), the receive path down; the new mode's table, the exposure clamped to it, the places for its
+ * size, the receive path and "on" again. Power, PLL2, refgen, the SMMU, the sensor's init and the lens stay (r18g: a
+ * full stop and start is ~0.35 s). false: it did not work, the old mode is set again and the session ends.
+ */
+static bool
+ios_warm_switch(uint32_t mode_n)
+{
+	unsigned old_n = ios_mode_n, phy = sensor_capture[ios_sensor].phy;
+	uint32_t frame_ms = (uint32_t)((uint64_t)ios_line_ns * ios_now.frame_lines / 1000000u) + 5;
+	uint64_t t0 = ios_ms();
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = false;
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;    /* (a read copying out of one now gives it back as it finds it: free) */
+		place[i].sequence = 0;
+	}
+	lck_mtx_unlock(&ios_lock);
+	wakeup(&ios_frames_done);
+	(void)sensor_table("off");
+	sleep_ms(frame_ms > 200 ? 200 : frame_ms);
+	paths_down();
+	csiphy_down();
+	ios_mode_set(ios_sensor, mode_n);
+	const struct tab_mode *m = ios_mode;
+	uint32_t lines = ios_now.lines, gain = ios_now.gain, frame_lines = 0;
+	exposure_limits(&lines, &gain, &frame_lines);
+	char res[8];
+	snprintf(res, sizeof(res), "res%u", mode_n);
+	bool ok = ring_alloc(ios_stride * m->height) && sensor_table(res) &&
+	    sensor_exposure(lines, gain_code(gain), frame_lines, dgain_limit(ios_dgain)) && csid_reset() &&
+	    csid_config((int)phy, m->lanes, sc.lane_assign & ((1u << (4 * m->lanes)) - 1), 0, m->width, m->height) &&
+	    ife_config((uint32_t)ring_pa, 0) && csiphy_up(phy, m->lanes, sc.lane_assign, m->settle);
+	if (ok) {
+		wr(cap.ife, IFE_IRQ_CLEAR0, 0xffffffffu);
+		wr(cap.ife, IFE_IRQ_GLOBAL_CLEAR, 1);
+		wr(cap.ife, BUS_IRQ_CLEAR1, 0xffffffffu);
+		wr(cap.ife, BUS_IRQ_GLOBAL_CLEAR, 1);
+		ok = sensor_table("on");
+	}
+	if (!ok) {
+		printf("SWEET CAM: /dev/redwood-camera: mode %u did not start: mode %u again from the next session\n", mode_n, old_n);
+		ios_mode_set(ios_sensor, old_n);
+		return false;
+	}
+	ios_now.lines = ios_next.lines = lines;
+	ios_now.gain = ios_next.gain = gain;
+	ios_now.frame_lines = ios_next.frame_lines = frame_lines;
+	ios_next.from = 0;
+	lck_mtx_lock(&ios_lock);
+	place[0].state = PLACE_WRITING;
+	ios_streaming = true;
+	ios_last_read = ios_ms();
+	lck_mtx_unlock(&ios_lock);
+	printf("SWEET CAM: /dev/redwood-camera: mode %u -> %u without a power cycle in %llu ms\n", old_n, mode_n,
+	    (unsigned long long)(ios_ms() - t0));
+	return true;
+}
