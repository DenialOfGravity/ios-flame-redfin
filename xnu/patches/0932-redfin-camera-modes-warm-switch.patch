-ios_select(unsigned si, uint32_t mode_n)
+mode_usable(unsigned si, const struct tab_mode *m)
+{
+	return sc.slave == sensors[si].slave && m->lanes >= 1 && m->lanes <= 4 && !m->cphy && m->dt == RAW10_DT && m->width % 4 == 0 &&
+	       m->fps_milli != 0 && m->frame_length != 0;
+}
+
+static uint32_t
+mode_pick(unsigned si, unsigned cls)
+{
+	uint32_t best = ~0u;
+	if (cls == CLASS_VIDEO || cls == CLASS_VIDEO60) {
+		uint32_t least_fps = cls == CLASS_VIDEO60 ? 59000 : 29500;
+		for (uint32_t k = 0; k < sc.modes; k++) {
+			const struct tab_mode *o = &sc.mode[k];
+			uint64_t pixels = (uint64_t)o->width * o->height, a = (uint64_t)o->width * 9, b = (uint64_t)o->height * 16;
+			if (!mode_usable(si, o) || (a > b ? a - b : b - a) * 50 > b || o->width > 4096 || pixels < 1600 * 900 ||
+			    o->fps_milli < least_fps) {
+				continue;
+			}
+			if (best == ~0u) {
+				best = k;
+				continue;
+			}
+			const struct tab_mode *x = &sc.mode[best];
+			uint32_t fo = (o->fps_milli + 500) / 1000, fx = (x->fps_milli + 500) / 1000;
+			if (fo < fx || (fo == fx && pixels < (uint64_t)x->width * x->height)) {
+				best = k;
+			}
+		}
+		if (best == ~0u) {
+			return mode_pick(si, cls == CLASS_VIDEO60 ? CLASS_VIDEO : CLASS_AUTO);
+		}
+		return best;
+	}
+	uint64_t most = 0;
+	for (uint32_t k = 0; k < sc.modes; k++) {
+		const struct tab_mode *o = &sc.mode[k];
+		uint64_t pixels = (uint64_t)o->width * o->height;
+		if (mode_usable(si, o) && o->width * 3 == o->height * 4 && o->fps_milli <= 31000 && pixels <= 13000000 && pixels > most) {
+			most = pixels;
+			best = k;
+		}
+	}
+	return best == ~0u ? 0 : best;
+}
